---
import { ArrowUpRight, Copy } from '@lucide/astro';
import ChatGPT from '../icons/chatgpt.svg';
import Claude from '../icons/claude.svg';
import Perplexity from '../icons/perplexity.svg';
import Gemini from '../icons/gemini.svg';

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const prompt = `Lê esta página: ${pageUrl.href}. Quero fazer perguntas sobre ela. Responde em português de Portugal. Se não conseguires ler a página, diz-me.`;
const providers = [
  {
    id: 'chatgpt',
    name: 'ChatGPT',
    icon: ChatGPT,
    href: `https://chatgpt.com/?${new URLSearchParams({ prompt, hints: 'search' })}`,
  },
  {
    id: 'claude',
    name: 'Claude',
    icon: Claude,
    href: `https://claude.ai/new?${new URLSearchParams({ q: prompt })}`,
  },
  {
    id: 'perplexity',
    name: 'Perplexity',
    icon: Perplexity,
    href: `https://www.perplexity.ai/search/new?${new URLSearchParams({ q: prompt })}`,
  },
  {
    id: 'gemini',
    name: 'Gemini',
    icon: Gemini,
    href: 'https://gemini.google.com/app',
  },
];
---

<div id="ai-menu" class="ai-menu" popover data-pagefind-ignore>
  <h2>Perguntar sobre esta página</h2>
  {providers.map(({ id, name, icon: Icon, href }) => (
    <a data-provider={id} href={href} target="_blank" rel="noreferrer">
      <Icon class="provider-icon" aria-hidden="true" />
      {name}
      {id === 'gemini' && <small>Copiar e abrir</small>}
      <ArrowUpRight size={18} />
    </a>
  ))}
  <button id="copy-prompt">
    <Copy size={16} /> Copiar pergunta
  </button>
  <p id="ai-status" role="status">
    Envia o link e pede à IA para ler a página. No Gemini, cola a pergunta
    copiada.
  </p>
  <details>
    <summary>Ver pergunta para copiar</summary>
    <textarea
      id="ai-prompt"
      readonly
      aria-label="Pergunta para a IA"
    >{prompt}</textarea>
  </details>
</div>
<script src="../scripts/ai.ts"></script>
