---
import { ArrowUpRight, Copy } from '@lucide/astro';
---

<div id="ai-menu" class="ai-menu" popover data-pagefind-ignore>
  <h2>Perguntar sobre esta página</h2>
  <a
    data-provider="chatgpt"
    href="https://chatgpt.com/"
    target="_blank"
    rel="noreferrer"
  >
    ChatGPT <ArrowUpRight size={18} />
  </a>
  <a
    data-provider="claude"
    href="https://claude.ai/new"
    target="_blank"
    rel="noreferrer"
  >
    Claude <ArrowUpRight size={18} />
  </a>
  <a
    data-provider="perplexity"
    href="https://www.perplexity.ai/"
    target="_blank"
    rel="noreferrer"
  >
    Perplexity <ArrowUpRight size={18} />
  </a>
  <a
    data-provider="gemini"
    href="https://gemini.google.com/app"
    target="_blank"
    rel="noreferrer"
  >
    Gemini <small>Copiar e abrir</small>
    <ArrowUpRight size={18} />
  </a>
  <button id="copy-prompt">
    <Copy size={16} /> Copiar pergunta
  </button>
  <p id="ai-status" role="status">
    Abre uma conversa com o endereço desta página. As tuas notas ficam aqui.
  </p>
  <details>
    <summary>Ver pergunta para copiar</summary>
    <textarea
      id="ai-prompt"
      readonly
      aria-label="Pergunta para a IA"
    ></textarea>
  </details>
</div>
<script src="../scripts/ai.ts"></script>
