---
import { readingThemes } from '../data/reading-themes';
import { readingFonts } from '../data/reading-fonts';
import { codeFonts } from '../data/code-fonts';
import CssSnippets from './CssSnippets.astro';
import Icon from './Icon.astro';
---

<dialog
  id="appearance"
  class="appearance-dialog"
  aria-labelledby="appearance-title"
>
  <header class="dialog-header appearance-header">
    <h2 id="appearance-title">À tua maneira</h2>
    <button class="icon-button" data-close aria-label="Fechar personalização">
      <Icon name="x-mark" size={22} />
    </button>
  </header>
  <div class="appearance-body">
    <form id="preferences">
      <section class="preference-section" aria-labelledby="appearance-colors">
        <h3 id="appearance-colors">Aparência</h3>
        <fieldset>
          <legend class="sr-only">Modo de cor</legend>
          <div class="segments">
            <label>
              <input type="radio" name="theme" value="light" />
              <Icon name="sun" size={18} />
              <span>Claro</span>
            </label>
            <label>
              <input type="radio" name="theme" value="system" checked />
              <Icon name="computer-desktop" size={18} />
              <span>Sistema</span>
            </label>
            <label>
              <input type="radio" name="theme" value="dark" />
              <Icon name="moon" size={18} />
              <span>Escuro</span>
            </label>
          </div>
        </fieldset>
        <fieldset id="reading-theme">
          <legend>Tema</legend>
          <div class="preference-choices theme-choices">
            {readingThemes.map((theme) => (
              <label
                class="preference-choice"
                style={`--sample-page: ${theme.light.page || '#faf9f7'}; --sample-ink: ${theme.light.text || '#292a30'}; --sample-accent: ${theme.light.accent || '#8c2d3b'}; --sample-dark-page: ${theme.dark.page || '#1b1b1e'}; --sample-dark-ink: ${theme.dark.text || '#eeedf0'}; --sample-dark-accent: ${theme.dark.accent || '#eda1ae'};`}
              >
                <input
                  type="radio"
                  name="palette"
                  value={theme.id}
                  checked={theme.id === 'feup'}
                />
                <span class="theme-sample" aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <span>{theme.name}</span>
                <Icon name="check" size={14} />
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="feup-accent">
          <legend>Cor de destaque</legend>
          <div class="accent-options">
            <label>
              <input type="radio" name="accent" value="red" checked />
              <span class="swatch red"></span>FEUP
            </label>
            <label>
              <input type="radio" name="accent" value="blue" />
              <span class="swatch blue"></span>Azul
            </label>
            <label>
              <input type="radio" name="accent" value="green" />
              <span class="swatch green"></span>Verde
            </label>
          </div>
        </fieldset>
      </section>
      <section class="preference-section" aria-labelledby="appearance-reading">
        <h3 id="appearance-reading">Leitura</h3>
        <fieldset id="reading-font">
          <legend>Fonte de leitura</legend>
          <div class="preference-choices font-choices">
            {readingFonts.map((font) => (
              <label
                class="preference-choice"
                style={`font-family: ${font.family}`}
              >
                <input
                  type="radio"
                  name="font"
                  value={font.id}
                  checked={font.id === 'sans'}
                />
                <span>{font.name}</span>
                <Icon name="check" size={14} />
              </label>
            ))}
          </div>
        </fieldset>
        <div class="preference-range">
          <label class="range-label" for="text-size">
            Tamanho do texto{' '}
            <output id="size-value" for="text-size">
              100%
            </output>
          </label>
          <input
            id="text-size"
            name="size"
            type="range"
            min="100"
            max="120"
            step="10"
            value="100"
          />
        </div>
        <p class="font-preview">Álgebra, lógica e uma ideia de cada vez.</p>
        <div class="preference-range">
          <label class="range-label" for="reading-width">
            Largura do texto{' '}
            <output id="measure-value" for="reading-width">
              640 px
            </output>
          </label>
          <input
            id="reading-width"
            name="measure"
            type="range"
            min="560"
            max="1000"
            step="40"
            value="640"
          />
        </div>
        <div class="preference-range">
          <label class="range-label" for="page-width">
            Largura da página{' '}
            <output id="width-value" for="page-width">
              1200 px
            </output>
          </label>
          <input
            id="page-width"
            name="width"
            type="range"
            min="1040"
            max="1920"
            step="80"
            value="1200"
          />
        </div>
      </section>
      <section class="preference-section" aria-labelledby="appearance-code">
        <h3 id="appearance-code">Código</h3>
        <fieldset id="code-font">
          <legend>Fonte do código</legend>
          <div class="preference-choices code-font-choices">
            {codeFonts.map((font) => (
              <label
                class="preference-choice"
                style={`font-family: ${font.family}`}
              >
                <input
                  type="radio"
                  name="codeFont"
                  value={font.id}
                  checked={font.id === 'plex'}
                />
                <span>{font.name}</span>
                <Icon name="check" size={14} />
              </label>
            ))}
          </div>
        </fieldset>
      </section>
    </form>
    <CssSnippets />
  </div>
  <footer class="appearance-footer">
    <span>Guardado neste navegador</span>
    <button type="reset" form="preferences" class="reset-button">
      <Icon name="arrow-path" size={16} />
      Repor preferências
    </button>
  </footer>
</dialog>

<style is:global>
  .appearance-dialog {
    width: 440px;
    padding: 0;
    overflow: hidden;
  }
  .appearance-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .appearance-header {
    flex: none;
    padding: 20px 24px;
    border-bottom: 1px solid var(--line);
  }
  .appearance-header h2 {
    font-size: 21px;
  }
  .appearance-header .icon-button {
    margin: 0;
  }
  .appearance-body {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 24px;
    scrollbar-color: var(--line) transparent;
    scrollbar-width: thin;
  }
  #preferences {
    margin-top: 0;
  }
  .preference-section {
    display: grid;
    gap: 20px;
    padding-bottom: 26px;
  }
  .preference-section + .preference-section {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .preference-section h3 {
    margin: 0;
    font-size: 16px;
  }
  .preference-section fieldset {
    margin: 0;
  }
  .preference-section legend {
    margin-bottom: 9px;
    color: var(--muted);
    font-weight: 600;
  }
  .preference-choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .preference-choice {
    position: relative;
    min-width: 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    line-height: 1.4;
  }
  .preference-choice > input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    margin: 0;
    cursor: pointer;
    z-index: 1;
  }
  .preference-choice > span:not(.theme-sample) {
    flex: 1;
    min-width: 0;
  }
  .preference-choice > svg {
    flex: none;
    opacity: 0;
  }
  .preference-choice:hover {
    background: var(--soft);
  }
  .preference-choice:has(:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .preference-choice:has(:checked) > svg {
    opacity: 1;
  }
  .preference-choice:has(:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .theme-sample {
    display: flex;
    width: 27px;
    height: 21px;
    flex: none;
    overflow: hidden;
    border-radius: 4px;
  }
  .theme-sample i {
    flex: 1;
    background: var(--sample-page);
  }
  .theme-sample i:nth-child(2) {
    background: var(--sample-accent);
  }
  .theme-sample i:nth-child(3) {
    background: var(--sample-ink);
  }
  [data-theme='dark'] .theme-sample i {
    background: var(--sample-dark-page);
  }
  [data-theme='dark'] .theme-sample i:nth-child(2) {
    background: var(--sample-dark-accent);
  }
  [data-theme='dark'] .theme-sample i:nth-child(3) {
    background: var(--sample-dark-ink);
  }
  .font-choices .preference-choice {
    font-size: 13px;
  }
  .code-font-choices {
    grid-template-columns: 1fr;
  }
  .preference-range .range-label {
    margin-bottom: 4px;
  }
  .preference-range output {
    font-variant-numeric: tabular-nums;
  }
  .preference-section .font-preview {
    margin: 0;
  }
  .appearance-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex: none;
    border-top: 1px solid var(--line);
    padding: 10px 24px;
    background: var(--surface);
  }
  .appearance-footer > span {
    max-width: 110px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--muted);
  }
  .appearance-footer .reset-button {
    margin: 0;
    min-height: 44px;
  }
  @media (max-width: 500px) {
    .appearance-dialog {
      margin: 0 0 0 auto;
      max-width: 100%;
      width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
      padding: 0;
    }
    .appearance-header {
      padding: max(14px, env(safe-area-inset-top)) 20px 14px;
    }
    .appearance-body {
      padding: 20px;
    }
    .appearance-footer {
      padding: 8px 20px max(8px, env(safe-area-inset-bottom));
    }
    .theme-sample {
      width: 21px;
    }
    .preference-choice {
      padding-inline: 8px;
      gap: 6px;
    }
  }
</style>
