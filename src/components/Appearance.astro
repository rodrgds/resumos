---
import { readingThemes } from '../data/reading-themes';
import { readingFonts } from '../data/reading-fonts';
import { X, Sun, Moon, Monitor, RotateCcw } from '@lucide/astro';
---

<dialog
  id="appearance"
  class="appearance-dialog"
  aria-labelledby="appearance-title"
>
  <div class="dialog-header">
    <h2 id="appearance-title">À tua maneira</h2>
    <button class="icon-button" data-close aria-label="Fechar personalização">
      <X size={22} />
    </button>
  </div>
  <p class="dialog-intro">Escolhe como preferes ler.</p>
  <form id="preferences">
    <fieldset>
      <legend>Aparência</legend>
      <div class="segments">
        <label>
          <input type="radio" name="theme" value="light" />
          <Sun size={18} />
          <span>Claro</span>
        </label>
        <label>
          <input type="radio" name="theme" value="system" checked />
          <Monitor size={18} />
          <span>Sistema</span>
        </label>
        <label>
          <input type="radio" name="theme" value="dark" />
          <Moon size={18} />
          <span>Escuro</span>
        </label>
      </div>
    </fieldset>
    <label class="range-label" for="reading-theme">
      Tema
    </label>
    <select class="font-select" id="reading-theme" name="palette">
      {readingThemes.map((theme) => (
        <option value={theme.id}>{theme.name}</option>
      ))}
    </select>
    <details class="appearance-details">
      <summary>Ajustar cores e largura</summary>
      <fieldset class="feup-accent">
        <legend>Cor de destaque do tema FEUP</legend>
        <div class="accent-options">
          <label>
            <input type="radio" name="accent" value="red" checked />
            <span class="swatch red"></span>FEUP
          </label>
          <label>
            <input type="radio" name="accent" value="blue" />
            <span class="swatch blue"></span>Azul
          </label>
          <label>
            <input type="radio" name="accent" value="green" />
            <span class="swatch green"></span>Verde
          </label>
        </div>
      </fieldset>
      <label class="range-label" for="page-width">
        Largura da página{' '}
        <output id="width-value" for="page-width">
          1360 px
        </output>
      </label>
      <input
        id="page-width"
        type="range"
        name="width"
        min="1040"
        max="1920"
        step="80"
        value="1360"
      />
      <label class="range-label" for="reading-width">
        Largura do texto{' '}
        <output id="measure-value" for="reading-width">
          720 px
        </output>
      </label>
      <input
        id="reading-width"
        type="range"
        name="measure"
        min="560"
        max="1000"
        step="40"
        value="720"
      />
    </details>
    <fieldset>
      <legend>Tipo de letra</legend>
      <label class="sr-only" for="reading-font">
        Fonte de leitura
      </label>
      <select class="font-select" id="reading-font" name="font">
        {[...new Set(readingFonts.map((font) => font.group))].map((group) => (
          <optgroup label={group}>
            {readingFonts
              .filter((font) => font.group === group)
              .map((font) => (
                <option value={font.id}>{font.name}</option>
              ))}
          </optgroup>
        ))}
      </select>
      <p class="font-preview">Álgebra, lógica e uma ideia de cada vez.</p>
    </fieldset>
    <label class="range-label" for="text-size">
      Tamanho do texto{' '}
      <output id="size-value" for="text-size">
        100%
      </output>
    </label>
    <input
      id="text-size"
      name="size"
      type="range"
      min="100"
      max="120"
      step="10"
      value="100"
    />
    <button type="reset" class="reset-button">
      <RotateCcw size={16} />
      Repor preferências
    </button>
  </form>
  <p class="settings-note">As tuas escolhas ficam guardadas neste navegador.</p>
</dialog>
