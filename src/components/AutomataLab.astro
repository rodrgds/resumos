---
import '../styles/formal-lab.css';
import '../styles/automata-lab.css';
import { presets, type PresetId } from '../lib/automata/presets';
interface Props {
  preset?: PresetId;
  examples?: PresetId[];
}
const { preset = 'suffix-ab', examples = Object.keys(presets) as PresetId[] } =
  Astro.props;
const models = [...new Set(examples.map((id) => presets[id].machine.model))];
---

<div
  class="formal-lab automata-lab"
  data-automata-lab
  data-preset={preset}
  role="group"
  aria-label="Laboratório de autómatos"
  data-annotation-ignore
  data-pagefind-ignore
>
  <div data-lab-ui hidden>
    <div class="formal-toolbar">
      <label>
        Máquina
        <select data-preset-select>
          {examples.map((id) => (
            <option value={id} selected={id === preset}>
              {presets[id].title}
            </option>
          ))}
          {models.includes('dfa') && (
            <option value="blank-dfa">Criar DFA</option>
          )}
          {models.includes('moore') && (
            <option value="blank-moore">Criar Moore</option>
          )}
          {models.includes('mealy') && (
            <option value="blank-mealy">Criar Mealy</option>
          )}
        </select>
      </label>
      <button type="button" data-action="restore">
        Repor exemplo
      </button>
      <button type="button" data-action="exercise">
        Resolver exercício
      </button>
    </div>
    <p class="formal-help" data-convention></p>
    <p data-task hidden></p>
    <div
      class="automata-canvas"
      data-diagram
      tabindex="0"
      role="region"
      aria-label="Diagrama da máquina, com deslocação horizontal quando necessário"
    ></div>
    <details class="automata-editor">
      <summary>Editar estados e transições</summary>
      <label class="automata-alphabet">
        Alfabeto, símbolos separados por espaços{' '}
        <input data-alphabet maxlength="31" />
      </label>
      <div data-editor></div>
      <p class="formal-help">
        Até 12 estados, 8 símbolos e 128 símbolos de entrada. Edições e
        resultados ficam neste dispositivo durante esta visita.
      </p>
    </details>
    <p class="formal-help" data-validation></p>
    <div class="formal-toolbar">
      <label>
        Entrada, vazia para ε{' '}
        <input
          data-input
          maxlength="256"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <div class="formal-actions">
        <button type="button" data-action="run" data-primary>
          Executar
        </button>
        <button type="button" data-action="step">
          Passo
        </button>
        <button type="button" data-action="reset">
          Reiniciar
        </button>
        <button type="button" data-action="start-exercise" hidden>
          Construir do zero
        </button>
        <button type="button" data-action="verify" hidden>
          Verificar máquina
        </button>
      </div>
    </div>
    <p class="formal-result" role="status" aria-live="polite" data-result></p>
    <div class="automata-table" data-trace></div>
    <p
      class="formal-result"
      role="status"
      aria-live="polite"
      data-verification
      hidden
    ></p>
    <details data-solution hidden>
      <summary>Ver solução</summary>
      <p>
        Repõe o exemplo para consultar a máquina de referência. Os estados podem
        ter outros nomes: a verificação compara o comportamento para todas as
        entradas.
      </p>
    </details>
  </div>
  <noscript>
    <p>
      A edição e a simulação precisam de JavaScript. A tabela e o diagrama da
      lição descrevem a máquina sem executar código.
    </p>
  </noscript>
</div>

<script>
  import '../scripts/automata-lab';
</script>
