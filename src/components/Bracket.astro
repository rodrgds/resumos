---
interface Props {
  label?: string;
}
const { label = 'Ideia-chave' } = Astro.props;
---

<aside class="reading-bracket" data-reading-bracket aria-label={label}>
  <p class="bracket-label">{label}</p>
  <slot />
</aside>
<style>
  .reading-bracket {
    margin: 32px 0;
    padding: 4px 0 4px 20px;
    border-left: 1px solid var(--accent);
  }
  .reading-bracket[data-drawn] {
    border-left-color: transparent;
  }
  .bracket-label {
    font-family: 'Manrope Variable', sans-serif;
    font-size: 12px;
    color: var(--accent);
    margin: 0 0 8px;
  }
</style>
<script>
  import { annotate } from 'rough-notation';
  for (const element of document.querySelectorAll<HTMLElement>(
    '[data-reading-bracket]',
  )) {
    const drawing = annotate(element, {
      type: 'bracket',
      brackets: ['left'],
      color: 'var(--accent)',
      strokeWidth: 1.5,
      padding: 4,
      animate: false,
    });
    element.nextElementSibling?.setAttribute('aria-hidden', 'true');
    new ResizeObserver(() => {
      drawing.show();
      element.dataset.drawn = '';
    }).observe(element);
  }
</script>
