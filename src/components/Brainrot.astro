---
import Icon from './Icon.astro';
import { brainrotVoices } from '../data/brainrot-voices';
import '../styles/brainrot.css';
---

<dialog
  id="brainrot"
  class="brainrot"
  aria-labelledby="brainrot-title"
  data-pagefind-ignore
>
  <div class="brainrot-shell">
    <header class="brainrot-header">
      <button
        type="button"
        data-br-close
        aria-label="Voltar à página"
        autofocus
      >
        <Icon name="arrow-left" />
      </button>
      <h2 id="brainrot-title" class="sr-only">
        Brain rot
      </h2>
      <div class="brainrot-tabs">
        <span>A seguir</span>
        <strong>Para ti</strong>
      </div>
    </header>
    <div class="brainrot-stage">
      <div
        class="brainrot-feed"
        role="region"
        tabindex="0"
        aria-label="Vídeos de fundo. Desliza para mudar de vídeo."
      ></div>
      <div class="brainrot-overlay">
        <div class="brainrot-reading">
          <div
            class="brainrot-visual"
            role="region"
            tabindex="0"
            aria-label="Imagem, fórmula ou exemplo da página"
            hidden
          ></div>
          <p class="brainrot-caption"></p>
        </div>
        <div class="brainrot-topic">
          <strong>@resumos.feup</strong>
          <p data-br-title></p>
          <div class="brainrot-sound">
            <Icon name="musical-note-solid" size={13} />
            <span>
              som original · <span data-br-clip-name></span>
            </span>
          </div>
          <span class="sr-only" data-br-position></span>
        </div>
      </div>
      <button type="button" data-br-play class="brainrot-play">
        <Icon name="play-solid" class="brainrot-play-icon" size={42} />
        <Icon name="pause-solid" class="brainrot-pause-icon" size={42} />
        <span class="sr-only">Ouvir</span>
      </button>
      <aside class="brainrot-social" aria-label="Canal de demonstração">
        <div class="brainrot-avatar" aria-hidden="true">
          <Icon name="academic-cap-solid" size={25} />
          <span>
            <Icon name="plus" size={13} />
          </span>
        </div>
        <div
          class="brainrot-social-count"
          role="img"
          aria-label="12,4 mil gostos fictícios"
        >
          <Icon name="heart-solid" size={34} />
          <span>12,4 mil</span>
        </div>
        <div
          class="brainrot-social-count"
          role="img"
          aria-label="128 comentários fictícios"
        >
          <Icon name="chat-bubble-oval-left-ellipsis-solid" size={34} />
          <span>128</span>
        </div>
        <div
          class="brainrot-social-count"
          role="img"
          aria-label="3,2 mil favoritos fictícios"
        >
          <Icon name="bookmark-solid" size={32} />
          <span>3,2 mil</span>
        </div>
        <button
          type="button"
          class="brainrot-social-count"
          data-br-share
          aria-haspopup="dialog"
          aria-controls="brainrot-share"
        >
          <Icon name="arrow-uturn-right-solid" size={32} />
          <span>Partilhar</span>
        </button>
        <button
          type="button"
          data-br-voice-open
          class="brainrot-voice-button"
          aria-label="Definições de voz e velocidade"
          aria-haspopup="dialog"
          aria-controls="brainrot-voice-settings"
        >
          <Icon name="speaker-wave" class="brainrot-sound-on" size={24} />
          <Icon name="speaker-x-mark" class="brainrot-sound-off" size={24} />
        </button>
      </aside>
      <p class="brainrot-status" role="status" data-br-status hidden></p>
    </div>
    <div class="brainrot-progress">
      <output data-br-time class="brainrot-time" aria-hidden="true"></output>
      <input
        data-br-seek
        type="range"
        min="0"
        max="1"
        step="0.1"
        value="0"
        aria-label="Posição na leitura"
      />
    </div>
    <details class="brainrot-options">
      <summary aria-label="Opções de leitura">
        <Icon name="ellipsis-horizontal" size={26} />
      </summary>
      <div class="brainrot-settings">
        <h3>Leitura</h3>
        <div class="brainrot-transport">
          <button type="button" data-br-prev aria-label="Trecho anterior">
            <Icon name="backward" />
          </button>
          <button type="button" data-br-next aria-label="Trecho seguinte">
            <Icon name="forward" />
          </button>
        </div>
        <label class="brainrot-upload">
          Usar os meus vídeos
          <input data-br-files type="file" accept="video/*" multiple />
        </label>
        <p>
          Cada voz é descarregada na primeira utilização e guardada neste
          dispositivo. O texto, o áudio e os teus vídeos ficam aqui.
        </p>
        <a href="/brainrot/CREDITOS.txt" target="_blank" rel="noreferrer">
          Créditos dos vídeos e da voz
        </a>
      </div>
    </details>
    <nav class="brainrot-tabbar" aria-label="Navegação do feed">
      <button type="button" aria-current="page" aria-label="Início">
        <Icon name="home-solid" size={25} />
        <span>Início</span>
      </button>
      <button type="button" disabled aria-label="Descobrir, indisponível">
        <Icon name="magnifying-glass" size={25} />
        <span>Descobrir</span>
      </button>
      <button
        type="button"
        disabled
        class="brainrot-create"
        aria-label="Criar, indisponível"
      >
        <span>
          <Icon name="plus" size={25} />
        </span>
      </button>
      <button
        type="button"
        disabled
        aria-label="Caixa de entrada, indisponível"
      >
        <Icon name="chat-bubble-left-right" size={25} />
        <span>Caixa de entrada</span>
      </button>
      <button type="button" disabled aria-label="Perfil, indisponível">
        <Icon name="user" size={25} />
        <span>Perfil</span>
      </button>
    </nav>
    <nav class="brainrot-clip-controls" aria-label="Mudar vídeo">
      <button type="button" data-br-clip-prev aria-label="Vídeo anterior">
        <Icon name="chevron-up" size={26} />
      </button>
      <button type="button" data-br-clip-next aria-label="Vídeo seguinte">
        <Icon name="chevron-down" size={26} />
      </button>
    </nav>
  </div>
  <dialog
    id="brainrot-voice-settings"
    class="brainrot-panel"
    aria-labelledby="brainrot-voice-title"
  >
    <header>
      <h2 id="brainrot-voice-title">Voz e velocidade</h2>
      <button type="button" data-br-panel-close aria-label="Fechar definições">
        <Icon name="x-mark" />
      </button>
    </header>
    <div data-br-voice-controls>
      <label>
        <span class="brainrot-voice-label">
          Voz{' '}
          <span data-br-voice-weight hidden>
            Pesado
          </span>
        </span>
        <select
          data-br-voice
          aria-label="Voz"
          aria-describedby="brainrot-voice-cost"
        >
          <optgroup label="Piper">
            {brainrotVoices
              .filter((voice) => voice.engine === 'piper')
              .map((voice) => (
                <option value={voice.id}>{voice.name}</option>
              ))}
          </optgroup>
          <optgroup label="Sopro V2 Turbo · Pesado" data-br-sopro-voices>
            {brainrotVoices
              .filter((voice) => voice.engine === 'sopro')
              .map((voice) => (
                <option value={voice.id}>{voice.name}</option>
              ))}
          </optgroup>
          <option value="silent">Só legendas</option>
        </select>
      </label>
      <p id="brainrot-voice-cost" data-br-voice-cost hidden></p>
      <div class="brainrot-record-actions">
        <button type="button" data-br-record-open>
          <Icon name="microphone" size={18} />
          <span data-br-record-label>Gravar a minha voz</span>
        </button>
        <button
          type="button"
          data-br-record-delete
          hidden
          aria-label="Apagar a minha voz"
          title="Apagar a minha voz"
        >
          <Icon name="trash" size={18} />
        </button>
      </div>
      <p role="status" data-br-personal-status></p>
      <label>
        Velocidade
        <select data-br-rate aria-label="Velocidade da leitura">
          <option value="0.8">0,8×</option>
          <option value="1" selected>
            1×
          </option>
          <option value="1.25">1,25×</option>
          <option value="1.5">1,5×</option>
          <option value="2">2×</option>
        </select>
      </label>
      <label class="brainrot-checkbox-option">
        <input type="checkbox" data-br-highlight checked />
        Realçar leitura
      </label>
    </div>
    <section data-br-recording hidden aria-labelledby="brainrot-record-title">
      <h3 id="brainrot-record-title">Lê com a tua voz normal</h3>
      <p>São 20 segundos, num sítio tranquilo e sem música.</p>
      <blockquote class="brainrot-record-script">
        Hoje vou estudar com calma e perceber uma ideia de cada vez. Se alguma
        coisa não fizer sentido, volto atrás e experimento outro exemplo. Entre
        números, palavras e perguntas, o importante é compreender o raciocínio e
        conseguir explicá-lo pelas minhas próprias palavras.
      </blockquote>
      <div class="brainrot-record-progress" data-br-record-progress hidden>
        <progress
          data-br-record-meter
          max="20"
          value="0"
          aria-label="Tempo de gravação"
        ></progress>
        <output data-br-record-time>0 / 20 s</output>
      </div>
      <audio
        data-br-record-preview
        controls
        preload="metadata"
        aria-label="Ouvir a minha gravação"
        hidden
      ></audio>
      <p role="status" data-br-record-status></p>
      <div class="brainrot-record-actions">
        <button
          type="button"
          data-br-record-start
          class="brainrot-record-primary"
        >
          Começar gravação
        </button>
        <button type="button" data-br-record-stop hidden>
          Terminar gravação
        </button>
        <button
          type="button"
          data-br-record-save
          class="brainrot-record-primary"
          hidden
        >
          Usar esta voz
        </button>
        <button type="button" data-br-record-cancel>
          Cancelar
        </button>
      </div>
      <p>
        A gravação fica só neste navegador. Podes apagá-la quando quiseres. A
        leitura usa o Sopro, que é mais pesado.
      </p>
    </section>
  </dialog>
  <dialog
    id="brainrot-share"
    class="brainrot-panel"
    aria-labelledby="brainrot-share-title"
  >
    <header>
      <h2 id="brainrot-share-title">Partilhar página</h2>
      <button type="button" data-br-panel-close aria-label="Fechar partilha">
        <Icon name="x-mark" />
      </button>
    </header>
    <label>
      Ligação da página
      <input data-br-share-url type="url" readonly />
    </label>
    <div class="brainrot-share-actions">
      <button type="button" data-br-copy>
        <Icon name="link" />
        Copiar ligação
      </button>
      <button type="button" data-br-native-share hidden>
        <Icon name="share" />
        Mais opções
      </button>
    </div>
    <p role="status" data-br-share-status></p>
  </dialog>
</dialog>

<script>
  const opener = document.querySelector<HTMLButtonElement>(
    '[data-open-brainrot]',
  );
  let setup: Promise<void> | undefined;
  let activation = 0;
  window.addEventListener('pagehide', () => activation++);
  opener?.addEventListener('click', async () => {
    const current = ++activation;
    setup ??= import('../scripts/brainrot').then(({ setupBrainrot }) =>
      setupBrainrot(),
    );
    try {
      await setup;
      if (current !== activation) return;
      document.querySelector<HTMLDialogElement>('#brainrot')?.showModal();
      document.dispatchEvent(new Event('brainrot:open'));
    } catch {
      setup = undefined;
      opener.textContent = 'Tentar abrir Brain rot';
    }
  });
</script>
