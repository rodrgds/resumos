---
import Icon from './Icon.astro';
import EditorFullscreen from './EditorFullscreen.astro';
import CodeTestCase from './CodeTestCase.astro';
import { Code } from 'astro:components';
import { codeTheme } from '../lib/code-theme.mjs';
import type { CodeAnswer } from '../lib/code-exercise';
import '../styles/playground.css';
interface Props {
  answer: CodeAnswer;
}
const { answer } = Astro.props;
---

<div data-editor-workspace>
  <div
    class="playground"
    data-code-exercise
    data-pagefind-ignore
    data-annotation-ignore
  >
    <div class="playground-toolbar">
      <strong class="playground-title">
        {answer.language === 'python' ? 'Python' : 'JavaScript'}
      </strong>
      <div class="playground-actions">
        <EditorFullscreen />
        <button
          type="button"
          data-code-reset
          hidden
          aria-label="Repor código"
          title="Repor código"
          disabled
        >
          <Icon name="arrow-path" size={15} />
        </button>
        <button
          type="button"
          data-code-stop
          aria-label="Parar"
          title="Parar"
          hidden
        >
          <Icon name="stop" size={15} />
        </button>
        <button
          type="button"
          data-code-check
          aria-label="Verificar código"
          title="Verificar código (Ctrl+Enter ou Cmd+Enter)"
          disabled
        >
          <Icon name="play" size={15} />
        </button>
      </div>
    </div>
    <div class="editor-panes">
      <div class="editor-source-pane">
        <div data-code-source>
          <Code
            code={answer.starter}
            lang={answer.language}
            theme={codeTheme}
          />
        </div>
        <div data-code-editor></div>
      </div>
      <template data-fold-open>
        <Icon name="chevron-down" size={14} />
      </template>
      <template data-fold-closed>
        <Icon name="chevron-right" size={14} />
      </template>
      <div class="editor-result-pane">
        <div class="editor-pane-label">Testes e resultado</div>
        <p class="editor-empty">
          Verifica o código para comparar o resultado com os testes.
        </p>
        <details class="playground-input" data-code-tests>
          <summary class="icon-disclosure">
            Testes <Icon name="chevron-down" size={16} />
          </summary>
          <ol class="code-test-list">
            {answer.tests.map((test) => (
              <li>
                <details class="code-test-case">
                  <summary class="icon-disclosure">
                    {test.name} <Icon name="chevron-down" size={14} />
                  </summary>
                  <CodeTestCase
                    test={test}
                    language={answer.language}
                    mode="reference"
                  />
                </details>
              </li>
            ))}
          </ol>
        </details>
        <div class="playground-result" data-code-result hidden>
          <div class="code-feedback-row">
            <Icon name="check-circle" class="feedback-correct" size={16} />
            <Icon
              name="exclamation-circle"
              class="feedback-attempted"
              size={16}
            />
            <p role="status" data-code-status></p>
          </div>
          <div
            aria-label="Diagnóstico dos testes"
            data-code-output
            hidden
          ></div>
        </div>
        {answer.tests.map((test) => (
          <template data-code-diagnostic>
            <CodeTestCase
              test={test}
              language={answer.language}
              mode="diagnostic"
            />
          </template>
        ))}
      </div>
    </div>
    <noscript>
      <p>
        Ativa JavaScript para editar e verificar o código. Os testes e a solução
        continuam disponíveis.
      </p>
    </noscript>
  </div>
</div>
<script>
  import { setupCodeExercises } from '../scripts/code-exercises';
  setupCodeExercises();
</script>
