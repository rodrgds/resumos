---
import Icon from './Icon.astro';
import type { Language } from '../lib/runners/types';
import '../styles/playground.css';
interface Props {
  language: Language;
  code: string;
  input?: string;
  title?: string;
}
const { language, code, input = '', title } = Astro.props;
const labels = {
  python: 'Python',
  javascript: 'JavaScript',
  sql: 'SQL',
  cpp: 'C++',
  java: 'Java',
  c: 'C',
  haskell: 'Haskell',
  prolog: 'Prolog',
  php: 'PHP',
  riscv: 'RISC-V',
};
---

<section
  data-annotation-ignore
  class="playground"
  data-playground
  data-language={language}
  aria-label={title || `Experimentar ${labels[language]}`}
>
  <div class="playground-toolbar" data-pagefind-ignore>
    <strong>{title || labels[language]}</strong>
    <div>
      <button type="button" data-reset aria-label="Repor código">
        <Icon name="arrow-path" size={15} />
      </button>
      <button type="button" data-stop hidden>
        <Icon name="stop" size={14} /> Parar
      </button>
      <button type="button" data-run title="Executar (Ctrl+Enter ou Cmd+Enter)">
        <Icon name="play" size={15} /> Executar
      </button>
    </div>
  </div>
  <pre
    data-source
  ><code class={`language-${language}`}>{code.trim()}</code></pre>
  <template data-fold-open>
    <Icon name="chevron-down" size={14} />
  </template>
  <template data-fold-closed>
    <Icon name="chevron-right" size={14} />
  </template>
  <div data-editor></div>
  <div data-pagefind-ignore>
    {language !== 'haskell' && (
      <details class="playground-input">
        <summary class="icon-disclosure">
          {language === 'php' ? 'Corpo do pedido' : 'Dados de entrada'}
          <Icon name="chevron-down" size={16} />
        </summary>
        <label>
          {language === 'php'
            ? 'Disponível em php://input'
            : 'Uma entrada por linha'}
          <textarea data-stdin rows="3" spellcheck="false">{input}</textarea>
        </label>
      </details>
    )}
    <div class="playground-result" hidden>
      <div class="playground-status" role="status"></div>
      <pre data-output aria-label="Resultado" tabindex="0"></pre>
    </div>
  </div>
</section>
<script>
  const observer = new IntersectionObserver(
    async (entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      const { setupPlaygrounds } = await import('../scripts/playgrounds');
      setupPlaygrounds();
    },
    { rootMargin: '200px' },
  );
  document
    .querySelectorAll('[data-playground]')
    .forEach((element) => observer.observe(element));
</script>
