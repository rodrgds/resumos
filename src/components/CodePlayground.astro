---
import Icon from './Icon.astro';
import EditorFullscreen from './EditorFullscreen.astro';
import {
  LANGUAGE_LABELS as labels,
  isDatabase,
  type Language,
} from '../lib/runners/types';
import { MAIN_FILENAMES, supportFiles } from '../lib/playground-files';
import {
  detectDelimiter,
  isCsvFilename,
  splitCsvSpans,
} from '../lib/csv-columns';
import '../styles/playground.css';
interface Props {
  language: Language;
  code: string;
  // Editable support files shown as tabs in the toolbar. The main program in
  // `code` is the file that runs; the others are available to import or read,
  // e.g. `files={{ "vendas.csv": vendas }}`.
  files?: Record<string, string>;
  input?: string;
  title?: string;
  autoRun?: boolean;
}
const {
  language,
  code,
  files = {},
  input,
  title,
  autoRun = !['java', 'haskell'].includes(language),
} = Astro.props;
if (input !== undefined && (isDatabase(language) || language === 'haskell'))
  throw new Error(
    `CodePlayground: ${labels[language]} não aceita entrada padrão.`,
  );
const supports = supportFiles(language, files);
const mainFilename = MAIN_FILENAMES[language];
const fileGroup = `playground-files-${crypto.randomUUID()}`;
const escapeHtml = (text: string) =>
  text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
// Column colours for data files, matching the editor decorations.
const renderCsv = (content: string, filename: string) => {
  const delimiter = detectDelimiter(content, filename);
  return content
    .split('\n')
    .map((line, row) =>
      splitCsvSpans(line, delimiter)
        .map(
          (span, column) =>
            `<span class="csv-col-${column % 10}${row === 0 ? ' csv-header' : ''}">${escapeHtml(line.slice(span.start, span.end))}</span>`,
        )
        .join(`<span class="csv-delimiter">${escapeHtml(delimiter)}</span>`),
    )
    .join('\n');
};
---

<div data-editor-workspace>
  <section
    data-annotation-ignore
    class="playground"
    data-playground
    data-language={language}
    data-auto-run={autoRun}
    aria-label={title || `Experimentar ${labels[language]}`}
  >
    <div class="playground-toolbar" data-pagefind-ignore>
      {supports.length > 0 && (
        <fieldset class="playground-file-tabs" hidden>
          <legend class="sr-only">Ficheiros do exemplo</legend>
          {[{ name: mainFilename }, ...supports].map((file, index) => (
            <label>
              <input
                type="radio"
                name={fileGroup}
                value={index}
                checked={index === 0}
              />
              {file.name}
            </label>
          ))}
        </fieldset>
      )}
      <strong class="playground-title">
        {title || (isDatabase(language) ? '' : labels[language])}
      </strong>
      <div class="playground-actions">
        {input !== undefined && (
          <details class="playground-stdin">
            <summary
              aria-label={
                language === 'php' ? 'Corpo do pedido' : 'Dados de entrada'
              }
              title={
                language === 'php' ? 'Corpo do pedido' : 'Dados de entrada'
              }
            >
              <Icon name="command-line" size={15} />
            </summary>
            <div class="playground-stdin-panel">
              <label>
                {language === 'php'
                  ? 'Disponível em php://input'
                  : 'Entrada padrão'}
                <textarea
                  data-stdin
                  rows="3"
                  spellcheck="false"
                  set:text={input}
                ></textarea>
              </label>
            </div>
          </details>
        )}
        <EditorFullscreen />
        <button
          type="button"
          data-reset
          aria-label="Repor código"
          title="Repor código"
          disabled
        >
          <Icon name="arrow-path" size={15} />
        </button>
        <button type="button" data-stop aria-label="Parar" title="Parar" hidden>
          <Icon name="stop" size={15} />
        </button>
        <button
          type="button"
          data-run
          aria-label="Executar"
          title="Executar (Ctrl+Enter ou Cmd+Enter)"
          disabled
        >
          <Icon name="play" size={15} />
        </button>
      </div>
    </div>
    <div class="editor-panes">
      <div class="editor-source-pane">
        <div data-file-pane="0">
          <pre
            data-source
            data-filename={mainFilename}
            tabindex="0"
            aria-label={`Código ${labels[language]}`}
          ><code class={`language-${language}`}>{code.trim()}</code></pre>
          <div data-editor></div>
        </div>
        {supports.map((file, index) => (
          <div data-file-pane={index + 1} data-pagefind-ignore>
            {isCsvFilename(file.name) ? (
              <pre
                data-support-source
                data-filename={file.name}
                tabindex="0"
                aria-label={`Ficheiro ${file.name}`}
              ><code set:html={renderCsv(file.content, file.name)} /></pre>
            ) : (
              <pre
                data-support-source
                data-filename={file.name}
                tabindex="0"
                aria-label={`Ficheiro ${file.name}`}
              ><code>{file.content}</code></pre>
            )}
            <div data-support-editor data-filename={file.name}></div>
          </div>
        ))}
        <template data-fold-open>
          <Icon name="chevron-down" size={14} />
        </template>
        <template data-fold-closed>
          <Icon name="chevron-right" size={14} />
        </template>
      </div>
      <div class="editor-result-pane" data-pagefind-ignore>
        <div class="editor-pane-label">Resultado</div>
        <p class="editor-empty">
          {isDatabase(language)
            ? 'Executa a consulta para ver as tabelas.'
            : 'Executa o código para ver a saída e os gráficos.'}
        </p>
        <div class="playground-result" hidden>
          <div class="playground-status" role="status"></div>
          <pre data-output aria-label="Resultado" tabindex="0"></pre>
        </div>
      </div>
    </div>
  </section>
</div>
<script>
  const observer = new IntersectionObserver(
    async (entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      const { setupPlaygrounds } = await import('../scripts/playgrounds');
      setupPlaygrounds();
    },
    { rootMargin: '200px' },
  );
  document
    .querySelectorAll('[data-playground]')
    .forEach((element) => observer.observe(element));
</script>
