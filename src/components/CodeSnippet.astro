---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';
import { codeShikiConfig } from '../lib/code-theme.mjs';

interface Props {
  code: string;
  language?: ComponentProps<typeof Code>['lang'];
}
const { code, language = 'text' } = Astro.props;
---

<Code code={code.trimEnd()} lang={language} {...codeShikiConfig} />
