---
import { Code } from 'astro:components';
import { codeTheme } from '../lib/code-theme.mjs';
import type { CodeAnswer, CodeTest } from '../lib/code-exercise';
interface Props {
  test: CodeTest;
  language: CodeAnswer['language'];
  mode: 'reference' | 'diagnostic';
}
const { test, language, mode } = Astro.props;
---

<div class="code-test-details">
  {test.code && (
    <div class="code-test-source">
      <span class="code-test-label">
        {mode === 'diagnostic' ? 'Teste executado' : 'Código do teste'}
      </span>
      <Code code={test.code} lang={language} theme={codeTheme} tabindex="0" />
    </div>
  )}
  {test.input && (
    <div class="code-test-input">
      <span class="code-test-label">Entrada</span>
      <pre tabindex="0">{test.input}</pre>
    </div>
  )}
  <div class="code-test-comparison">
    <div>
      <span class="code-test-label">Esperado:</span>
      <pre tabindex="0">{test.output || '(sem saída)'}</pre>
    </div>
    {mode === 'diagnostic' && (
      <div>
        <span class="code-test-label">Obtido:</span>
        <pre tabindex="0" data-code-obtained></pre>
      </div>
    )}
  </div>
  {mode === 'diagnostic' && <pre
    class="code-test-error"
    data-code-error
    hidden
    tabindex="0"
  ></pre>}
</div>
