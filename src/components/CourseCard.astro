---
import CourseIcon from './CourseIcon.astro';
import type { Course } from '../data/courses';
interface Props {
  course: Course;
  href?: string;
}
const { course, href } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={[
    'course-card',
    `color-${course.color}`,
    { 'elective-card': course.elective },
  ]}
  id={`cadeira-${course.id}`}
  data-course
  data-course-root={href}
  data-search={`${course.acronym} ${course.name}`}
  data-title={course.name}
  data-acronym={course.acronym}
  data-meta={`${course.year}.º ano · ${course.semester}.º semestre · ${course.ects.toLocaleString('pt-PT')} ECTS`}
  data-elective={course.elective ? 'true' : undefined}
  aria-haspopup={href ? undefined : 'dialog'}
>
  <span class="card-top">
    <h4 class="course-acronym" id={`resumo-${course.id}`}>
      {course.acronym}
      <span class="sr-only"> · {course.name}</span>
    </h4>
    <CourseIcon name={course.icon} />
  </span>
  <span class="course-name">{course.name}</span>
  <span class="card-bottom">
    <span>
      {course.elective || course.optional ? 'Opção · ' : ''}
      {course.ects.toLocaleString('pt-PT')} ECTS
    </span>
    <span class="course-status">{href ? 'Ver resumos' : 'Em breve'}</span>
  </span>
</Tag>
