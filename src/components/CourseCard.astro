---
import { icons, type Course } from '../data/courses';
interface Props {
  course: Course;
}
const { course } = Astro.props;
const Icon = icons[course.icon];
---

<button
  class:list={[
    'course-card',
    `color-${course.color}`,
    { 'elective-card': course.elective },
  ]}
  id={`cadeira-${course.acronym.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
  data-course
  data-search={`${course.acronym} ${course.name}`}
  data-title={course.name}
  data-acronym={course.acronym}
  data-meta={`${course.year}.º ano · ${course.semester}.º semestre · ${course.ects.toLocaleString('pt-PT')} ECTS`}
  data-elective={course.elective ? 'true' : undefined}
  aria-haspopup="dialog"
>
  <span class="card-top">
    <h4
      class="course-acronym"
      id={`resumo-${course.acronym.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
    >
      {course.acronym}
      <span class="sr-only"> · {course.name}</span>
    </h4>
    <Icon size={56} stroke-width={1.7} aria-hidden="true" />
  </span>
  <span class="course-name">{course.name}</span>
  <span class="card-bottom">
    <span>
      {course.elective ? 'Opção · ' : ''}
      {course.ects.toLocaleString('pt-PT')} ECTS
    </span>
    <span class="course-status">Em breve</span>
  </span>
</button>
