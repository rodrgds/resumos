---
import Icon from './Icon.astro';
interface Props {
  curriculum: { url: string };
}
const { curriculum } = Astro.props;
---

<dialog id="course-detail" class="course-dialog" aria-labelledby="course-title">
  <div class="dialog-header">
    <span id="detail-acronym"></span>
    <button class="icon-button" data-close aria-label="Fechar cadeira">
      <Icon name="x-mark" size={22} />
    </button>
  </div>
  <Icon name="academic-cap" class="detail-icon" size={36} stroke-width={1.5} />
  <h2 id="course-title"></h2>
  <p id="course-meta"></p>
  <div class="unpublished">
    <h3>Os primeiros resumos ainda estão por escrever.</h3>
    <p id="course-description">
      Tens apontamentos desta cadeira? Podes ajudar a começar.
    </p>
  </div>
  <a class="primary-link" href="/exemplo/" id="course-contribute">
    Como contribuir <Icon name="arrow-right" size={17} />
  </a>
  <a
    class="official-link"
    href={curriculum.url}
    target="_blank"
    rel="noreferrer"
  >
    Ver o plano no SIGARRA <Icon name="arrow-top-right-on-square" size={15} />
  </a>
</dialog>

<script src="../scripts/home.ts"></script>
