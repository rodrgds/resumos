---
import { courseIcons, type CourseIconName } from '../lib/course-icons';

interface Props {
  name: CourseIconName;
  size?: number;
}
const { name, size = 56 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={courseIcons[name].body}
/>
