---
import Icon from './Icon.astro';
import TableOfContents from './TableOfContents.astro';
import type { MarkdownHeading } from 'astro';
import { sections, lessonPath, type CourseGuide } from '../lib/course-content';
interface Props {
  course: CourseGuide;
  headings?: MarkdownHeading[];
}
const { course, headings = [] } = Astro.props;
---

<details class="course-sidebar" data-pagefind-ignore>
  <summary>
    <Icon name="book-open" size={18} /> Conteúdos{' '}
    <Icon name="chevron-down" size={17} />
  </summary>
  <nav aria-label="Conteúdos da cadeira">
    <h2>{course.name}</h2>
    <a
      class="course-overview"
      href={course.path}
      aria-current={Astro.url.pathname === course.path ? 'page' : undefined}
    >
      Apresentação
    </a>
    {Astro.url.pathname === course.path && headings.length > 0 && (
      <TableOfContents headings={headings} />
    )}
    {Object.entries(sections).map(([key, name]) => {
      const lessons = course.lessons.filter(
        (lesson) => lesson.data.section === key,
      );
      return (
        lessons.length > 0 && (
          <section>
            <h3>{name}</h3>
            <ul>
              {lessons.map((lesson) => (
                <li>
                  <a
                    href={lessonPath(course, lesson)}
                    aria-current={
                      Astro.url.pathname === lessonPath(course, lesson)
                        ? 'page'
                        : undefined
                    }
                  >
                    <span class="chapter-number" aria-hidden="true">
                      {String(course.lessons.indexOf(lesson) + 1).padStart(
                        2,
                        '0',
                      )}
                    </span>
                    <span>{lesson.data.title}</span>
                  </a>
                  {Astro.url.pathname === lessonPath(course, lesson) &&
                    headings.length > 0 && (
                      <TableOfContents headings={headings} />
                    )}
                </li>
              ))}
            </ul>
          </section>
        )
      );
    })}
    <a
      class="course-contribute"
      href="https://github.com/rodrgds/resumos/blob/main/CONTRIBUTING.md"
    >
      Contribuir para esta cadeira
    </a>
  </nav>
</details>
<script>
  import { setupDisclosure } from '../lib/disclosure';
  const sidebar = document.querySelector<HTMLDetailsElement>('.course-sidebar');
  if (sidebar) {
    const desktop = matchMedia('(min-width: 1200px)');
    setupDisclosure(sidebar, { persistent: () => desktop.matches });
    const sync = () => {
      sidebar.open = desktop.matches;
    };
    desktop.addEventListener('change', sync);
    sync();
  }
</script>
