---
import Icon from './Icon.astro';
import PersonalNoteLinks from './PersonalNoteLinks.astro';
import TableOfContents from './TableOfContents.astro';
import type { MarkdownHeading } from 'astro';
import { getTldrPaths } from '../lib/tldr-content';
import { lessonPath, type CourseGuide } from '../lib/course-content';
interface Props {
  course: CourseGuide;
  headings?: MarkdownHeading[];
}
const tldrPaths = await getTldrPaths();
const navigationPath = (path: string) =>
  Astro.url.pathname.endsWith('/tldr/') ? tldrPaths[path] || path : path;
const { course, headings = [] } = Astro.props;
---

<details class="course-sidebar" data-pagefind-ignore>
  <summary>
    <Icon name="book-open" size={18} /> Conteúdos{' '}
    <Icon name="chevron-down" size={17} />
  </summary>
  <nav aria-label="Conteúdos da cadeira">
    <PersonalNoteLinks course={course.id} />
    {(course.introduction || course.pages.length > 0) && (
      <>
        <h2 class="course-materials">Materiais</h2>
        <a
          class="course-overview"
          href={course.path}
          aria-current={
            Astro.url.pathname.replace(/\/tldr\/$/, '/') === course.path
              ? 'page'
              : undefined
          }
        >
          <span class="chapter-number" aria-hidden="true">
            00
          </span>
          <span>Apresentação</span>
        </a>
        {Astro.url.pathname.replace(/\/tldr\/$/, '/') === course.path &&
          headings.length > 0 && <TableOfContents headings={headings} />}
        <ul>
          {course.lessons.map((lesson, index) => (
            <li>
              <a
                href={navigationPath(lessonPath(course, lesson))}
                aria-current={
                  Astro.url.pathname.replace(/\/tldr\/$/, '/') ===
                  lessonPath(course, lesson)
                    ? 'page'
                    : undefined
                }
              >
                <span class="chapter-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{lesson.data.title}</span>
              </a>
              {Astro.url.pathname.replace(/\/tldr\/$/, '/') ===
                lessonPath(course, lesson) &&
                headings.length > 0 && <TableOfContents headings={headings} />}
            </li>
          ))}
        </ul>
        {course.revisions.length > 0 && (
          <ul class="course-revisions">
            {course.revisions.map((page) => (
              <li>
                <a
                  href={lessonPath(course, page)}
                  aria-current={
                    Astro.url.pathname.replace(/\/tldr\/$/, '/') ===
                    lessonPath(course, page)
                      ? 'page'
                      : undefined
                  }
                >
                  <Icon name="document-text" size={16} />
                  {course.revisions.length === 1
                    ? 'Cheat sheet'
                    : page.data.title}
                </a>
                {Astro.url.pathname.replace(/\/tldr\/$/, '/') ===
                  lessonPath(course, page) &&
                  headings.length > 0 && (
                    <TableOfContents headings={headings} />
                  )}
              </li>
            ))}
          </ul>
        )}
      </>
    )}
    <a
      class="course-contribute"
      href="https://github.com/rodrgds/resumos/blob/main/CONTRIBUTING.md"
    >
      Contribuir para esta cadeira
    </a>
  </nav>
</details>
<script>
  import { setupDisclosure } from '../lib/disclosure';
  const sidebar = document.querySelector<HTMLDetailsElement>('.course-sidebar');
  if (sidebar) {
    const desktop = matchMedia('(min-width: 1200px)');
    setupDisclosure(sidebar, { persistent: () => desktop.matches });
    const sync = () => {
      sidebar.open = desktop.matches;
    };
    desktop.addEventListener('change', sync);
    sync();
  }
</script>
