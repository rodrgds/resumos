---
import { getCourseGuides } from '../lib/course-content';
import CourseCard from './CourseCard.astro';
import Icon from './Icon.astro';
import type { Course } from '../data/courses';
interface Props {
  courses: Course[];
  years: number[];
}
const { courses, years } = Astro.props;
const published = new Map(
  (await getCourseGuides()).map((course) => [course.id, course.path]),
);
---

{years.map((year) => (
  <section
    class="year-section"
    data-course-year={year}
    aria-labelledby={`year-${year}`}
  >
    <div class="year-heading">
      <h2 id={`year-${year}`}>{year}.º ano</h2>
      <span>60 ECTS</span>
    </div>
    <div class="semesters">
      {[1, 2].map((semester) => (
        <section
          class="semester"
          aria-labelledby={`semester-${year}-${semester}`}
          data-semester={`${year}-${semester}`}
        >
          <div class="semester-heading">
            <h3 id={`semester-${year}-${semester}`}>{semester}.º semestre</h3>
            <button
              type="button"
              class="semester-pin"
              aria-pressed="false"
              aria-label={`Fixar ${semester}.º semestre no topo`}
            >
              <Icon name="map-pin" size={18} />
            </button>
          </div>
          <div class="course-grid">
            {courses
              .filter(
                (course) =>
                  course.year === year && course.semester === semester,
              )
              .map((course) => (
                <CourseCard course={course} href={published.get(course.id)} />
              ))}
          </div>
        </section>
      ))}
    </div>
  </section>
))}
