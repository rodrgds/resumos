---
import Icon from './Icon.astro';
---

<details class="css-snippets appearance-details" data-pagefind-ignore>
  <summary class="icon-disclosure">
    CSS personalizado <Icon name="chevron-down" size={16} />
  </summary>
  <p class="settings-note">
    Ativa uma sugestão ou guarda o teu CSS. Só muda este navegador.
  </p>
  <div data-snippet-list></div>
  <button type="button" class="reset-button" data-add-snippet>
    <Icon name="plus" size={16} /> Adicionar snippet
  </button>
  <p class="settings-note">
    Usa <code>--page</code>, <code>--text</code> e <code>--accent</code> para
    acompanhar o tema.
  </p>
  <details class="snippet-help">
    <summary>Seletores e recuperação</summary>
    <p>
      <code>.site-header</code>, <code>.prose</code>, <code>.course-card</code>,{' '}
      <code>[data-reading-history]</code>, <code>[data-playground]</code> e{' '}
      <code>.page-actions</code>.
    </p>
    <p>
      Abre a aparência com a tecla vírgula ou no rodapé. Se o CSS esconder os
      controlos, <a href="?sem-css=1">abre esta página sem CSS personalizado</a>
      .
    </p>
  </details>
  <p role="status" data-snippet-status class="settings-note"></p>
</details>

<template id="snippet-template">
  <section class="snippet-row">
    <div class="snippet-heading">
      <label class="check-row">
        <input type="checkbox" data-snippet-enabled />
        <span data-snippet-title></span>
      </label>
      <button type="button" data-edit-snippet class="snippet-edit">
        Editar
      </button>
    </div>
    <form class="snippet-editor" hidden>
      <label>
        Nome
        <input name="name" required maxlength="80" autocomplete="off" />
      </label>
      <label>
        CSS
        <textarea
          name="css"
          rows="5"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
        ></textarea>
      </label>
      <div class="snippet-buttons">
        <button type="submit" class="reset-button">
          Guardar
        </button>
        <button type="button" data-cancel-snippet class="reset-button">
          Cancelar
        </button>
        <button type="button" data-delete-snippet class="reset-button">
          Eliminar
        </button>
      </div>
    </form>
  </section>
</template>
<script src="../scripts/css-snippets.ts"></script>
<style is:global>
  .css-snippets {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .snippet-row {
    border-bottom: 1px solid var(--line);
    padding-block: 10px;
  }
  .snippet-heading,
  .snippet-buttons {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .snippet-heading {
    justify-content: space-between;
  }
  .snippet-heading[hidden],
  .snippet-buttons [hidden] {
    display: none;
  }
  .snippet-heading .check-row {
    margin: 0;
    padding-block: 8px;
    min-height: 44px;
  }
  .snippet-edit {
    background: none;
    border: 0;
    color: var(--accent);
    font: inherit;
    font-size: 13px;
    padding: 10px 0 10px 10px;
    cursor: pointer;
  }
  .snippet-editor:not([hidden]) {
    display: grid;
    gap: 12px;
    padding-top: 12px;
  }
  .snippet-editor label {
    display: grid;
    gap: 6px;
    font-size: 13px;
  }
  .snippet-editor input,
  .snippet-editor textarea {
    width: 100%;
    min-width: 0;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--page);
    color: var(--text);
    font: inherit;
  }
  .snippet-editor textarea {
    font: 12px/1.6 var(--code-font);
    resize: vertical;
  }
  .snippet-buttons {
    flex-wrap: wrap;
  }
  .snippet-buttons .reset-button {
    margin: 0;
  }
  .snippet-help {
    font-size: 12px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .snippet-help p {
    line-height: 1.7;
  }
</style>
