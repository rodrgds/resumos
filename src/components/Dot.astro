---
import { themeDiagram } from '../lib/diagram-theme';
import { renderDot } from '../lib/dot';
interface Props {
  source: string;
  alt: string;
}
const { source, alt } = Astro.props;
const svg = await renderDot(source);
---

<div
  class="diagram-figure dot-figure"
  role="img"
  aria-label={alt}
  tabindex="0"
  set:html={themeDiagram(svg)}
/>
<style>
  .dot-figure:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .dot-figure :global(svg) {
    max-width: none;
  }
  @media print {
    .dot-figure :global(svg) {
      max-width: 100%;
    }
  }
</style>
