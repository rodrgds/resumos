---
import Icon from './Icon.astro';
---

<button
  type="button"
  data-editor-fullscreen
  aria-label="Expandir editor"
  title="Expandir editor"
  aria-expanded="false"
  aria-haspopup="dialog"
>
  <Icon name="arrows-pointing-out" class="editor-expand-icon" size={15} />
  <Icon name="arrows-pointing-in" class="editor-collapse-icon" size={15} />
</button>
<script>
  import { setupEditorFullscreen } from '../scripts/editor-fullscreen';
  setupEditorFullscreen();
</script>
