---
import { CURRENT_EDITION, type Lesson } from '../lib/course-content';
interface Props {
  editorial?: Lesson['data']['editorial'];
  example?: boolean;
}
const { editorial, example = false } = Astro.props;
const review = editorial?.review;
const basis = editorial?.basedOn;
const checked = review?.edition === CURRENT_EDITION;
const summary = example
  ? 'Exemplo fictício para contribuidores.'
  : checked
    ? `Revisto para ${CURRENT_EDITION}.`
    : basis
      ? `Baseado em ${basis}. Por verificar para ${CURRENT_EDITION}.`
      : `Edição curricular por verificar.`;
const hasDetails = !!(
  review ||
  editorial?.coverage ||
  editorial?.sources.length ||
  editorial?.gaps.length
);
---

<div class="editorial-note" data-pagefind-ignore>
  {hasDetails ? (
    <details>
      <summary>
        {summary} <span>Fontes e revisão</span>
      </summary>
      {editorial?.coverage && <p>{editorial.coverage}</p>}
      {review && (
        <p>
          Revisão de {review.edition} por {review.reviewer}, em{' '}
          <time datetime={review.date}>{review.date}</time>.
        </p>
      )}
      {!!editorial?.sources.length && (
        <ul>
          {editorial.sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))}
        </ul>
      )}
      {!!editorial?.gaps.length && (
        <p>Por cobrir ou verificar: {editorial.gaps.join(' ')}</p>
      )}
    </details>
  ) : (
    <p>{summary}</p>
  )}
</div>
