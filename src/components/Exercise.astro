---
import Icon from './Icon.astro';
import '../styles/exercise.css';
type Answer =
  | { kind: 'self'; checklist: string[] }
  | { kind: 'number'; value: number; tolerance: number; unit?: string }
  | {
      kind: 'choice';
      options: { text: string; correct: boolean; explanation: string }[];
    };
interface Props {
  id: string;
  title: string;
  explanation: string;
  answer: Answer;
  revision?: number;
}
const { id, title, explanation, answer, revision = 1 } = Astro.props;
if (!/^[a-z0-9][a-z0-9-]*$/.test(id))
  throw new Error(`Exercise id must be a stable slug: ${id}`);
if (!explanation.startsWith('/') || !explanation.includes('#'))
  throw new Error(`${id}: link to the exact explanation heading.`);
if (
  answer.kind === 'number' &&
  (!Number.isFinite(answer.value) ||
    !Number.isFinite(answer.tolerance) ||
    answer.tolerance < 0)
)
  throw new Error(
    `${id}: provide a finite answer and nonnegative absolute tolerance.`,
  );
if (
  answer.kind === 'choice' &&
  answer.options.filter((option) => option.correct).length !== 1
)
  throw new Error(`${id}: choose exactly one correct option.`);
if (answer.kind === 'self' && answer.checklist.length === 0)
  throw new Error(`${id}: self assessment needs a checklist.`);
for (const slot of ['hint', 'hint-more', 'solution', 'mistakes']) {
  if (!Astro.slots.has(slot)) throw new Error(`${id}: missing ${slot} slot.`);
}
const course = Astro.url.pathname.startsWith('/exemplo/')
  ? 'exemplo'
  : Astro.url.pathname.split('/')[2];
---

<section
  class="exercise"
  id={id}
  data-exercise
  data-answer-kind={answer.kind}
  data-answer={JSON.stringify(answer)}
  data-progress-key={`${course}/${id}/${revision}`}
  aria-labelledby={`${id}-title`}
>
  <h3 id={`${id}-title`}>{title}</h3>
  <div class="exercise-prompt">
    <slot />
  </div>
  <slot name="work" />
  <div data-exercise-controls data-pagefind-ignore data-annotation-ignore>
    {answer.kind === 'choice' ? (
      <fieldset data-print-question>
        <legend>A tua resposta</legend>
        {answer.options.map((option, index) => (
          <label class="exercise-option">
            <input type="radio" name={`${id}-answer`} value={index} />
            {option.text}
          </label>
        ))}
      </fieldset>
    ) : (
      <label class="exercise-answer">
        A tua resposta
        {answer.kind === 'number' ? (
          <>
            <input
              type="text"
              inputmode="decimal"
              data-response
              autocomplete="off"
              aria-describedby={`${id}-tolerance`}
            />
            <small id={`${id}-tolerance`} data-print-question>
              Tolerância absoluta: ±{answer.tolerance.toLocaleString('pt-PT')}
              {answer.unit ? ` ${answer.unit}` : ''}. Aceita vírgula ou ponto
              decimal.
            </small>
          </>
        ) : (
          <textarea
            data-response
            rows="3"
            autocomplete="off"
            placeholder="Escreve o teu raciocínio antes de consultar as pistas."
          ></textarea>
        )}
      </label>
    )}
    <div class="exercise-actions" data-enhanced hidden>
      <button type="button" data-check>
        {answer.kind === 'self' ? 'Registar tentativa' : 'Verificar resposta'}
      </button>
      <button type="button" data-clear>
        Limpar resposta
      </button>
    </div>
    <p
      class="exercise-feedback"
      role="status"
      aria-live="polite"
      data-feedback
    ></p>
  </div>
  <div class="exercise-help">
    <details data-help="hint">
      <summary>
        <Icon name="chevron-right" size={16} />
        Primeira pista
      </summary>
      <slot name="hint" />
    </details>
    <details data-help="hint">
      <summary>
        <Icon name="chevron-right" size={16} />
        Mais uma pista
      </summary>
      <slot name="hint-more" />
    </details>
    <details data-help="solution">
      <summary>
        <Icon name="chevron-right" size={16} />
        Ver solução
      </summary>
      <div data-solution>
        <slot name="solution" />
        {answer.kind === 'choice' && (
          <ul>
            {answer.options.map((option) => (
              <li>
                <strong>{option.text}.</strong> {option.explanation}
              </li>
            ))}
          </ul>
        )}
        {answer.kind === 'self' && (
          <div class="exercise-checklist">
            <p>Confere a tua resposta:</p>
            <ul>
              {answer.checklist.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
        <div class="exercise-mistakes">
          <h4>Erros frequentes</h4>
          <slot name="mistakes" />
        </div>
      </div>
      {answer.kind === 'self' && (
        <button
          type="button"
          data-self-check
          data-enhanced
          hidden
          data-pagefind-ignore
        >
          Conferi a minha resposta
        </button>
      )}
    </details>
  </div>
  <a class="exercise-explanation" href={explanation}>
    Voltar à explicação
  </a>
</section>
<script>
  import { setupExercises } from '../scripts/exercises';
  setupExercises();
</script>
