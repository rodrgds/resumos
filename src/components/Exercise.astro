---
import Icon from './Icon.astro';
import CodeExercise from './CodeExercise.astro';
import ExerciseText from './ExerciseText.astro';
import type { CodeAnswer } from '../lib/code-exercise';
import '../styles/exercise.css';
type Answer =
  | CodeAnswer
  | { kind: 'self'; checklist: string[] }
  | { kind: 'number'; value: number; tolerance: number; unit?: string }
  | {
      kind: 'choice';
      options: { text: string; correct: boolean; explanation: string }[];
    };
interface Props {
  id: string;
  title: string;
  explanation: string;
  answer: Answer;
  revision?: number;
}
const { id, title, explanation, answer, revision = 1 } = Astro.props;
if (!/^[a-z0-9][a-z0-9-]*$/.test(id))
  throw new Error(`Exercise id must be a stable slug: ${id}`);
if (!explanation.startsWith('/') || !explanation.includes('#'))
  throw new Error(`${id}: link to the exact explanation heading.`);
if (
  answer.kind === 'number' &&
  (!Number.isFinite(answer.value) ||
    !Number.isFinite(answer.tolerance) ||
    answer.tolerance < 0)
)
  throw new Error(
    `${id}: provide a finite answer and nonnegative absolute tolerance.`,
  );
if (
  answer.kind === 'choice' &&
  answer.options.filter((option) => option.correct).length !== 1
)
  throw new Error(`${id}: choose exactly one correct option.`);
if (answer.kind === 'self' && answer.checklist.length === 0)
  throw new Error(`${id}: self assessment needs a checklist.`);
if (
  answer.kind === 'code' &&
  (!['python', 'javascript'].includes(answer.language) ||
    !answer.starter.trim() ||
    !answer.tests.length ||
    answer.tests.length > 12 ||
    answer.tests.some(
      (test) => !test.name.trim() || typeof test.output !== 'string',
    ))
)
  throw new Error(
    `${id}: provide starter code and 1–12 named executable tests.`,
  );
for (const slot of ['hint', 'hint-more', 'solution', 'mistakes']) {
  if (!Astro.slots.has(slot)) throw new Error(`${id}: missing ${slot} slot.`);
}
const course = Astro.url.pathname.startsWith('/exemplo/')
  ? 'exemplo'
  : Astro.url.pathname.split('/')[2];
---

<section
  class="exercise"
  id={id}
  data-exercise
  data-answer-kind={answer.kind}
  data-answer={JSON.stringify(answer)}
  data-progress-key={`${course}/${id}/${revision}`}
  aria-labelledby={`${id}-title`}
>
  <details class="exercise-disclosure">
    <summary id={`${id}-title`}>
      <Icon name="chevron-right" size={18} /> {title}
    </summary>
    <div class="exercise-body">
      <div class="exercise-prompt">
        <slot />
      </div>
      <slot name="work" />
      {answer.kind === 'code' && <CodeExercise answer={answer} />}
      <div data-exercise-controls data-pagefind-ignore data-annotation-ignore>
        {answer.kind === 'code' ? null : answer.kind === 'choice' ? (
          <fieldset data-print-question>
            <legend>A tua resposta</legend>
            {answer.options.map((option, index) => (
              <label class="exercise-option">
                <input type="radio" name={`${id}-answer`} value={index} />
                <span>
                  <ExerciseText text={option.text} />
                </span>
              </label>
            ))}
          </fieldset>
        ) : (
          <label class="exercise-answer">
            A tua resposta
            {answer.kind === 'number' ? (
              <>
                <input
                  type="text"
                  inputmode="decimal"
                  data-response
                  autocomplete="off"
                  aria-describedby={`${id}-tolerance`}
                />
                <small id={`${id}-tolerance`} data-print-question>
                  {answer.tolerance === 0
                    ? 'Valor exato'
                    : `±${answer.tolerance.toLocaleString('pt-PT')}`}
                  {answer.unit ? ` ${answer.unit}` : ''}
                </small>
              </>
            ) : (
              <textarea
                data-response
                rows="3"
                autocomplete="off"
                placeholder="O teu raciocínio…"
              ></textarea>
            )}
          </label>
        )}
        {answer.kind === 'choice' &&
          answer.options.map((option) => (
            <template data-option-explanation>
              <ExerciseText text={option.explanation} />
            </template>
          ))}
        {answer.kind !== 'code' && (
          <div class="exercise-actions" data-enhanced hidden>
            <button
              type="button"
              data-check
              aria-label={
                answer.kind === 'self'
                  ? 'Comparar com a solução'
                  : 'Verificar resposta'
              }
            >
              {answer.kind === 'self' ? 'Comparar com a solução' : 'Verificar'}
            </button>
            <button type="button" data-clear aria-label="Limpar resposta">
              Limpar
            </button>
          </div>
        )}
        <div class="exercise-feedback-row">
          <Icon name="check-circle" class="feedback-correct" size={16} />
          <Icon
            name="exclamation-circle"
            class="feedback-attempted"
            size={16}
          />
          <p
            class="exercise-feedback"
            role="status"
            aria-live="polite"
            data-feedback
          ></p>
        </div>
      </div>
      <div class="exercise-help">
        <details data-help="hint">
          <summary aria-label="Primeira pista">
            <Icon name="chevron-right" size={16} />
            Pista
          </summary>
          <slot name="hint" />
          <details data-help="hint">
            <summary>
              <Icon name="chevron-right" size={16} />
              Mais uma pista
            </summary>
            <slot name="hint-more" />
          </details>
        </details>
        <details data-help="solution">
          <summary aria-label="Ver solução">
            <Icon name="chevron-right" size={16} />
            Solução
          </summary>
          <div data-solution>
            <slot name="solution" />
            {answer.kind === 'choice' && (
              <ul>
                {answer.options.map((option) => (
                  <li>
                    <strong>
                      <ExerciseText text={option.text} />.
                    </strong>{' '}
                    <ExerciseText text={option.explanation} />
                  </li>
                ))}
              </ul>
            )}
            {answer.kind === 'self' && (
              <div class="exercise-checklist">
                <p>Confere a tua resposta:</p>
                <ul>
                  {answer.checklist.map((item) => (
                    <li>
                      <ExerciseText text={item} />
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <div class="exercise-mistakes">
              <h4>Erros frequentes</h4>
              <slot name="mistakes" />
            </div>
          </div>
          {answer.kind === 'self' && (
            <div
              class="exercise-actions"
              data-enhanced
              hidden
              data-pagefind-ignore
            >
              <button type="button" data-self-check="correct">
                A minha resposta está correta
              </button>
              <button type="button" data-self-check="incorrect">
                Preciso de corrigir
              </button>
            </div>
          )}
        </details>
      </div>
      <a class="exercise-explanation" href={explanation}>
        Voltar à explicação
      </a>
    </div>
  </details>
</section>
<script>
  import { setupExercises } from '../scripts/exercises';
  setupExercises();
</script>
