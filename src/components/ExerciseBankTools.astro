---
import Icon from './Icon.astro';
import '../styles/exercise-bank.css';
---

<section
  class="exercise-bank"
  aria-label="Progresso e filtros dos exercícios"
  data-exercise-bank
  data-pagefind-ignore
>
  <template data-modal-icons>
    <Icon name="x-mark" size={22} />
    <Icon name="arrow-left" size={16} />
    <Icon name="arrow-right" size={16} />
    <Icon name="arrow-path" size={16} />
  </template>
  <div class="exercise-bank-progress">
    <p class="exercise-bank-count" data-bank-count aria-live="polite"></p>
    <div class="exercise-bank-bar" aria-hidden="true">
      <span data-bank-bar></span>
    </div>
  </div>
  <div class="exercise-bank-actions" data-bank-actions hidden>
    <button type="button" class="exercise-bank-primary" data-bank-random>
      <Icon name="arrow-path" size={18} /> Exercício aleatório por resolver
    </button>
    <button type="button" class="exercise-bank-danger" data-bank-clear>
      Limpar resolvidos
    </button>
  </div>
  <div class="exercise-bank-filters" data-bank-filters hidden>
    <div class="exercise-bank-segments" role="group" aria-label="Mostrar">
      <button type="button" data-bank-filter="all" aria-pressed="true">
        Todos
      </button>
      <button type="button" data-bank-filter="unsolved" aria-pressed="false">
        Por resolver
      </button>
      <button type="button" data-bank-filter="solved" aria-pressed="false">
        Resolvidos
      </button>
    </div>
    <label class="exercise-bank-search">
      <Icon name="magnifying-glass" size={18} />
      <span class="sr-only">Pesquisar exercícios</span>
      <input
        type="search"
        placeholder="Pesquisar exercícios"
        autocomplete="off"
        data-bank-search
      />
    </label>
  </div>
  <p class="exercise-bank-empty" data-bank-empty hidden>
    Nenhum exercício corresponde a esta pesquisa.
  </p>
  <dialog
    class="exercise-bank-confirm"
    aria-labelledby="bank-clear-title"
    data-bank-confirm
  >
    <h2 id="bank-clear-title">Limpar todos os resolvidos?</h2>
    <p data-bank-confirm-text></p>
    <div class="exercise-bank-confirm-actions">
      <button type="button" data-bank-cancel autofocus>
        Cancelar
      </button>
      <button
        type="button"
        class="exercise-bank-danger"
        data-bank-confirm-clear
      >
        Limpar tudo
      </button>
    </div>
  </dialog>
</section>
<script>
  import { setupExerciseBank } from '../scripts/exercise-bank';
  setupExerciseBank();
</script>
