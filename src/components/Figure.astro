---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  dark?: 'original' | 'dim' | 'invert';
}
const { src, alt, caption, dark = 'original' } = Astro.props;
if (!alt.trim()) throw new Error('Figure requires descriptive alt text.');
---

<figure class="content-figure">
  <img
    src={src}
    alt={alt}
    data-dark-image={dark}
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    {caption && <span>{caption}</span>}{' '}
    <a href={src} target="_blank" rel="noreferrer">
      Abrir imagem
    </a>
  </figcaption>
</figure>
