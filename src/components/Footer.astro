---
import Icon from './Icon.astro';
---

<footer class="container site-footer" data-pagefind-ignore>
  <div>
    <a class="footer-brand" href="/">
      Resumos LEIC <span>· FEUP</span>
    </a>
    <p>Um projeto de estudantes, independente da FEUP e da U.Porto.</p>
  </div>
  <div class="footer-actions">
    <button data-action="appearance" aria-haspopup="dialog">
      <Icon name="adjustments-horizontal" size={18} /> Aparência
    </button>
    <a href="https://github.com/rodrgds/resumos">
      <Icon name="code-bracket-square" size={17} /> GitHub
    </a>
    <button data-action="shortcuts" aria-haspopup="dialog">
      <Icon name="command-line" size={18} /> Atalhos
    </button>
    <a class="back-top" href="#conteudo" aria-label="Voltar ao topo">
      <Icon name="arrow-up" size={18} />
    </a>
  </div>
  <img
    class="footer-feup"
    src="/logos/feup.svg"
    alt="Faculdade de Engenharia da Universidade do Porto"
    width="180"
    height="65"
    loading="lazy"
  />
  <p class="inspiration">
    Inspirado nos <a href="https://resumos.leic.pt/">Resumos LEIC do Técnico</a>
    .
  </p>
</footer>
