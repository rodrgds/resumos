---
import Icon from './Icon.astro';
interface Props {
  label: string;
  source: string;
  rows?: number;
}
const { label, source, rows = 6 } = Astro.props;
---

<div class="formal-source" data-formal-source data-label={label}>
  <textarea
    aria-label={label}
    rows={rows}
    spellcheck="false"
    set:text={source}
  ></textarea>
  <div data-formal-editor></div>
  <template data-fold-open>
    <Icon name="chevron-down" size={14} />
  </template>
  <template data-fold-closed>
    <Icon name="chevron-right" size={14} />
  </template>
</div>
