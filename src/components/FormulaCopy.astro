---
import Icon from './Icon.astro';
import '../styles/formula-copy.css';
---

<span
  id="formula-copy-status"
  class="formula-toast"
  role="status"
  aria-live="polite"
  data-pagefind-ignore
></span>
<dialog
  id="formula-copy-dialog"
  aria-labelledby="formula-copy-title"
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="formula-copy-title">Copiar fórmula</h2>
    <button class="icon-button" data-close aria-label="Fechar fórmula">
      <Icon name="x-mark" size={20} />
    </button>
  </div>
  <p>A cópia automática não está disponível. Copia o LaTeX abaixo.</p>
  <label for="formula-copy-source">Fórmula para copiar</label>
  <textarea id="formula-copy-source" rows="4" readonly></textarea>
</dialog>
