---
import Icon from './Icon.astro';
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Resumos LEIC FEUP">
      <span>
        Resumos <strong>LEIC</strong>
      </span>
      <span class="feup-label">FEUP</span>
    </a>
    <nav aria-label="Navegação principal">
      <a class="nav-link" href="/nucleos/" data-nav="nucleos">
        Núcleos
      </a>
      <a class="nav-link" href="/exemplo/" data-nav="contribute">
        Contribuir
      </a>
      <button
        class="icon-button"
        aria-label="Pesquisar"
        data-action="search"
        aria-haspopup="dialog"
        title="Pesquisar"
      >
        <Icon name="magnifying-glass" size={21} />
      </button>
      <button
        class="icon-button desktop-tool"
        data-action="notes"
        aria-label="Abrir caderno"
        aria-controls="scratchpad"
        aria-expanded="false"
        title="Caderno"
      >
        <Icon name="book-open" size={21} />
      </button>
      <button
        class="icon-button"
        data-action="appearance"
        aria-label="Personalizar aparência"
        aria-haspopup="dialog"
        title="Aparência"
      >
        <Icon name="adjustments-horizontal" size={21} />
      </button>
      <details class="header-menu">
        <summary class="icon-button" aria-label="Mais navegação">
          <Icon name="bars-3" size={21} />
        </summary>
        <div class="header-menu-links">
          <a href="/nucleos/">Núcleos</a>
          <a href="/exemplo/">Contribuir</a>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  import '../scripts/header';
</script>
