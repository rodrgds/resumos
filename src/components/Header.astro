---
import Icon from './Icon.astro';
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Resumos LEIC FEUP, início">
      <span>
        Resumos <strong>LEIC</strong>
      </span>
      <span class="feup-label">FEUP</span>
    </a>
    <nav aria-label="Navegação principal">
      <a class="nav-link" href="/projetos/" data-nav="projects">
        Projetos
      </a>
      <a class="nav-link" href="/nucleos/" data-nav="nucleos">
        Núcleos
      </a>
      <a class="nav-link" href="/exemplo/" data-nav="contribute">
        Contribuir
      </a>
      <button
        class="icon-button"
        aria-label="Pesquisar"
        data-action="search"
        aria-haspopup="dialog"
        title="Pesquisar"
      >
        <Icon name="magnifying-glass" size={21} />
      </button>
      <button
        class="icon-button desktop-tool"
        data-action="notes"
        aria-label="Abrir caderno"
        aria-controls="scratchpad"
        aria-expanded="false"
        title="Caderno"
      >
        <Icon name="pencil-square" size={21} />
      </button>
      <button
        class="icon-button"
        data-action="appearance"
        aria-label="Personalizar aparência"
        aria-haspopup="dialog"
        title="Aparência"
      >
        <Icon name="adjustments-horizontal" size={21} />
      </button>
    </nav>
  </div>
  <nav class="mobile-nav" aria-label="Mais navegação">
    <a href="/projetos/" data-nav="projects">
      Projetos
    </a>
    <a href="/nucleos/" data-nav="nucleos">
      Núcleos
    </a>
    <a href="/exemplo/" data-nav="contribute">
      Contribuir
    </a>
    <button
      data-action="notes"
      aria-label="Abrir caderno"
      aria-controls="scratchpad"
      aria-expanded="false"
    >
      <Icon name="pencil-square" size={18} />
    </button>
    <button
      data-action="shortcuts"
      aria-label="Atalhos de teclado"
      aria-haspopup="dialog"
    >
      <Icon name="command-line" size={19} />
    </button>
    <a href="https://github.com/rodrgds/resumos" aria-label="GitHub">
      <Icon name="code-bracket-square" size={18} />
    </a>
  </nav>
</header>
