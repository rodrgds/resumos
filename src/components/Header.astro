---
import {
  Search,
  SlidersHorizontal,
  NotebookPen,
  Keyboard,
  GitFork,
} from '@lucide/astro';
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Resumos LEIC FEUP, início">
      <span>
        Resumos <strong>LEIC</strong>
      </span>
      <span class="feup-label">FEUP</span>
    </a>
    <nav aria-label="Navegação principal">
      <a class="nav-link" href="/#cadeiras">
        Cadeiras
      </a>
      <a class="nav-link" href="/nucleos/">
        Núcleos
      </a>
      <a class="nav-link" href="/#contribuir">
        Contribuir
      </a>
      <button
        class="search-trigger"
        aria-label="Pesquisar"
        data-action="search"
        aria-haspopup="dialog"
      >
        <Search size={19} />
        <span>Pesquisar</span>
        <kbd>⌘ K</kbd>
      </button>
      <button
        class="icon-button desktop-tool"
        data-action="notes"
        aria-label="Abrir bloco de notas"
        aria-controls="scratchpad"
        aria-expanded="false"
        title="Bloco de notas"
      >
        <NotebookPen size={21} />
      </button>
      <button
        class="icon-button"
        data-action="appearance"
        aria-label="Personalizar aparência"
        aria-haspopup="dialog"
        title="Aparência"
      >
        <SlidersHorizontal size={21} />
      </button>
    </nav>
  </div>
  <nav class="mobile-nav" aria-label="Mais navegação">
    <a href="/#cadeiras">Cadeiras</a>
    <a href="/nucleos/">Núcleos</a>
    <a href="/#contribuir">Contribuir</a>
    <button
      data-action="notes"
      aria-label="Abrir bloco de notas"
      aria-controls="scratchpad"
      aria-expanded="false"
    >
      <NotebookPen size={18} />
    </button>
    <button
      data-action="shortcuts"
      aria-label="Atalhos de teclado"
      aria-haspopup="dialog"
    >
      <Keyboard size={19} />
    </button>
    <a href="https://github.com/rodrgds/resumos" aria-label="GitHub">
      <GitFork size={18} />
    </a>
  </nav>
</header>
