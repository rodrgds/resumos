---
import heroicons from '@iconify-json/heroicons/icons.json';
import type { HTMLAttributes } from 'astro/types';

export type IconName = keyof typeof heroicons.icons;
interface Props extends HTMLAttributes<'svg'> {
  name: IconName;
  size?: number;
}
const { name, size = 20, ...attributes } = Astro.props;
const icon = heroicons.icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={`0 0 ${'width' in icon ? icon.width : heroicons.width} ${'height' in icon ? icon.height : heroicons.height}`}
  aria-hidden="true"
  focusable="false"
  {...attributes}
  set:html={icon.body}
/>
