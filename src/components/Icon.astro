---
import heroicons from '@iconify-json/heroicons/icons.json';
import type { HTMLAttributes } from 'astro/types';

const pin = {
  width: 24,
  height: 24,
  body: '<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 5 5-2 2-1-1-4 4 1 4-2 2-8-8 2-2 4 1 4-4-1-1 2-2Z"/><path d="m9 15-6 6"/></g>',
};
export type IconName = keyof typeof heroicons.icons | 'pin';
interface Props extends HTMLAttributes<'svg'> {
  name: IconName;
  size?: number;
}
const { name, size = 20, ...attributes } = Astro.props;
const icon = name === 'pin' ? pin : heroicons.icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={`0 0 ${'width' in icon ? icon.width : heroicons.width} ${'height' in icon ? icon.height : heroicons.height}`}
  aria-hidden="true"
  focusable="false"
  {...attributes}
  set:html={icon.body}
/>
