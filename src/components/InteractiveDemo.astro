---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div
  class="interactive-demo"
  role="group"
  aria-label={label}
  data-interactive-demo
  data-annotation-ignore
  data-pagefind-ignore
>
  <slot />
</div>

<style>
  .interactive-demo {
    margin-block: 24px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    font-family: 'Manrope Variable', sans-serif;
    font-size: 15px;
    line-height: 1.5;
  }
</style>
