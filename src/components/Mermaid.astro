---
import { renderMermaid } from '../lib/mermaid';
interface Props {
  source: string;
  alt: string;
  id?: string;
}
const { source, alt, id } = Astro.props;
const svg = renderMermaid(source, id);
---

<div
  class="diagram-figure mermaid-figure"
  role="img"
  aria-label={alt}
  tabindex="0"
  set:html={svg}
/>
<style>
  .mermaid-figure {
    padding: 12px;
  }
  .mermaid-figure:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .mermaid-figure :global(svg) {
    width: clamp(var(--diagram-min-width), 100%, var(--diagram-width));
    max-width: none;
  }
  @media print {
    .mermaid-figure :global(svg) {
      max-width: 100%;
    }
  }
</style>
