---
import Icon from './Icon.astro';
---

<template id="annotation-pin-icon">
  <Icon name="chat-bubble-left" size={17} />
</template>
<div
  id="selection-actions"
  class="selection-actions"
  role="group"
  aria-label="Anotar seleção"
  hidden
  data-pagefind-ignore
>
  <button id="highlight-selection">
    <Icon name="pencil" size={18} /> Destacar
  </button>
  <button id="comment-selection">
    <Icon name="chat-bubble-left" size={18} /> Comentar
  </button>
</div>
<aside
  id="scratchpad"
  class="notebook"
  aria-labelledby="notes-title"
  hidden
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="notes-title">O teu caderno</h2>
    <button class="icon-button" id="close-notes" aria-label="Fechar caderno">
      <Icon name="x-mark" size={22} />
    </button>
  </div>
  <p class="notebook-privacy">Só neste navegador. Só para ti.</p>
  <div id="notebook-browse" class="notebook-content">
    <div class="notebook-filters" role="group" aria-label="Mostrar notas">
      <button data-note-filter="page" aria-pressed="true">
        Nesta página <span id="page-note-count">0</span>
      </button>
      <button data-note-filter="all" aria-pressed="false">
        Todas <span id="all-note-count">0</span>
      </button>
    </div>
    <div id="notebook-empty" class="notebook-empty">
      <Icon name="pencil-square" size={30} stroke-width={1.5} />
      <h3>Guarda o que queres lembrar.</h3>
      <p>Seleciona texto num resumo para o destacar ou juntar um comentário.</p>
      <a href="/exemplo/apontamentos/">Experimentar no resumo de exemplo</a>
    </div>
    <ol id="annotation-list" class="annotation-list"></ol>
    <details id="legacy-notes" hidden>
      <summary class="icon-disclosure">
        Notas anteriores
        <Icon name="chevron-down" size={16} />
      </summary>
      <label class="sr-only" for="legacy-notes-input">
        As tuas notas anteriores
      </label>
      <textarea id="legacy-notes-input" rows="6"></textarea>
    </details>
  </div>
  <div id="annotation-editor" class="notebook-content" hidden>
    <button id="notes-back" class="notebook-back">
      <Icon name="arrow-left" size={17} /> Todas as notas
    </button>
    <p id="annotation-page" class="annotation-page"></p>
    <blockquote id="annotation-quote" tabindex="0"></blockquote>
    <button id="locate-annotation" class="notebook-link">
      Ver no texto
    </button>
    <p id="annotation-missing" class="notebook-notice" hidden>
      Este trecho mudou. A tua nota continua guardada aqui.
    </p>
    <label for="annotation-comment">O teu comentário</label>
    <textarea
      id="annotation-comment"
      rows="5"
      placeholder="Uma dúvida, uma ligação, uma ideia…"
      spellcheck="true"
    ></textarea>
    <p class="notebook-help">Guarda automaticamente enquanto escreves.</p>
    <button id="remove-annotation" class="notebook-remove">
      <Icon name="trash" size={16} /> Remover destaque e comentário
    </button>
  </div>
  <div class="notebook-footer">
    <span id="notes-status" role="status">
      Guardado neste navegador
    </span>
    <button
      id="download-notes"
      class="icon-button"
      aria-label="Descarregar notas"
    >
      <Icon name="arrow-down-tray" size={20} />
    </button>
  </div>
</aside>
<div
  id="annotation-feedback"
  class="annotation-feedback"
  hidden
  data-pagefind-ignore
>
  <span id="annotation-message" role="status"></span>
  <button id="annotation-undo" hidden>
    Desfazer
  </button>
  <button id="annotation-open" hidden>
    Ver nota
  </button>
  <button id="annotation-dismiss" class="icon-button" aria-label="Fechar aviso">
    <Icon name="x-mark" size={17} />
  </button>
</div>
