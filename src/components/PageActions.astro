---
import { Copy, Sparkles, ChevronDown } from '@lucide/astro';
---

<div class="page-actions" data-pagefind-ignore>
  <button data-copy-page>
    <Copy size={16} /> Copiar página
  </button>
  <button data-open-ai popovertarget="ai-menu">
    <Sparkles size={16} /> Perguntar à IA <ChevronDown size={15} />
  </button>
  <span class="copy-status" role="status"></span>
</div>
