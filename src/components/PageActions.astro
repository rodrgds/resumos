---
import AiMenu from './AiMenu.astro';
import Icon from './Icon.astro';
import PrintDialog from './PrintDialog.astro';
interface Props {
  hasExercises?: boolean;
  tldrUrl?: string;
  tldr?: boolean;
}
const { hasExercises = false, tldrUrl, tldr = false } = Astro.props;
---

<div class="page-actions" data-pagefind-ignore>
  <button
    data-open-ai
    popovertarget="ai-menu"
    aria-expanded="false"
    aria-label="Perguntar ao Chat"
    title="Perguntar ao Chat"
  >
    <Icon name="sparkles" size={16} />
    <span class="page-action-label" aria-hidden="true">
      Perguntar ao Chat
    </span>
    <span class="page-action-short-label" aria-hidden="true">
      Chat
    </span>
    <Icon name="chevron-down" size={15} class="disclosure-chevron" />
  </button>
  <button
    type="button"
    data-open-print
    aria-label="Imprimir"
    title="Imprimir"
    aria-haspopup={hasExercises ? 'dialog' : undefined}
    aria-controls={hasExercises ? 'print-dialog' : undefined}
    hidden
  >
    <Icon name="printer" size={16} />
    <span class="page-action-label" aria-hidden="true">
      Imprimir
    </span>
  </button>
  {tldrUrl && (
    <a
      href={tldrUrl}
      data-tldr-toggle={tldr ? 'full' : 'tldr'}
      role="switch"
      aria-checked={tldr}
      aria-label="TLDR"
      title={tldr ? 'Ler a lição completa' : 'Ler a versão curta'}
    >
      TLDR
    </a>
  )}
  <AiMenu markdown={!tldr} />
</div>
<PrintDialog hasExercises={hasExercises} />
