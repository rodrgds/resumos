---
import AiMenu from './AiMenu.astro';
import { Sparkles, ChevronDown, FileText } from '@lucide/astro';
---

<div class="page-actions" data-pagefind-ignore>
  <button data-open-ai popovertarget="ai-menu">
    <Sparkles size={16} /> Perguntar ao Chat <ChevronDown size={15} />
  </button>
  <a
    class="markdown-link"
    href={Astro.url.pathname.replace(/\/$/, '') + '.md'}
    title="Ler em Markdown"
  >
    <FileText size={16} />
    <span>Markdown</span>
  </a>
  <AiMenu />
</div>
