---
import AiMenu from './AiMenu.astro';
import Icon from './Icon.astro';
---

<div class="page-actions" data-pagefind-ignore>
  <button data-open-ai popovertarget="ai-menu" aria-expanded="false">
    <Icon name="sparkles" size={16} /> Perguntar ao Chat{' '}
    <Icon name="chevron-down" size={15} class="disclosure-chevron" />
  </button>
  <a
    class="markdown-link"
    href={Astro.url.pathname.replace(/\/$/, '') + '.md'}
    title="Ler em Markdown"
  >
    <Icon name="document-text" size={16} />
    <span>Markdown</span>
  </a>
  <AiMenu />
</div>
