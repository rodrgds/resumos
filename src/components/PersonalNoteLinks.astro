---
import Icon from './Icon.astro';
import { personalNoteUrl } from '../lib/personal-notes';
interface Props {
  course?: string;
}
const { course } = Astro.props;
---

<section class="personal-note-links" data-course={course} data-pagefind-ignore>
  <div class="personal-links-heading">
    <h3>Apontamentos</h3>
    {course && (
      <a
        data-new-personal-note
        href={`${personalNoteUrl(course)}#novo`}
        aria-label="Novo apontamento"
        title="Novo apontamento"
      >
        <Icon name="plus" size={17} />
      </a>
    )}
  </div>
  <ul></ul>
  <p role="status" hidden></p>
</section>
<script>
  import '../scripts/personal-note-links';
</script>
<style>
  .personal-note-links {
    margin-bottom: 20px;
  }
  .personal-links-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .personal-links-heading h3 {
    margin: 0 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }
  .personal-links-heading a {
    min-width: 36px;
    min-height: 36px;
    justify-content: center;
    align-items: center;
    padding: 8px;
  }
  .personal-note-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .personal-note-links p {
    font-size: 12px;
    color: var(--muted);
  }
</style>
