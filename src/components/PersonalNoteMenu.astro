---
import Icon from './Icon.astro';
import '../styles/note-menu.css';
---

<template id="note-menu-icon">
  <Icon name="ellipsis-horizontal" size={17} />
</template>
<div
  id="note-page-menu"
  class="note-menu"
  role="menu"
  popover="manual"
  aria-label="Ações do apontamento"
  data-pagefind-ignore
>
  <button role="menuitem" data-note-action="export">
    <Icon name="arrow-down-tray" size={18} /> Exportar apontamento
  </button>
  <button role="menuitem" data-note-action="delete">
    <Icon name="trash" size={18} /> Eliminar apontamento
  </button>
</div>
<div
  id="note-delete-notice"
  class="note-delete-notice"
  hidden
  data-pagefind-ignore
>
  <span role="status">Apontamento eliminado.</span>
  <button id="note-delete-undo">Desfazer eliminação</button>
  <button
    id="note-delete-dismiss"
    class="icon-button"
    aria-label="Fechar aviso"
  >
    <Icon name="x-mark" size={16} />
  </button>
</div>
