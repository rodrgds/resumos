---
import Icon from './Icon.astro';
interface Props {
  hasExercises: boolean;
}
const { hasExercises } = Astro.props;
---

{hasExercises && (
  <dialog
    id="print-dialog"
    class="print-dialog"
    aria-labelledby="print-title"
    data-pagefind-ignore
  >
    <form method="dialog">
      <header class="dialog-header">
        <h2 id="print-title">Imprimir esta página</h2>
        <button
          class="icon-button"
          value="cancel"
          aria-label="Fechar impressão"
        >
          <Icon name="x-mark" />
        </button>
      </header>
      <label>
        <input type="checkbox" data-print-exercises /> Incluir exercícios
      </label>
      <label>
        <input type="checkbox" data-print-solutions disabled /> Soluções no fim
      </label>
      <div class="print-dialog-actions">
        <button value="cancel">Cancelar</button>
        <button value="print">Imprimir</button>
      </div>
    </form>
  </dialog>
)}
<script>
  import '../scripts/print-page';
</script>
