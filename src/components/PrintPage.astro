---
import { preparePrintContent } from '../lib/print-content';
import Prose from './Prose.astro';
import '../styles/study-print.css';
interface Props {
  title: string;
  course: string;
}
const { title, course } = Astro.props;
const prepared = preparePrintContent(await Astro.slots.render('default'));
---

<template id="print-template" data-pagefind-ignore>
  <div class="print-page revision-sheet" data-print-page data-pagefind-ignore>
    <header>
      <p>{course}</p>
      <h1>{title}</h1>
    </header>
    <Prose>
      <Fragment set:html={prepared.content} />
      {prepared.solutions && (
        <section class="print-appendix">
          <h2>Soluções</h2>
          <Fragment set:html={prepared.solutions} />
        </section>
      )}
    </Prose>
  </div>
</template>
