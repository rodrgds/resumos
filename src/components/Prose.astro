---
import 'katex/dist/katex.min.css';
---

<div class="prose">
  <slot />
</div>
<style>
  .prose {
    max-width: var(--reading-width, 720px);
    font-family: var(--reading-font);
    font-size: var(--reading-size);
    line-height: 1.8;
  }
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
    margin-bottom: 0.7em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1em;
  }
  .prose :global(a) {
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .prose :global(pre),
  .prose :global(.katex-display) {
    overflow-x: auto;
    padding: 1rem;
  }
  .prose :global(table) {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .prose :global(td),
  .prose :global(th) {
    padding: 0.5em 1em;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
