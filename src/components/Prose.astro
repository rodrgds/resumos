---
import 'katex/dist/katex.min.css';
---

<div class="prose">
  <slot />
</div>
<script>
  const tables = document.querySelectorAll<HTMLTableElement>('.prose table');
  const sync = (table: HTMLTableElement) => {
    if (table.scrollWidth > table.clientWidth) table.tabIndex = 0;
    else table.removeAttribute('tabindex');
  };
  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) sync(entry.target as HTMLTableElement);
  });
  tables.forEach((table) => {
    sync(table);
    observer.observe(table);
  });
  window.addEventListener('pagehide', (event) => {
    if (!event.persisted) observer.disconnect();
  });
</script>
<style>
  .prose {
    max-width: var(--reading-width, 720px);
    font-family: var(--reading-font);
    font-size: var(--reading-size);
    line-height: 1.8;
  }
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
    margin-bottom: 0.7em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 1em;
  }
  .prose :global(a) {
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .prose :global(pre),
  .prose :global(.katex-display) {
    overflow-x: auto;
    padding: 1rem;
  }
  .prose :global(.katex-display > .katex) {
    white-space: normal;
    line-height: 1.8;
  }
  .prose :global(.katex-display .formula-parts) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.4em 1em;
  }
  .prose :global(.formula-part) {
    max-width: 100%;
  }
  .prose :global(table) {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .prose :global(table:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .prose :global(td),
  .prose :global(th) {
    padding: 0.5em 1em;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
