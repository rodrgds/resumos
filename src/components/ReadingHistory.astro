---
import { getCourseGuides, lessonPath } from '../lib/course-content';
import Icon from './Icon.astro';
const guides = await getCourseGuides();
const pages = guides.flatMap((course) => {
  const entries = [
    ...(course.introduction ? [course.introduction] : []),
    ...course.lessons,
  ];
  return entries.map((entry, index) => ({
    path: lessonPath(course, entry),
    title: entry.data.title,
    course: course.name,
    next: entries[index + 1]
      ? lessonPath(course, entries[index + 1])
      : undefined,
  }));
});
---

<section
  class="reading-history container"
  data-reading-history
  data-pages={JSON.stringify(pages)}
  hidden
  data-pagefind-ignore
  aria-labelledby="history-title"
>
  <div class="history-heading">
    <h2 id="history-title">Continuar a ler</h2>
    <button type="button" data-clear-history>
      Limpar histórico
    </button>
  </div>
  <div class="history-columns">
    <a class="reading-resume" data-resume>
      <Icon name="book-open" size={28} />
      <span>
        <small data-resume-label></small>
        <strong data-resume-title></strong>
        <span data-resume-course></span>
      </span>
      <Icon name="arrow-right" size={20} />
    </a>
    <div class="reading-recent">
      <h3>Vistos recentemente</h3>
      <ol data-recent></ol>
    </div>
  </div>
</section>
<script>
  import { readingHistory, clearReadingHistory } from '../lib/reading-history';
  const root = document.querySelector<HTMLElement>('[data-reading-history]')!;
  type Page = { path: string; title: string; course: string; next?: string };
  const pages: Page[] = JSON.parse(root.dataset.pages!);
  const catalog = new Map(pages.map((page) => [page.path, page]));
  const render = () => {
    const visits = readingHistory().filter((visit) => catalog.has(visit.path));
    root.hidden = !visits.length;
    if (!visits.length) return;
    const last = visits[0];
    const current = catalog.get(last.path)!;
    const next =
      last.reachedEnd && current.next ? catalog.get(current.next) : undefined;
    const resume = next || current;
    root.querySelector<HTMLAnchorElement>('[data-resume]')!.href =
      resume.path + (next ? '' : '?continuar=1');
    root.querySelector('[data-resume-label]')!.textContent = next
      ? 'Próximo tópico'
      : 'Onde ficaste';
    root.querySelector('[data-resume-title]')!.textContent = resume.title;
    root.querySelector('[data-resume-course]')!.textContent = resume.course;
    const list = root.querySelector('[data-recent]')!;
    list.replaceChildren();
    for (const visit of visits.slice(0, 4)) {
      const page = catalog.get(visit.path)!;
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = page.path;
      const title = document.createElement('span');
      title.textContent = page.title;
      const course = document.createElement('small');
      course.textContent = page.course;
      link.append(title, course);
      item.append(link);
      list.append(item);
    }
  };
  root.querySelector<HTMLButtonElement>('[data-clear-history]')!.onclick =
    () => {
      clearReadingHistory();
      render();
      document.querySelector<HTMLElement>('#hero-title')?.focus();
    };
  window.addEventListener('pageshow', render);
  window.addEventListener('storage', render);
  render();
</script>
<style is:global>
  .reading-history {
    margin-block: 36px;
  }
  .history-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .history-heading h2 {
    margin: 0;
    font-size: 22px;
  }
  .history-heading button {
    background: none;
    border: 0;
    padding: 8px 0 8px 8px;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .history-heading button:hover {
    color: var(--accent);
  }
  .history-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .reading-resume {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 24px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
  }
  .reading-resume:hover {
    border-color: var(--accent);
  }
  .reading-resume > svg {
    flex-shrink: 0;
    color: var(--accent);
  }
  .reading-resume > svg:last-child {
    margin-left: auto;
  }
  .reading-resume span {
    display: grid;
    gap: 6px;
  }
  .reading-resume strong {
    font-size: 19px;
  }
  .reading-resume small,
  .reading-resume span > span {
    font-size: 13px;
    color: var(--muted);
  }
  .reading-recent h3 {
    margin: 0 0 8px;
    font-size: 14px;
  }
  .reading-recent ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .reading-recent li + li {
    border-top: 1px solid var(--line);
  }
  .reading-recent a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    justify-content: space-between;
    padding: 8px 0;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
  }
  .reading-recent a:hover {
    color: var(--accent);
  }
  .reading-recent small {
    color: var(--muted);
    text-align: right;
    font-size: 12px;
  }
  @media (max-width: 700px) {
    .history-columns {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .reading-resume {
      padding: 20px;
    }
    .history-heading h2 {
      font-size: 20px;
    }
    .reading-recent a {
      display: grid;
      gap: 2px;
    }
    .reading-recent small {
      text-align: left;
    }
  }
</style>
