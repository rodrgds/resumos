---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
}
const sections = Astro.props.headings.filter(({ depth }) => depth === 2);
---

{sections.length > 0 && (
  <nav class="section-progress" aria-label="Progresso por secção">
    <a
      href="#conteudo"
      title="Introdução"
      aria-label="Introdução"
      style="--section-progress: 0"
    ></a>
    {sections.map(({ slug, text }) => (
      <a
        href={`#${slug}`}
        title={text}
        aria-label={text}
        style="--section-progress: 0"
      ></a>
    ))}
  </nav>
)}
<script>
  import '../scripts/section-progress';
</script>
