---
import {
  lessonPath,
  type CourseGuide,
  type Lesson,
} from '../lib/course-content';
interface Props {
  course: CourseGuide;
  entry?: Lesson;
}
const { course, entry } = Astro.props;
const overview = !entry || entry === course.introduction;
const practices = overview
  ? course.exercises
  : course.exercises.filter((page) => entry.data.practices.includes(page.id));
---

{(overview || practices.length > 0) && (
  <aside
    class="study-links"
    aria-label="Estudar e praticar"
    data-pagefind-ignore
  >
    {overview && (
      <p class="coverage-statement">
        {course.introduction?.data.editorial?.coverage ||
          'Estão disponíveis os temas listados no menu. A cobertura do programa completo ainda não foi verificada.'}
      </p>
    )}
    {practices.length > 0 && (
      <div>
        <h2>{overview ? 'Exercícios' : 'Praticar este tema'}</h2>
        <ul>
          {practices.map((page) => (
            <li>
              <a href={lessonPath(course, page)}>{page.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {overview && course.revisions.length > 0 && (
      <div>
        <h2>Rever</h2>
        <ul>
          {course.revisions.map((page) => (
            <li>
              <a href={lessonPath(course, page)}>{page.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
    {overview &&
      (course.revisions.length > 0 || course.exercises.length > 0) && (
        <a href={`${course.path}imprimir/`}>Preparar caderno para impressão</a>
      )}
  </aside>
)}
