---
import Icon from './Icon.astro';
import Notebook from './Notebook.astro';
import PersonalNoteMenu from './PersonalNoteMenu.astro';
import FormulaCopy from './FormulaCopy.astro';
import Appearance from './Appearance.astro';
---

<Appearance />
<dialog
  id="global-search"
  class="search-dialog"
  aria-labelledby="search-title"
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="search-title">Pesquisar</h2>
    <button class="icon-button" data-close aria-label="Fechar pesquisa">
      <Icon name="x-mark" size={22} />
    </button>
  </div>
  <label class="global-search-field">
    <Icon name="magnifying-glass" size={22} />
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      placeholder="Cadeiras, apontamentos, núcleos…"
      aria-label="Pesquisar em todo o site"
    />
  </label>
  <p id="search-status" class="tool-status" role="status">
    Escreve para pesquisar em todo o site.
  </p>
  <ul id="search-results" class="search-results"></ul>
  <p class="tool-hint">
    <Icon name="arrow-up" size={14} />
    <Icon name="arrow-down" size={14} /> para escolher · Enter para abrir · Esc
    para fechar
  </p>
</dialog>
<Notebook />
<FormulaCopy />
<PersonalNoteMenu />
<dialog
  id="vim-search"
  class="search-dialog"
  aria-labelledby="vim-search-title"
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="vim-search-title">Pesquisar nesta página</h2>
    <button
      class="icon-button"
      data-close
      aria-label="Fechar pesquisa nesta página"
    >
      <Icon name="x-mark" size={22} />
    </button>
  </div>
  <form>
    <label class="global-search-field">
      <Icon name="magnifying-glass" size={22} />
      <input
        id="vim-search-input"
        type="search"
        autocomplete="off"
        aria-label="Texto nesta página"
        aria-describedby="vim-search-status"
      />
    </label>
    <p id="vim-search-status" class="tool-status" role="status"></p>
    <button type="submit" class="vim-search-submit">
      Ir para resultado
    </button>
  </form>
  <p class="tool-hint">
    Enter procura · n / N repetem · Esc cancela. Ctrl / Cmd K pesquisa todo o
    site.
  </p>
</dialog>
<dialog
  id="shortcuts"
  class="shortcuts-dialog"
  aria-labelledby="shortcuts-title"
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="shortcuts-title">Atalhos de teclado</h2>
    <button class="icon-button" data-close aria-label="Fechar atalhos">
      <Icon name="x-mark" size={22} />
    </button>
  </div>
  <p class="tool-status">
    Clica numa tecla para a mudar. Esc cancela. Backspace desativa.
  </p>
  <label class="check-row">
    <input type="checkbox" id="single-keys" checked /> Ativar atalhos de uma
    tecla
  </label>
  <div id="shortcut-list"></div>
  <div class="shortcut-row">
    <span>Pesquisar</span>
    <kbd>Ctrl / Cmd K</kbd>
  </div>
  <label class="check-row">
    <input type="checkbox" id="vim-keys" /> Navegação Vim
  </label>
  <p class="tool-hint">
    Os atalhos não interferem enquanto escreves. Tab e Enter funcionam sempre.
  </p>
  <p id="shortcut-status" class="tool-status" role="status"></p>
  <button class="reset-button" id="reset-shortcuts">
    Repor atalhos
  </button>
</dialog>
<script src="../scripts/study-tools.ts"></script>
