---
import { X, Search, Download } from '@lucide/astro';
import Appearance from './Appearance.astro';
import AiMenu from './AiMenu.astro';
---

<Appearance />
<AiMenu />
<dialog
  id="global-search"
  class="search-dialog"
  aria-labelledby="search-title"
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="search-title">Pesquisar</h2>
    <button class="icon-button" data-close aria-label="Fechar pesquisa">
      <X size={22} />
    </button>
  </div>
  <label class="global-search-field">
    <Search size={22} />
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      placeholder="Cadeiras, apontamentos, núcleos…"
      aria-label="Pesquisar em todo o site"
    />
  </label>
  <p id="search-status" class="tool-status" role="status">
    Escreve para pesquisar em todo o site.
  </p>
  <ul id="search-results" class="search-results"></ul>
  <p class="tool-hint">
    ↑ ↓ para escolher · Enter para abrir · Esc para fechar
  </p>
</dialog>
<aside
  id="scratchpad"
  class="scratchpad"
  aria-labelledby="notes-title"
  hidden
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="notes-title">Bloco de notas</h2>
    <button
      class="icon-button"
      id="close-notes"
      aria-label="Fechar bloco de notas"
    >
      <X size={22} />
    </button>
  </div>
  <p class="tool-status">
    Só neste navegador. Guarda uma cópia para não perderes as notas.
  </p>
  <label class="sr-only" for="notes-input">
    As tuas notas
  </label>
  <textarea
    id="notes-input"
    placeholder="Escreve aqui. Podes continuar a ler ao lado."
    spellcheck="true"
  ></textarea>
  <div class="notes-footer">
    <span id="notes-status" role="status">
      Guardado neste navegador
    </span>
    <button
      class="icon-button"
      id="download-notes"
      aria-label="Descarregar notas"
    >
      <Download size={20} />
    </button>
  </div>
</aside>
<dialog
  id="shortcuts"
  class="shortcuts-dialog"
  aria-labelledby="shortcuts-title"
  data-pagefind-ignore
>
  <div class="dialog-header">
    <h2 id="shortcuts-title">Atalhos de teclado</h2>
    <button class="icon-button" data-close aria-label="Fechar atalhos">
      <X size={22} />
    </button>
  </div>
  <p class="tool-status">
    Clica numa tecla para a mudar. Esc cancela. Backspace desativa.
  </p>
  <label class="check-row">
    <input type="checkbox" id="single-keys" checked /> Ativar atalhos de uma
    tecla
  </label>
  <div id="shortcut-list"></div>
  <div class="shortcut-row">
    <span>Pesquisar</span>
    <kbd>Ctrl / ⌘ K</kbd>
  </div>
  <label class="check-row">
    <input type="checkbox" id="vim-keys" /> Navegar nos cartões com h, j, k, l
  </label>
  <p class="tool-hint">
    Os atalhos não interferem enquanto escreves. Tab e Enter funcionam sempre.
  </p>
  <p id="shortcut-status" class="tool-status" role="status"></p>
  <button class="reset-button" id="reset-shortcuts">
    Repor atalhos
  </button>
</dialog>
<script src="../scripts/study-tools.ts"></script>
