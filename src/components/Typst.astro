---
import { themeDiagram } from '../lib/diagram-theme';
import { renderTypst } from '../lib/typst';
type Props = { source: string } & (
  { format?: 'html'; alt?: never } | { format: 'svg'; alt: string }
);
const { source, format = 'html', alt } = Astro.props;
const html = renderTypst(source, format);
---

<div
  class:list={['typst-content', { 'typst-figure': format === 'svg' }]}
  role={format === 'svg' ? 'img' : undefined}
  aria-label={alt}
  set:html={format === 'svg' ? themeDiagram(html) : html}
/>
<style>
  .typst-content {
    overflow-x: auto;
  }
  .typst-figure {
    background: var(--surface);
    color: var(--text);
    border-radius: 8px;
    padding: 16px;
  }
  .typst-figure :global(svg) {
    display: block;
    margin-inline: auto;
    fill: var(--text);
    max-width: 100%;
    height: auto;
  }
</style>
