---
import Icon from './Icon.astro';
import '../styles/playground.css';
interface Props {
  html: string;
  css?: string;
  js?: string;
}
const { html, css = '', js = '' } = Astro.props;
---

<section
  data-annotation-ignore
  class="web-playground"
  data-web-playground
  aria-label="Experimentar HTML, CSS e JavaScript"
>
  <div class="playground-toolbar" data-pagefind-ignore>
    <strong>HTML / CSS / JavaScript</strong>
    <div>
      <button data-web-reset aria-label="Repor exemplo web">
        <Icon name="arrow-path" size={15} />
      </button>
      <button data-web-run>
        <Icon name="play" size={15} /> Pré-visualizar
      </button>
    </div>
  </div>
  <div class="web-editors">
    <div>
      <span>HTML</span>
      <textarea
        data-html
        aria-label="HTML"
        rows="4"
        spellcheck="false"
      >{html}</textarea>
    </div>
    <details>
      <summary class="icon-disclosure">
        CSS e JavaScript
        <Icon name="chevron-down" size={16} />
      </summary>
      <div>
        <span>CSS</span>
        <textarea
          data-css
          aria-label="CSS"
          rows="4"
          spellcheck="false"
        >{css}</textarea>
      </div>
      <div>
        <span>JavaScript</span>
        <textarea
          data-js
          aria-label="JavaScript"
          rows="4"
          spellcheck="false"
        >{js}</textarea>
      </div>
    </details>
  </div>
  <template data-fold-open>
    <Icon name="chevron-down" size={14} />
  </template>
  <template data-fold-closed>
    <Icon name="chevron-right" size={14} />
  </template>
  <iframe
    title="Pré-visualização do exemplo web"
    sandbox="allow-scripts"
    referrerpolicy="no-referrer"
    aria-busy="true"
    hidden
  ></iframe>
  <p
    data-web-status
    class="web-preview-status"
    role="status"
    aria-live="polite"
  >
    A preparar a pré-visualização…
  </p>
</section>
<script>
  import { EditorView } from '@codemirror/view';
  import { html as htmlLanguage } from '@codemirror/lang-html';
  import { css as cssLanguage } from '@codemirror/lang-css';
  import { javascript } from '@codemirror/lang-javascript';
  import { editorSetup } from '../lib/editor-setup';

  document
    .querySelectorAll<HTMLElement>('[data-web-playground]')
    .forEach((root) => {
      const html = root.querySelector<HTMLTextAreaElement>('[data-html]')!;
      const css = root.querySelector<HTMLTextAreaElement>('[data-css]')!;
      const js = root.querySelector<HTMLTextAreaElement>('[data-js]')!;
      let frame = root.querySelector('iframe')!;
      const status = root.querySelector<HTMLElement>('[data-web-status]')!;
      const controls = [
        root.querySelector<HTMLButtonElement>('[data-web-run]')!,
        root.querySelector<HTMLButtonElement>('[data-web-reset]')!,
      ];
      const original = [html.value, css.value, js.value];
      const languages = [htmlLanguage(), cssLanguage(), javascript()];
      const editors = [html, css, js].map((source, index) => {
        const editor = new EditorView({
          doc: original[index],
          parent: source.parentElement!,
          extensions: [
            editorSetup(root),
            languages[index],
            EditorView.lineWrapping,
            EditorView.contentAttributes.of({
              'aria-label': source.getAttribute('aria-label')!,
              spellcheck: 'false',
            }),
          ],
        });
        source.remove();
        return editor;
      });
      const render = () => {
        controls[0].disabled = true;
        const nextFrame = document.createElement('iframe');
        nextFrame.title = frame.title;
        nextFrame.setAttribute(
          'sandbox',
          frame.getAttribute('sandbox') ?? 'allow-scripts',
        );
        nextFrame.setAttribute(
          'referrerpolicy',
          frame.getAttribute('referrerpolicy') ?? 'no-referrer',
        );
        nextFrame.hidden = true;
        nextFrame.setAttribute('aria-busy', 'true');
        // Completion must not depend on editable HTML executing a sentinel script.
        nextFrame.addEventListener(
          'load',
          () => {
            if (frame !== nextFrame) return;
            frame.hidden = false;
            frame.removeAttribute('aria-busy');
            frame.dataset.webReady = 'true';
            status.hidden = true;
            controls[0].disabled = false;
          },
          { once: true },
        );
        status.hidden = false;
        status.textContent = 'A atualizar a pré-visualização…';
        const [htmlCode, cssCode, jsCode] = editors.map((editor) =>
          editor.state.doc.toString(),
        );
        // Opaque origin, no parent/storage access, no network or form submissions.
        nextFrame.srcdoc = `<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; form-action 'none'; base-uri 'none'"><style>body{font-family:system-ui;padding:16px}${cssCode}</style></head><body>${htmlCode}<script>${jsCode}<\/script></body></html>`;
        frame.replaceWith(nextFrame);
        frame = nextFrame;
      };
      controls[0].onclick = render;
      controls[1].onclick = () => {
        editors.forEach((editor, index) =>
          editor.dispatch({
            changes: {
              from: 0,
              to: editor.state.doc.length,
              insert: original[index],
            },
          }),
        );
        render();
      };
      root.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
          event.preventDefault();
          render();
        }
      });
      window.addEventListener(
        'pagehide',
        () => editors.forEach((editor) => editor.destroy()),
        { once: true },
      );
      render();
    });
</script>
