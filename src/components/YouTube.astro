---
import Icon from './Icon.astro';
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
if (!/^[a-zA-Z0-9_-]{11}$/.test(id))
  throw new Error('Invalid YouTube video ID');
---

<div class="video-embed" data-video={id} data-title={title}>
  <button class="video-load" aria-label={`Carregar vídeo: ${title}`}>
    <img
      class="video-thumbnail"
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
    />
    <Icon name="play" size={36} />
    <strong>{title}</strong>
    <span>Carregar vídeo do YouTube</span>
  </button>
</div>
<p class="video-caption">
  A miniatura vem do YouTube. O vídeo só carrega quando clicas.{' '}
  <a href={`https://www.youtube.com/watch?v=${id}`}>Abrir no YouTube</a>
</p>
<script>
  for (const container of document.querySelectorAll<HTMLElement>(
    '[data-video]',
  )) {
    container.querySelector('button')!.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${container.dataset.video}?autoplay=1`;
      frame.title = container.dataset.title!;
      frame.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      container.replaceChildren(frame);
    });
  }
</script>
