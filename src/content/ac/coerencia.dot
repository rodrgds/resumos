digraph Coerencia {
  rankdir=TB;
  node [shape=box, style=rounded];
  a [label="Inicial\nN1:(5,8) limpa; N2:(5,8) limpa\nRAM:(5,8)"];
  b [label="N1 escreve X=9\nN1:(9,8) dirty; N2:inválida\nRAM:(5,8)"];
  c [label="N2 lê Y\nN1 fornece linha e atualiza RAM\nN1,N2,RAM:(9,8); leitura devolve8"];
  a -> b [label="invalidação de toda a linha"];
  b -> c [label="falta por falsa partilha\nY não foi alterado"];
}
