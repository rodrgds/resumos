digraph Contador {
  rankdir=LR;
  node [shape=circle];
  n00 [label="00\nnão tomado"];
  n01 [label="01\nnão tomado\nfraco"];
  n10 [label="10\ntomado\nfraco"];
  n11 [label="11\ntomado forte"];
  n00 -> n01 [label="T"];
  n00 -> n00 [label="N"];
  n01 -> n10 [label="T"];
  n01 -> n00 [label="N"];
  n10 -> n11 [label="T"];
  n10 -> n01 [label="N"];
  n11 -> n11 [label="T"];
  n11 -> n10 [label="N"];
}
