digraph Datapath {
  rankdir=TB;
  node [shape=box, style=rounded];
  { rank=same; regs; imm; ctrl; }
  { rank=same; mem; next; }
  pc [label="PC"];
  inst [label="Memória I\ninstrução"];
  ctrl [label="Controlo por opcode/funct\nALUSrc, RegWrite, MemRead,\nMemWrite e seleção do PC", shape=note];
  regs [label="Banco de registos\nrs1,rs2 → dados"];
  imm [label="Gerador de imediato\nextensão de sinal"];
  alu [label="ALU\noperação / endereço"];
  mem [label="Memória D\nload / store"];
  mux [label="Selecionar retorno\nALU ou memória"];
  next [label="PC seguinte\nPC+4 ou alvo"];
  pc -> inst; inst -> regs [label="rs1,rs2,rd"];
  inst -> ctrl; inst -> imm;
  regs -> alu; imm -> alu [label="ALUSrc"];
  alu -> mem [label="endereço"]; regs -> mem [label="dado store"];
  alu -> mux; mem -> mux [label="dado load"];
  mux -> regs [label="rd,RegWrite", constraint=false];
  alu -> next [label="igualdade"]; pc -> next [label="PC"];
  imm -> next [label="deslocamento"];
  next -> pc [constraint=false];
}
