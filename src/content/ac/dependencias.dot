digraph Dependencias {
  rankdir=LR;
  node [shape=box, style=rounded];
  i1 [label="1: add t0, t1, t2"];
  i2 [label="2: sub t3, t0, t4"];
  i3 [label="3: add t3, t5, t6"];
  i4 [label="4: sub t0, t7, t8"];
  i1 -> i2 [label="RAW em t0", style=bold];
  i2 -> i3 [label="WAR em t3", style=dashed];
  i1 -> i4 [label="WAW em t0", style=dashed];
}
