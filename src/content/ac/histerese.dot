digraph Histerese {
  rankdir=LR;
  node [shape=circle];
  n00 [label="00\nprevê N\nforte"];
  n01 [label="01\nprevê N\nfraco"];
  n10 [label="10\nprevê T\nfraco"];
  n11 [label="11\nprevê T\nforte"];
  n00 -> n00 [label="N"];
  n00 -> n01 [label="T"];
  n01 -> n00 [label="N"];
  n01 -> n11 [label="T"];
  n11 -> n11 [label="T"];
  n11 -> n10 [label="N"];
  n10 -> n11 [label="T"];
  n10 -> n00 [label="N"];
}
