digraph Tomasulo {
  rankdir=TB;
  node [shape=box, style=rounded];
  issue [label="Emitir por ordem\ncapturar origens; renomear Qi"];
  rs [label="Estações de reserva\nOp, Vj/Vk, Qj/Qk"];
  unit [label="Unidades funcionais\noperandos prontos + unidade livre"];
  cdb [label="CDB: uma etiqueta e um valor\num resultado por ciclo"];
  regs [label="Registos\nescrever só se Qi = etiqueta"];
  issue -> rs;
  rs -> unit [label="Qj = Qk = 0"];
  unit -> cdb;
  cdb -> regs;
  cdb -> rs [label="Q igual:\nreceber V", style=dashed, constraint=false];
}
