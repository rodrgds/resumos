---
interface Props {
  caption: string;
  steps: { label: string; values: string[]; note: string }[];
}
const { caption, steps } = Astro.props;
---

<figure class="states">
  <ol>
    {steps.map((step) => (
      <li>
        <strong>{step.label}</strong>
        <div class="values">
          {step.values.map((value) => (
            <code>{value}</code>
          ))}
        </div>
        <span>{step.note}</span>
      </li>
    ))}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .states {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--text);
  }
  .states ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .states li {
    display: grid;
    gap: 0.4rem;
    margin: 0;
  }
  .values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .values code {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-bottom: 2px solid var(--accent);
    border-radius: 0.25rem;
    font-size: 0.9em;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  figcaption {
    margin-top: 1rem;
    color: var(--muted);
  }
</style>
