digraph Lista {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b"];
  cabeca [label="cabeça"];
  n1 [label="valor\nprox"];
  n2 [label="valor\nprox"];
  n3 [label="valor\nprox"];
  cabeca -> n1 -> n2 -> n3;
  n3 -> livre [label="cauda", style=dashed];
  livre [label="∅", shape=circle];
}
