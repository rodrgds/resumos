---
import InteractiveDemo from '../../components/InteractiveDemo.astro';
---

<InteractiveDemo label="Transformar o quadrado unitário">
  <section
    class="matrix-transform"
    data-matrix-transform
    data-annotation-ignore
  >
    <fieldset>
      <legend>Matriz A, por linhas</legend>
      <div class="matrix-inputs">
        <label>
          a{' '}
          <input
            data-entry="a"
            aria-label="a, linha 1 e coluna 1"
            type="number"
            step="1"
            min="-8"
            max="8"
            value="2"
          />
        </label>
        <label>
          b{' '}
          <input
            data-entry="b"
            aria-label="b, linha 1 e coluna 2"
            type="number"
            step="1"
            min="-8"
            max="8"
            value="1"
          />
        </label>
        <label>
          c{' '}
          <input
            data-entry="c"
            aria-label="c, linha 2 e coluna 1"
            type="number"
            step="1"
            min="-8"
            max="8"
            value="0"
          />
        </label>
        <label>
          d{' '}
          <input
            data-entry="d"
            aria-label="d, linha 2 e coluna 2"
            type="number"
            step="1"
            min="-8"
            max="8"
            value="3"
          />
        </label>
      </div>
    </fieldset>
    <button type="button">Repor matriz</button>
    <p data-result role="status" aria-live="polite">
      det(A) = 6; área = 6. A orientação mantém-se.
    </p>
    <svg
      viewBox="-4 -4 8 8"
      role="img"
      aria-label="Quadrado unitário tracejado e paralelogramo transformado"
    >
      <line class="axis" data-line="x-axis" x1="-4" y1="0" x2="4" y2="0"></line>
      <line class="axis" data-line="y-axis" x1="0" y1="-4" x2="0" y2="4"></line>
      <polygon class="original" points="0,0 1,0 1,-1 0,-1"></polygon>
      <polygon class="image" data-image points="0,0 2,0 3,-3 1,-3"></polygon>
      <line class="first" data-line="first" x1="0" y1="0" x2="2" y2="0"></line>
      <line
        class="second"
        data-line="second"
        x1="0"
        y1="0"
        x2="1"
        y2="-3"
      ></line>
    </svg>
    <p data-columns>
      A e1 = (2, 0); A e2 = (1, 3). O quadrado tracejado tem área 1.
    </p>
    <noscript>
      Ativa o JavaScript para alterar a matriz. O exemplo fixo acima mostra a
      matriz inicial.
    </noscript>
  </section>
</InteractiveDemo>
<script>
  import { initializeTransform } from './transformacao.js';
  document
    .querySelectorAll<HTMLElement>('[data-matrix-transform]')
    .forEach(initializeTransform);
</script>
<style>
  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 16px;
  }
  legend {
    margin-bottom: 12px;
    font-weight: 600;
  }
  .matrix-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    max-width: 300px;
  }
  label {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  input {
    width: 100%;
    min-width: 0;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--text);
    background: var(--page);
    font: inherit;
  }
  button {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--page);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  p {
    margin: 16px 0 0;
    line-height: 1.5;
  }
  svg {
    display: block;
    width: 100%;
    max-height: 360px;
    margin-top: 16px;
  }
  line,
  polygon {
    stroke-width: 0.04;
  }
  .axis {
    stroke: var(--line);
  }
  .original {
    fill: none;
    stroke: var(--muted);
    stroke-dasharray: 0.12 0.08;
  }
  .image {
    fill: color-mix(in srgb, var(--accent) 14%, transparent);
    stroke: var(--accent);
  }
  .first {
    stroke: var(--accent);
  }
  .second {
    stroke: var(--text);
    stroke-dasharray: 0.12 0.08;
  }
</style>
