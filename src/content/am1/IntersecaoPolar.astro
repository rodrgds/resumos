---
const point = (theta: number) => {
  const r = Math.min(1, 2 * Math.cos(theta));
  return `${150 + 105 * r * Math.cos(theta)},${155 - 105 * r * Math.sin(theta)}`;
};
const boundary = Array.from({ length: 181 }, (_, i) =>
  point(-Math.PI / 2 + (Math.PI * i) / 180),
);
---

<figure>
  <svg
    viewBox="0 0 440 310"
    role="img"
    aria-label="Interseção sombreada dos discos de raio um com centros em zero e um. Os raios a mais e menos pi sobre três dividem as duas fronteiras da interseção."
  >
    <path d={`M150,155 L${boundary.join(' L')} Z`} class="region" />
    <path d="M30 155 H400 M150 28 V282" class="axis" />
    <circle cx="150" cy="155" r="105" class="unit" />
    <circle cx="255" cy="155" r="105" class="shifted" />
    <path d="M150 155 L202.5 64.07 M150 155 L202.5 245.93" class="ray" />
    <circle cx="202.5" cy="64.07" r="4" class="point" />
    <circle cx="202.5" cy="245.93" r="4" class="point" />
    <text x="215" y="40">
      θ = π/3
    </text>
    <text x="215" y="295">
      θ = −π/3
    </text>
    <text x="132" y="178">
      0
    </text>
    <text x="268" y="178">
      1
    </text>
    <text x="375" y="178">
      2
    </text>
    <text x="402" y="151">
      x
    </text>
    <text x="157" y="27">
      y
    </text>
  </svg>
  <figcaption>
    Contínuo: r = 1. Tracejado: r = 2 cos θ. A região sombreada usa o menor dos
    dois raios em cada direção, entre −π/2 e π/2.
  </figcaption>
</figure>

<style>
  figure {
    margin: 1.5rem 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--text);
  }
  path,
  circle {
    vector-effect: non-scaling-stroke;
  }
  .region {
    fill: var(--accent);
    fill-opacity: 0.2;
    stroke: none;
  }
  .axis {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1;
  }
  .unit,
  .shifted {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
  }
  .shifted {
    stroke-dasharray: 7 5;
  }
  .ray {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .point {
    fill: var(--accent);
  }
  text {
    fill: currentColor;
    font-size: 20px;
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9em;
  }
</style>
