---
import InteractiveDemo from '../../components/InteractiveDemo.astro';
const curve = Array.from({ length: 101 }, (_, i) => {
  const x = i / 100;
  return `${i ? 'L' : 'M'}${40 + 460 * x},${280 - 240 * x * x}`;
}).join(' ');
const initial = Array.from({ length: 8 }, (_, i) => ({
  x: 40 + (460 * i) / 8,
  h: 240 * ((i + 1) / 8) ** 2,
}));
---

<InteractiveDemo label="Somas de Riemann de x ao quadrado entre zero e um">
  <div data-am1-riemann>
    <label>
      Número de intervalos n
      <input type="range" min="2" max="80" step="1" value="8" data-count />
    </label>
    <fieldset>
      <legend>Ponto de cada retângulo</legend>
      <label>
        <input type="radio" name="am1-riemann-point" value="left" /> Esquerda
      </label>
      <label>
        <input type="radio" name="am1-riemann-point" value="mid" /> Meio
      </label>
      <label>
        <input type="radio" name="am1-riemann-point" value="right" checked />{' '}
        Direita
      </label>
    </fieldset>
    <output aria-live="polite">n = 8; soma = 0,398438; integral = 1/3.</output>
    <svg
      viewBox="0 0 540 315"
      role="img"
      aria-label="Oito retângulos direitos aproximam a área sob x ao quadrado em zero a um"
    >
      <g data-rectangles>
        {initial.map(({ x, h }) => (
          <rect x={x} y={280 - h} width={460 / 8} height={h} />
        ))}
      </g>
      <path d="M40 20 V280 H515" class="axis" />
      <path d={curve} class="curve" />
      <text x="32" y="305">
        0
      </text>
      <text x="495" y="305">
        1
      </text>
      <text x="18" y="43">
        1
      </text>
      <text x="375" y="34">
        y = x²
      </text>
    </svg>
  </div>
</InteractiveDemo>
<style>
  label:has([data-count]) {
    display: grid;
    gap: 8px;
  }
  [data-count] {
    width: 100%;
  }
  input {
    accent-color: var(--accent);
  }
  fieldset {
    margin: 12px 0;
    padding: 0;
    border: 0;
    display: flex;
    gap: 8px 20px;
    flex-wrap: wrap;
  }
  legend {
    margin-bottom: 6px;
  }
  fieldset label {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  output {
    display: block;
    margin-block: 12px;
    font-variant-numeric: tabular-nums;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--text);
  }
  [data-rectangles] :global(rect) {
    fill: var(--accent);
    fill-opacity: 0.15;
    stroke: var(--accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .axis {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.5;
  }
  .curve {
    stroke: currentColor;
    stroke-width: 2;
  }
  text {
    fill: currentColor;
    font-size: 17px;
  }
</style>
<script>
  for (const demo of document.querySelectorAll<HTMLElement>(
    '[data-am1-riemann]',
  )) {
    const count = demo.querySelector<HTMLInputElement>('[data-count]')!;
    const rectangles = demo.querySelector('[data-rectangles]')!;
    const output = demo.querySelector('output')!;
    const graph = demo.querySelector('svg')!;
    const number = new Intl.NumberFormat('pt-PT', {
      minimumFractionDigits: 6,
      maximumFractionDigits: 6,
    });
    const update = () => {
      const n = Number(count.value);
      const method = demo.querySelector<HTMLInputElement>(
        'input[type=radio]:checked',
      )!.value;
      const offset = method === 'left' ? 0 : method === 'mid' ? 0.5 : 1;
      let sum = 0;
      rectangles.replaceChildren();
      for (let i = 0; i < n; i++) {
        const height = ((i + offset) / n) ** 2;
        sum += height / n;
        const rect = document.createElementNS(
          'http://www.w3.org/2000/svg',
          'rect',
        );
        for (const [key, value] of Object.entries({
          x: 40 + (460 * i) / n,
          y: 280 - 240 * height,
          width: 460 / n,
          height: 240 * height,
        })) {
          rect.setAttribute(key, String(value));
        }
        rectangles.append(rect);
      }
      output.textContent = `n = ${n}; soma = ${number.format(sum)}; integral = 1/3.`;
      graph.setAttribute(
        'aria-label',
        `${n} retângulos pelo ponto ${method === 'left' ? 'esquerdo' : method === 'mid' ? 'médio' : 'direito'}. Soma ${number.format(sum)}, área exata um terço.`,
      );
    };
    demo.addEventListener('input', update);
    update();
  }
</script>
