<div class="gradient-demo" data-gradient-demo>
  <svg
    viewBox="0 0 420 370"
    role="img"
    aria-label="Elipse de nível e setas do gradiente e da direção escolhida no ponto (1, 1)"
  >
    <defs>
      <marker
        id="am2-gradient-arrow"
        markerWidth="7"
        markerHeight="7"
        refX="6"
        refY="3.5"
        orient="auto"
      >
        <path d="M0 0 L7 3.5 L0 7 Z" fill="currentColor" />
      </marker>
    </defs>
    <line x1="25" y1="255" x2="395" y2="255" class="axis" />
    <line x1="180" y1="290" x2="180" y2="20" class="axis" />
    <ellipse cx="180" cy="255" rx="121.24" ry="85.73" class="level" />
    <text x="363" y="277">
      x
    </text>
    <text x="163" y="30">
      y
    </text>
    <text x="27" y="150">
      q = 3
    </text>
    <line
      x1="250"
      y1="185"
      x2="292"
      y2="101"
      class="gradient"
      marker-end="url(#am2-gradient-arrow)"
    />
    <text x="296" y="96">
      ∇q = (2, 4)
    </text>
    <line
      x1="250"
      y1="185"
      x2="320"
      y2="185"
      class="direction"
      data-direction
      marker-end="url(#am2-gradient-arrow)"
    />
    <text x="326" y="189" data-direction-label>
      u
    </text>
    <circle cx="250" cy="185" r="4" class="point" />
    <text x="258" y="207">
      (1, 1)
    </text>
  </svg>
  <label>
    Ângulo θ{' '}
    <input type="range" min="0" max="360" value="0" step="1" data-angle />{' '}
    <output data-angle-value>0°</output>
  </label>
  <p>
    Direção unitária u = <span data-unit>(1,000; 0,000)</span>
  </p>
  <p>
    Derivada direcional: <strong data-rate>2,000</strong>. Máximo: √20 ≈ 4,472.
  </p>
  <noscript>
    Em θ = 0°, a direção é (1, 0) e a derivada direcional é 2.
  </noscript>
</div>

<style>
  .gradient-demo svg {
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--text);
  }
  .axis {
    stroke: var(--muted);
    stroke-width: 1;
  }
  .level {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }
  .gradient {
    stroke: var(--text);
    stroke-width: 2.5;
  }
  .direction {
    stroke: var(--accent);
    stroke-width: 3;
  }
  .point {
    fill: var(--text);
  }
  text {
    fill: var(--text);
    font-size: 14px;
  }
  label {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  input {
    flex: 1;
    min-width: 120px;
    accent-color: var(--accent);
  }
  output {
    min-width: 4ch;
  }
  p {
    margin-block: 10px 0;
  }
</style>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>(
    '[data-gradient-demo]',
  )) {
    const input = demo.querySelector<HTMLInputElement>('[data-angle]');
    const direction = demo.querySelector<SVGLineElement>('[data-direction]');
    const label = demo.querySelector<SVGTextElement>('[data-direction-label]');
    const angleValue = demo.querySelector('[data-angle-value]');
    const unit = demo.querySelector('[data-unit]');
    const rate = demo.querySelector('[data-rate]');
    if (!input || !direction || !label || !angleValue || !unit || !rate)
      continue;
    const format = (value: number) =>
      (Math.abs(value) < 0.0005 ? 0 : value).toFixed(3).replace('.', ',');
    const update = () => {
      const radians = (Number(input.value) * Math.PI) / 180;
      const x = Math.cos(radians);
      const y = Math.sin(radians);
      direction.setAttribute('x2', String(250 + 70 * x));
      direction.setAttribute('y2', String(185 - 70 * y));
      label.setAttribute('x', String(258 + 90 * x));
      label.setAttribute('y', String(177 - 90 * y));
      angleValue.textContent = `${input.value}°`;
      unit.textContent = `(${format(x)}; ${format(y)})`;
      rate.textContent = format(2 * x + 4 * y);
    };
    input.addEventListener('input', update);
    update();
  }
</script>
