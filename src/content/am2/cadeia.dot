digraph Cadeia {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2, labelloc=b];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b"];
  subgraph cluster_curva {
    label="z(t) ao longo de uma curva";
    t -> x; t -> y; x -> z; y -> z;
  }
  subgraph cluster_geral {
    label="w(u, v) no caso geral";
    u -> x2; u -> y2; v -> x2; v -> y2; x2 -> w; y2 -> w;
    x2 [label="x"]; y2 [label="y"];
  }
}
