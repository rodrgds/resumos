digraph Lexico {
  graph [bgcolor="transparent", rankdir=TB, pad=0.1, nodesep=0.15, ranksep=0.35];
  node [shape=circle, width=0.4, margin=0.04, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b", fontname="Arial", fontsize=11];
  q0 [label="q0"];
  id [label="q_id", shape=doublecircle];
  num [label="q_num", shape=doublecircle];
  q0 -> id [label="letra ou _"];
  q0 -> num [label="dígito"];
  id -> id [label="letra, dígito\nou _"];
  num -> num [label="dígito"];
  id -> num [style=invis];
}
