digraph Derivacao {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b"];
  E0 -> E1; E0 -> SOMA; E0 -> T1;
  E1 -> T2; T2 -> F1; F1 -> A1;
  T1 -> T3; T1 -> VEZES; T1 -> F2;
  T3 -> F3; F3 -> A2; F2 -> A3;
  SOMA [label="+"];
  VEZES [label="×"];
  A1 [label="a", shape=box];
  A2 [label="a", shape=box];
  A3 [label="a", shape=box];
}
