digraph Fluxo {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b"];
  B1 -> B2 [label="verdade"];
  B1 -> B4 [label="saída"];
  B2 -> B3 [label="verdade"];
  B2 -> B4 [label="saída"];
  B3 -> B1 [label="volta"];
  B1 [label="B1: t1 = a < b"];
  B2 [label="B2: t2 = c != 0"];
  B3 [label="B3: corpo, goto"];
  B4 [label="B4: fora"];
}
