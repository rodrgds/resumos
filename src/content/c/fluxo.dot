digraph Fluxo {
  graph [bgcolor="transparent", rankdir=TB, pad=0.1, nodesep=0.12, ranksep=0.4];
  node [shape=box, margin=0.07, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b", fontname="Arial", fontsize=11];
  B1 -> B2 [label="V"];
  B1 -> B4 [label="F"];
  B2 -> B3 [label="V"];
  B2 -> B4 [label="F"];
  B3 -> B1 [label="volta"];
  B1 [label="B1\nt1 = a < b"];
  B2 [label="B2\nt2 = c != 0"];
  B3 [label="B3\na = a + 1\ngoto B1"];
  B4 [label="B4\nfora"];
}
