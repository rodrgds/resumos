graph Interferencia {
  graph [bgcolor="transparent", pad=0.1, nodesep=0.3, ranksep=0.4];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b"];
  a -- b; a -- c; b -- c; c -- d;
  {rank=same; a; b;}
  c [shape=doublecircle, label="c"];
}
