digraph LigacoesAtivacao {
  graph [bgcolor="transparent", rankdir=TB, pad=0.1, nodesep=0.2, ranksep=0.5];
  node [shape=box, fontname="Arial", fontsize=12, margin=0.08];
  edge [fontname="Arial", fontsize=11];
  f [label="Registo de f\nlê x"];
  g [label="Registo de g\nchamou f"];
  externo [label="Registo de externo\ncontém x; declara f e g"];
  f -> g [label="dinâmica\nchamador"];
  g -> externo [label="dinâmica"];
  f -> externo [label="estática\nâmbito lexical", style=dashed];
}
