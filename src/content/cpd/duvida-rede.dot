digraph Duvida {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b"];
  Cliente -> Servidor [label="pedido"];
  Servidor -> Cliente [label="resposta"];
  Cliente -> Servidor [label="repetição após timeout", style=dashed];
  Cliente -> Duvida [style=dotted, arrowhead=none];
  Duvida [label="lento ou morto?", shape=note];
}
