digraph Resolucao {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b"];
  Resolvedor -> Raiz [label="1. quem serve .pt?"];
  Resolvedor -> TLD [label="2. quem serve exemplo.pt?"];
  Resolvedor -> Aut [label="3. endereço de www?"];
  TLD [label="Servidor .pt"];
  Aut [label="Autoritativo"];
  Resolvedor -> Resolvedor [label="4. guarda em cache (TTL)"];
}
