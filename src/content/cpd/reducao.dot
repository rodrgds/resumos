digraph Reducao {
  graph [bgcolor="transparent", rankdir=TB, pad=0.15, nodesep=0.25, ranksep=0.35];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b"];
  vetor [label="Oito uns"];
  a [label="Thread A\n4 uns\nPrivada: 4"];
  b [label="Thread B\n4 uns\nPrivada: 4"];
  total [label="Redução\n4 + 4 = 8", color="#28716c"];
  partilhado [label="Com atomic\n8 atualizações\npartilhadas", style="rounded,dashed", color="#28716c"];
  { rank=same; a; b; }
  vetor -> a;
  vetor -> b;
  a -> total;
  b -> total;
  total -> partilhado [style=invis];
}
