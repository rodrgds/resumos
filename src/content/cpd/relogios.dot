digraph Relogios {
  graph [bgcolor="transparent", rankdir=TB, pad=0.1, nodesep=0.2, ranksep=0.4];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=11];
  edge [color="#8c2d3b", fontname="Arial", fontsize=10];
  p [label="Processo P", shape=plaintext, style=""];
  q [label="Processo Q", shape=plaintext, style=""];
  e1 [label="e1 · L=1\nV=(1,0)"];
  e2 [label="e2 · L=2\nV=(2,0)"];
  e3 [label="e3 · L=5\nV=(3,3)"];
  f1 [label="f1 · L=1\nV=(0,1)"];
  f2 [label="f2 · L=3\nV=(2,2)"];
  f3 [label="f3 · L=4\nV=(2,3)"];
  p -> e1 -> e2 -> e3;
  q -> f1 -> f2 -> f3;
  { rank=same; p; q; }
  { rank=same; e1; f1; }
  { rank=same; e2; f2; }
  { rank=same; e3; f3; }
  e2 -> f2 [label="m", constraint=false, color="#28716c"];
  f3 -> e3 [label="r", constraint=false, color="#28716c"];
}
