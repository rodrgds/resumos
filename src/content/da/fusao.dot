digraph Fusao {
  node [shape=box];
  todo [label="[5, 2, 8, 1]"];
  a [label="[5, 2]"];
  b [label="[8, 1]"];
  a1 [label="[2, 5]"];
  b1 [label="[1, 8]"];
  r [label="[1, 2, 5, 8]"];
  todo -> a [label="divide"];
  todo -> b [label="divide"];
  a -> a1 [label="conquista"];
  b -> b1 [label="conquista"];
  a1 -> r [label="combina"];
  b1 -> r [label="combina"];
}
