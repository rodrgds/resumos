digraph ILP {
  graph [nodesep=0.15];
  node [shape=box];
  raiz [label="LP: (4/3, 4/3)\nlimite = 8/3"];
  direito [label="(2, 0)\nvalor 2\nincumbente inteiro"];
  esquerdo [label="LP: (1, 3/2)\nlimite = 5/2"];
  baixo [label="(1, 1)\nvalor 2\ninteiro"];
  cima [label="(0, 2)\nvalor 2\ninteiro"];
  raiz -> direito [label="x ≥ 2"];
  raiz -> esquerdo [label="x ≤ 1"];
  esquerdo -> baixo [label="y ≤ 1"];
  esquerdo -> cima [label="y ≥ 2"];
}
