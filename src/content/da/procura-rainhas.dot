digraph Procura {
  node [shape=box];
  raiz [label="coluna 1"];
  r1 [label="[1]"];
  r2 [label="[2]"];
  raiz -> r1;
  raiz -> r2;
  r13 [label="[1, 3]"];
  r14 [label="[1, 4]"];
  r1 -> r13;
  r1 -> r14;
  beco1 [label="coluna 3 sem linhas: poda por viabilidade", shape=ellipse];
  beco2 [label="coluna 4 se esgota: poda por viabilidade", shape=ellipse];
  r13 -> beco1;
  r14 -> beco2;
  r24 [label="[2, 4]"];
  r241 [label="[2, 4, 1]"];
  sol [label="[2, 4, 1, 3]: solução", shape=doubleoctagon];
  r2 -> r24;
  r24 -> r241;
  r241 -> sol;
}
