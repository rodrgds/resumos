---
const cases = [
  {
    label: 'Adjacente',
    start: 15,
    end: 16,
    result: 'Aceite: sem sobreposição',
  },
  { label: 'Parcial', start: 14.5, end: 15.5, result: 'Recusada: 14h30 a 15h' },
  {
    label: 'Contida',
    start: 14.5,
    end: 14.75,
    result: 'Recusada: 14h30 a 14h45',
  },
];
const x = (hour: number) => 100 + (hour - 14) * 190;
---

<figure>
  <div
    class="scroll"
    tabindex="0"
    role="region"
    aria-label="Comparar intervalos de reserva"
  >
    <svg
      viewBox="0 0 510 405"
      role="img"
      aria-labelledby="es-interval-title es-interval-desc"
    >
      <title id="es-interval-title">Adjacência e sobreposição de reservas</title>
      <desc id="es-interval-desc">
        A reserva existente ocupa das 14h às 15h, excluindo o fim. O pedido das
        15h às 16h é adjacente e aceite. Os pedidos das 14h30 às 15h30 e das
        14h30 às 14h45 sobrepõem-se e são recusados.
      </desc>
      {cases.map((item, index) => {
        const y = 42 + index * 125;
        return (
          <g>
            <text x="10" y={y - 16} class="heading">
              {item.label}
            </text>
            <text x="10" y={y + 8}>
              Existente
            </text>
            <text x="10" y={y + 40}>
              Pedido
            </text>
            <path class="existing" d={`M${x(14)} ${y}H${x(15)}`} />
            <circle class="included" cx={x(14)} cy={y} r="5" />
            <circle class="excluded" cx={x(15)} cy={y} r="5" />
            <path
              class="request"
              d={`M${x(item.start)} ${y + 32}H${x(item.end)}`}
            />
            <circle class="included" cx={x(item.start)} cy={y + 32} r="5" />
            <circle class="excluded" cx={x(item.end)} cy={y + 32} r="5" />
            {[14, 15, 16].map((hour) => (
              <text x={x(hour)} y={y + 58} text-anchor="middle">
                {hour}h
              </text>
            ))}
            <text x="100" y={y + 80}>
              {item.result}
            </text>
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>
    As três comparações usam a mesma escala. Círculo cheio inclui o instante;
    círculo aberto exclui-o.
  </figcaption>
</figure>
<style>
  figure {
    margin: 24px 0;
  }
  .scroll {
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 510px;
    height: auto;
    color: var(--text);
  }
  text {
    fill: currentColor;
    font:
      15px 'Manrope Variable',
      sans-serif;
  }
  .heading {
    font-weight: 700;
  }
  path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
  }
  .request {
    stroke-dasharray: 6 3;
  }
  circle {
    stroke: currentColor;
    stroke-width: 2;
  }
  .included {
    fill: currentColor;
  }
  .excluded {
    fill: var(--surface);
  }
  figcaption {
    color: var(--muted);
    font-size: 14px;
    margin-top: 10px;
  }
</style>
