digraph atividade_reserva {
  graph [rankdir=TB, bgcolor="transparent", pad=0.05, nodesep=0.16, ranksep=0.28];
  node [shape=box, fontname="sans-serif", fontsize=12, margin="0.07,0.04"];
  edge [fontname="sans-serif", fontsize=11, arrowsize=0.7];
  pedido [label="Receber pedido"];
  verificar [label="Verificar\ndisponibilidade"];
  decisao [shape=diamond, label="Livre?"];
  confirmar [label="Confirmar"];
  recusar [label="Recusar"];
  fork [shape=rect, label="", xlabel="fork", style=filled, fillcolor="black", width=1.2, height=0.05, fixedsize=true];
  lista [label="Atualizar\nlista"];
  notificacao [label="Enviar\nnotificação"];
  join [shape=rect, label="", xlabel="join", style=filled, fillcolor="black", width=1.2, height=0.05, fixedsize=true];
  resultado [label="Apresentar\nresultado"];
  pedido -> verificar -> decisao;
  decisao -> confirmar [label="[livre]"];
  decisao -> recusar [label="[ocupada]"];
  { rank=same; confirmar; recusar; }
  confirmar -> fork;
  fork -> lista;
  fork -> notificacao;
  { rank=same; lista; notificacao; }
  lista -> join;
  notificacao -> join;
  join -> resultado;
}
