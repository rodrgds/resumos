digraph CasosDeUso {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=ellipse, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=15];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  iniciar [label="Iniciar sessão"];
  validar [label="Validar credenciais"];
  recuperar [label="Recuperar palavra passe"];
  desbloquear [label="Desbloquear conta"];
  node [shape=box];
  utilizador [label="Utilizador"];
  administrador [label="Administrador"];
  utilizador -> iniciar;
  iniciar -> validar [label="include"];
  recuperar -> iniciar [label="extend", style=dashed];
  administrador -> desbloquear;
}
