digraph CicloDeVida {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  requisitos -> desenho -> construcao -> validacao -> evolucao;
  evolucao -> requisitos [style=dashed, label="mudança"];
  requisitos [label="Requisitos"];
  desenho [label="Desenho"];
  construcao [label="Construção"];
  validacao [label="Validação"];
  evolucao [label="Evolução"];
}
