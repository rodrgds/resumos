digraph Classes {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  utilizador [label="Utilizador\n- email\n- palavraPasse\n+ iniciarSessao()"];
  pedido [label="Pedido\n- itens\n- total\n+ calcularTotal()"];
  basedados [label="BaseDados\n+ guardar()\n+ carregar()"];
  utilizador -> pedido [label="efetua 1..*"];
  pedido -> basedados [label="guardado em"];
}
