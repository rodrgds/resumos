digraph dependencias {
  graph [rankdir=TB, bgcolor="transparent", pad=0.15, nodesep=0.3, ranksep=0.4,
    fontname="sans-serif", fontsize=16, fontcolor="#292a30",
    label="Caminho crítico A–B–D\n2 + 4 + 2 = 8 dias", labelloc=b];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff",
    color="#8c2d3b", fontcolor="#292a30", fontname="sans-serif",
    fontsize=16, margin="0.15,0.1", penwidth=3];
  edge [color="#8c2d3b", penwidth=3, arrowsize=0.8];

  A [label="A · 2 dias\nCrítica"];
  B [label="B · 4 dias\nCrítica"];
  C [label="C · 3 dias\nFolga: 1 dia", color="#28716c", penwidth=1.5];
  D [label="D · 2 dias\nCrítica"];

  { rank=same; B; C; }
  A -> B;
  B -> D;
  A -> C [color="#28716c", penwidth=1.5];
  C -> D [color="#28716c", penwidth=1.5];
}
