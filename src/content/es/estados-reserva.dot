digraph estados_reserva {
  graph [rankdir=TB, bgcolor="transparent", pad=0.03, nodesep=0.14, ranksep=0.4];
  node [shape=box, style=rounded, fontname="sans-serif", fontsize=12, margin="0.07,0.04"];
  edge [fontname="sans-serif", fontsize=11, arrowsize=0.7];
  confirmada [label="Confirmada"];
  cancelada [label="Cancelada"];
  terminada [label="Terminada"];
  confirmada -> cancelada [label="cancelar\n[titular e\nagora < início]\n/ libertar\nintervalo"];
  confirmada -> terminada [label="atingir\no fim"];
  cancelada -> terminada [style=invis];
  cancelada -> cancelada [label="cancelar\nnovamente:\nsem novo\nefeito"];
}
