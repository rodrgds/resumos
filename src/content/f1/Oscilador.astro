---
import InteractiveDemo from '../../components/InteractiveDemo.astro';
import { oscillatorState } from './models.js';
const initialDamping = 1;
const initial = oscillatorState(initialDamping);
---

<InteractiveDemo label="Posição de uma massa e mola nos regimes de amortecimento">
  <div data-f1-oscillator>
    <label>
      Amortecimento b, em kg/s{' '}
      <input type="range" min="0" max="20" step="0.1" value={initialDamping} />
    </label>
    <output aria-live="polite">{initial.summary}</output>
    <svg viewBox="0 0 360 300" role="img" aria-label={initial.description}>
      <path d="M45 25 V260 H335 M45 140 H335" class="axis" />
      <path data-curve class="curve" d={initial.path} />
      <text x="5" y="36">
        +5
      </text>
      <text x="12" y="145">
        0
      </text>
      <text x="5" y="255">
        −5
      </text>
      <text x="8" y="17">
        x (cm)
      </text>
      <text x="45" y="283">
        0
      </text>
      <text x="250" y="283">
        t (s)
      </text>
      <text x="320" y="283">
        1
      </text>
    </svg>
    <p>
      A curva mostra um segundo de movimento. A posição inicial é 5 cm e a
      velocidade inicial é zero.
    </p>
  </div>
</InteractiveDemo>

<style>
  label {
    display: grid;
    gap: 8px;
  }
  input {
    width: 100%;
    accent-color: var(--accent);
  }
  output {
    display: block;
    margin-block: 12px;
    min-height: 3em;
    font-variant-numeric: tabular-nums;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--text);
  }
  path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .axis {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.5;
  }
  .curve {
    stroke: var(--accent);
    stroke-width: 3;
  }
  text {
    fill: currentColor;
    font-size: 22px;
  }
  p {
    font-size: 13px;
    margin-bottom: 0;
  }
</style>

<script>
  import { oscillatorState } from './models.js';
  for (const demo of document.querySelectorAll<HTMLElement>(
    '[data-f1-oscillator]',
  )) {
    const input = demo.querySelector('input')!;
    const output = demo.querySelector('output')!;
    const curve = demo.querySelector<SVGPathElement>('[data-curve]')!;
    const graph = demo.querySelector('svg')!;
    const update = () => {
      const state = oscillatorState(Number(input.value));
      curve.setAttribute('d', state.path);
      output.textContent = state.summary;
      graph.setAttribute('aria-label', state.description);
    };
    input.addEventListener('input', update);
    update();
  }
</script>
