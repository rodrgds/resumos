---
const defaultWave = Array.from({ length: 601 }, (_, index) => {
  const time = index / 600;
  const value = [1, 3, 5].reduce(
    (sum, harmonic) =>
      sum +
      (4 * Math.sin(2 * Math.PI * harmonic * time)) / (Math.PI * harmonic),
    0,
  );
  return `${index ? 'L' : 'M'}${30 + 375 * time} ${110 - 60 * value}`;
}).join(' ');
---

<div data-f2-fourier>
  <label>
    Número de harmónicos ímpares <output>3</output>
    <input
      aria-label="Número de harmónicos ímpares"
      type="range"
      min="1"
      max="15"
      value="3"
    />
  </label>
  <p data-summary aria-live="polite">
    Harmónicos 1, 3 e 5.
  </p>
  <div class="plot">
    <svg
      viewBox="0 0 420 220"
      role="img"
      aria-label="Soma de harmónicos ímpares comparada com uma onda quadrada"
    >
      <path d="M30 25 V195 M30 110 H405" stroke="currentColor" fill="none" />
      <path
        d="M30 50 H217.5 V170 H405"
        stroke="currentColor"
        stroke-dasharray="5 5"
        fill="none"
        opacity=".5"
      />
      <path
        data-wave
        d={defaultWave}
        stroke="var(--accent)"
        stroke-width="3"
        fill="none"
      />
      <g fill="currentColor" font-size="21">
        <text x="2" y="54">
          1
        </text>
        <text x="1" y="174">
          −1
        </text>
        <text x="355" y="214">
          t / T₀
        </text>
        <text x="210" y="214">
          0,5
        </text>
      </g>
    </svg>
  </div>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-f2-fourier]')
    .forEach((demo) => {
      const input = demo.querySelector('input')!;
      const update = () => {
        const count = Number(input.value);
        demo.querySelector('output')!.textContent = String(count);
        demo.querySelector('[data-summary]')!.textContent =
          `Harmónicos ímpares de 1 até ${2 * count - 1}.`;
        const points = Array.from({ length: 601 }, (_, i) => {
          const time = i / 600;
          let value = 0;
          for (let n = 0; n < count; n++) {
            const k = 2 * n + 1;
            value += ((4 / Math.PI) * Math.sin(2 * Math.PI * k * time)) / k;
          }
          return `${i ? 'L' : 'M'}${30 + 375 * time} ${110 - 60 * value}`;
        });
        demo.querySelector('[data-wave]')!.setAttribute('d', points.join(' '));
      };
      input.addEventListener('input', update);
      update();
    });
</script>
<style>
  label {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
  }
  input {
    grid-column: 1 / -1;
    width: 100%;
    min-height: 32px;
    accent-color: var(--accent);
  }
  .plot {
    overflow-x: auto;
  }
  svg {
    width: 100%;
    max-width: 420px;
    color: var(--text);
    display: block;
  }
</style>
