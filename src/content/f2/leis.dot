digraph Maxwell {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=15];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  cargas [label="cargas", shape=ellipse, fillcolor="#ffffff"];
  fechadas [label="linhas de B fechadas", shape=ellipse, fillcolor="#ffffff"];
  varb [label="B a variar", shape=ellipse, fillcolor="#ffffff"];
  vare [label="E a variar", shape=ellipse, fillcolor="#ffffff"];
  correntes [label="correntes", shape=ellipse, fillcolor="#ffffff"];
  gaussE [label="Gauss de E"];
  gaussB [label="Gauss de B"];
  faraday [label="Faraday"];
  amax [label="Ampere-Maxwell"];
  cargas -> gaussE;
  fechadas -> gaussB;
  varb -> faraday;
  correntes -> amax;
  vare -> amax;
}
