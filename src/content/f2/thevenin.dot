digraph Thevenin {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=15];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  fonte [label="fonte 12 V"];
  R1 [label="R1 2 kΩ"];
  A [label="nó A"];
  R2 [label="R2 4 kΩ"];
  terra [label="terra (0 V)"];
  RL [label="carga RL 4 kΩ"];
  fonte -> R1;
  R1 -> A;
  A -> R2;
  R2 -> terra;
  fonte -> terra [style=dashed, label="retorno"];
  A -> RL [style=bold, label="terminais a-b"];
  RL -> terra;
}
