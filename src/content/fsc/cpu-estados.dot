digraph Estados {
 graph [bgcolor="transparent",rankdir=LR,pad=0.2];
 node [shape=box,fontname="Arial",color="#8c2d3b",fontsize=13];
 edge [fontname="Arial",color="#8c2d3b",fontsize=11];
 s0 [label="0 · fetch"]; s1 [label="1 · decode"]; s2 [label="2 · endereço"]; s3 [label="3 · ler dados"]; s4 [label="4 · writeback lw"];
 s5 [label="5 · store"]; s6 [label="6 · ALU R"]; s7 [label="7 · writeback R"]; s8 [label="8 · branch"];
 s0 -> s1; s1 -> s2 [label="lw / sw"]; s2 -> s3 [label="lw"]; s3 -> s4; s2 -> s5 [label="sw"]; s1 -> s6 [label="R"]; s6 -> s7; s1 -> s8 [label="beq"];
 s4 -> s0 [constraint=false]; s5 -> s0 [constraint=false]; s7 -> s0 [constraint=false]; s8 -> s0 [constraint=false];
}
