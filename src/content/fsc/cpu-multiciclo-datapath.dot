digraph multiciclo {
  rankdir=TB;
  graph [bgcolor="transparent",pad=0.2,nodesep=0.5,ranksep=0.6];
  node [fontname="Arial",fontsize=14];
  edge [fontname="Arial",fontsize=11];
  PC [shape=box label="PC"];
  MEM [shape=box label="Mem I/D"];
  IR [shape=box]; MDR [shape=box];
  REG [shape=box label="Banco x0-x31"];
  A [shape=box]; B [shape=box]; ALUOut [shape=box];
  ALU [shape=circle label="ALU"];
  IMM [shape=box label="ImmGen d/d-4"];
  FOUR [shape=box label="Constante 4"];
  PC -> MEM [label="IorD=0"];
  ALUOut -> MEM [label="IorD=1"];
  MEM -> IR [label="fetch"];
  MEM -> MDR [label="dados"];
  IR -> REG [label="rs1/rs2/rd"];
  IR -> IMM;
  REG -> A [label="rd1"]; REG -> B [label="rd2"];
  B -> MEM [label="dado de sw",constraint=false];
  A -> ALU [label="ALUSrcA 1"];
  PC -> ALU [label="ALUSrcA 0"];
  B -> ALU [label="ALUSrcB 00"];
  FOUR -> ALU [label="ALUSrcB 01"];
  IMM -> ALU [label="ALUSrcB 10"];
  ALU -> ALUOut;
  ALU -> PC [label="PCSource 0"];
  ALUOut -> PC [label="PCSource 1"];
  MDR -> REG [label="MemtoReg 1"];
  ALUOut -> REG [label="MemtoReg 0"];
}
