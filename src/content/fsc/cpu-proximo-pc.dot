digraph PC {
 graph [bgcolor="transparent",rankdir=LR,pad=0.2,nodesep=0.4];
 node [shape=box,fontname="Arial",color="#8c2d3b",fontsize=15];
 edge [fontname="Arial",color="#8c2d3b",fontsize=12];
 pc [label="PC atual"]; p4 [label="PC + 4"]; pd [label="PC + d"]; d [label="d de branch\nem bytes"]; mux [label="MUX\nPCSrc"]; next [label="PC seguinte"];
 branch [label="Branch"]; zero [label="Zero da ALU"]; both [label="AND"];
 pc -> p4; pc -> pd; d -> pd; p4 -> mux [label="0"]; pd -> mux [label="1"]; mux -> next;
 branch -> both; zero -> both; both -> mux [label="seleção",style=dashed];
}
