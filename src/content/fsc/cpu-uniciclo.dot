digraph CPU {
 graph [bgcolor="transparent",rankdir=TB,pad=0.2,nodesep=0.5,ranksep=0.5];
 node [shape=box,fontname="Arial",color="#8c2d3b",fontsize=15];
 edge [fontname="Arial",color="#8c2d3b",fontsize=12];
 pc [label="PC"]; im [label="Memória de instruções"]; rf [label="Banco 32 × 32\n2 leituras, 1 escrita"]; imm [label="ImmGen"]; src [label="MUX · ALUSrc"]; alu [label="ALU"]; dm [label="Memória de dados"]; wb [label="MUX · MemtoReg"];
 {rank=same;rf;imm;}
 pc -> im; im -> rf [label="rs1, rs2, rd"]; im -> imm;
 rf -> alu [label="rs1"]; rf -> src [label="rs2"]; imm -> src [label="imediato"]; src -> alu;
 alu -> dm [label="endereço"]; rf -> dm [label="dado de sw"];
 alu -> wb [label="resultado"]; dm -> wb [label="dado de lw"];
 wb -> rf [label="writeback",constraint=false];
}
