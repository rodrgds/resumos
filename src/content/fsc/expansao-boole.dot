digraph Expansao {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b", fontcolor="#8c2d3b", fontname="Arial", fontsize=14];
  F [label="F(x1, x2, …, xn)"];
  F1 [label="F(1, x2, …, xn)"];
  F0 [label="F(0, x2, …, xn)"];
  F -> F1 [label="x1"];
  F -> F0 [label="x1 negado"];
}
