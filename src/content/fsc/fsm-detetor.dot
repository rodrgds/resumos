digraph Detetor {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b", fontcolor="#8c2d3b", fontname="Arial", fontsize=14];
  A [label="A\n(ainda não vi 1)"];
  B [label="B\n(vi um 1)", shape=doublecircle];
  A -> A [label="0"];
  A -> B [label="1"];
  B -> A [label="0"];
  B -> B [label="1 / deteção"];
}
