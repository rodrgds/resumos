digraph Resto {
 graph [bgcolor="transparent",rankdir=LR,pad=0.2];
 node [shape=circle,fontname="Arial",color="#8c2d3b",fontsize=14];
 edge [fontname="Arial",color="#8c2d3b",fontsize=13];
 start [shape=point]; R0 [label="R0\nz=1",shape=doublecircle]; R1 [label="R1\nz=0"]; R2 [label="R2\nz=0"];
 start -> R0 [label="reset"]; R0 -> R0 [label="0"]; R0 -> R1 [label="1"]; R1 -> R2 [label="0"]; R1 -> R0 [label="1"]; R2 -> R1 [label="0"]; R2 -> R2 [label="1"];
}
