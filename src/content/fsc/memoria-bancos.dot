digraph Mem {
 graph [bgcolor="transparent",rankdir=LR,pad=0.2,nodesep=0.5];
 node [shape=box,fontname="Arial",color="#8c2d3b",fontsize=15];
 edge [fontname="Arial",color="#8c2d3b",fontsize=13];
 dec [label="Seleção por A12"]; addr [label="A11...A0"];
 bank0 [shape=record,label="{Banco 0|{Chip 4K × 8\nD7...D0|Chip 4K × 8\nD15...D8}}"];
 bank1 [shape=record,label="{Banco 1|{Chip 4K × 8\nD7...D0|Chip 4K × 8\nD15...D8}}"];
 {rank=same;dec;addr;}
 {rank=same;bank0;bank1;}
 dec -> bank0 [label="A12=0"]; dec -> bank1 [label="A12=1"];
 addr -> bank0 [label="endereço interno"]; addr -> bank1 [label="endereço interno"];
}
