digraph Mux {
 graph [bgcolor="transparent", rankdir=LR, pad=0.2];
 node [shape=box, color="#8c2d3b", fontname="Arial", fontsize=14];
 edge [color="#8c2d3b", fontname="Arial", fontsize=12];
 I0; I1; S; N [label="NOT"]; A0 [label="AND"]; A1 [label="AND"]; O [label="OR"]; Y;
 S -> N; N -> A0; I0 -> A0; S -> A1; I1 -> A1; A0 -> O; A1 -> O; O -> Y;
}
