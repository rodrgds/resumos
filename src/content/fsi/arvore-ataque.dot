digraph arvore {
 rankdir=TB; node [shape=box];
 alvo [label="Ler fatura alheia"];
 ou [label="OU",shape=diamond];
 sessao [label="Usar sessão da vítima"];
 idor [label="Autorização por objeto em falta"];
 e [label="E",shape=diamond];
 roubo [label="Obter identificador de sessão"];
 valido [label="Usar antes de invalidar/expirar"];
 alvo -> ou; ou -> sessao; ou -> idor;
 sessao -> e; e -> roubo; e -> valido;
}
