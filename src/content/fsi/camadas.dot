digraph defesa {
  rankdir=TB;
  node [shape=box];
  pedido [label="Pedido do cliente"];
  auth [label="Autenticação"];
  autorizacao [label="Autorização sobre o objeto"];
  aplicacao [label="Operação da aplicação"];
  armazenamento [label="Armazenamento"];
  cifra [label="Cifragem: confidencialidade
da cópia de disco"];
  copias [label="Cópias: recuperação
de perda ou eliminação"];
  pedido -> auth -> autorizacao -> aplicacao -> armazenamento;
  cifra -> armazenamento [label="protege",style=dashed];
  armazenamento -> copias [label="cópia periódica"];
}
