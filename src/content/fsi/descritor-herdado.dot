digraph descritor {
  rankdir=TB;
  node [shape=box];
  abrir [label="1. Abrir: UID 0\nfd 3 para escrita"];
  baixar [label="2. Baixar UID: 1000\nfd 3 ainda aberto"];
  executar [label="3. execve sem\nclose-on-exec"];
  herdado [label="4. Novo programa\nherda fd 3"];
  abrir -> baixar -> executar -> herdado;
}
