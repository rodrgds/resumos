digraph DH {
  rankdir=TB;
  graph [fontname="sans-serif", ranksep=0.55];
  node [shape=box, fontname="sans-serif", fontsize=16, margin="0.14,0.10"];
  edge [fontname="sans-serif", fontsize=14];
  params [label="Públicos\np = 23, g = 5"];
  ana [label="Ana escolhe a = 6 privado\nCalcula A = 5^6 mod 23 = 8"];
  bruno [label="Bruno recebe A = 8\nEscolhe b = 15 privado\nCalcula B = 5^15 mod 23 = 19"];
  segredos [label="Ana recebe B = 19\nCalcula 19^6 mod 23 = 2\n\nBruno usa A e b\nCalcula 8^15 mod 23 = 2"];
  params -> ana [label="parâmetros conhecidos"];
  ana -> bruno [label="Ana envia A = 8"];
  bruno -> segredos [label="Bruno envia B = 19"];
}
