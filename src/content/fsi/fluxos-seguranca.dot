digraph fluxos {
  graph [rankdir=TB, bgcolor="transparent", fontname="sans-serif", fontsize=16, nodesep=0.4, ranksep=0.65, pad=0.15];
  node [shape=box, style=rounded, fontname="sans-serif", fontsize=16, margin="0.16,0.10"];
  edge [fontname="sans-serif", fontsize=14, arrowsize=0.8];

  subgraph cluster_blp {
    label="Bell-LaPadula\nConfidencialidade";
    margin=16;
    blp_alto [label="Sujeito\nAlto (High)"];
    blp_baixo [label="Objeto\nBaixo (Low)"];
    blp_alto -> blp_baixo [label="Escrita\nNEGADA", style=dashed];
    blp_baixo -> blp_alto [label="Leitura\nPERMITIDA", constraint=false];
  }

  subgraph cluster_biba {
    label="Biba estrito\nIntegridade";
    margin=16;
    biba_alto [label="Sujeito\nAlto (High)"];
    biba_baixo [label="Objeto\nBaixo (Low)"];
    biba_alto -> biba_baixo [label="Escrita\nPERMITIDA"];
    biba_baixo -> biba_alto [label="Leitura\nNEGADA", style=dashed, constraint=false];
  }

  blp_baixo -> biba_alto [style=invis];
}
