digraph fronteiras_compra {
  graph [rankdir=TB, bgcolor="transparent", pad=0.05, ranksep=0.35, fontsize=11, label="Tracejado: fora da loja", labelloc=b];
  node [shape=box, fontname="Arial", fontsize=12, margin="0.08,0.05"];
  edge [fontname="Arial", fontsize=11];
  navegador [label="Cliente\npropõe dados", style=dashed];
  servidor [label="Servidor\nvalida e calcula\nCatálogo: preço 30"];
  pagamento [label="Serviço externo\npagamento", style=dashed];
  confirmar [label="Mesmo servidor\nconfere origem,\nencomenda\ne montante"];
  navegador -> servidor [label="produto 7\nquantidade 2\npreço proposto: 1"];
  servidor -> pagamento [label="encomenda\ne total 60"];
  pagamento -> confirmar [label="confirmação"];
}
