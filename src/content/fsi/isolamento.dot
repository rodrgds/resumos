digraph isolamento {
  rankdir=TB;
  node [shape=box];
  subgraph cluster_c {
    label="Containers Linux";
    ca [label="Aplicações A"];
    cb [label="Aplicações B"];
    k [label="Kernel do anfitrião\npolíticas e limites"];
    ca -> k; cb -> k;
  }
  subgraph cluster_v {
    label="Máquina virtual";
    va [label="Aplicações convidadas"];
    vk [label="Kernel convidado"];
    h [label="Hipervisor\nhardware virtual"];
    va -> vk -> h;
  }
  k -> va [style=invis];
}
