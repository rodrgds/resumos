digraph retornos {
  rankdir=TB;
  node [shape=box];
  a [label="1. etapaA\nprimeiro destino de ret"];
  b [label="2. etapaB\nretorno visto por etapaA"];
  c [label="3. continuação\nretorno visto por etapaB"];
