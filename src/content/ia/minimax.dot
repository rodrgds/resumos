digraph Minimax {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  edge [color="#8c2d3b"];
  raiz [label="MAX"];
  A [label="MIN (A)"];
  B [label="MIN (B)"];
  n3 [label="3", shape=circle];
  n5 [label="5", shape=circle];
  n2 [label="2", shape=circle];
  n9 [label="9", shape=circle];
  raiz -> A [penwidth=2.5];
  raiz -> B;
  A -> n3 [penwidth=2.5];
  A -> n5;
  B -> n2;
  B -> n9 [style=dashed, label="cortado"];
}
