digraph Prova {
  graph [bgcolor="transparent", rankdir=BT, pad=0.12, nodesep=0.12];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=10];
  sobre_ab [label="Sobre\n(a, b)"];
  sobre_bm [label="Sobre\n(b, mesa)"];
  acima_ab [label="Acima\n(a, b)\nR1"];
  acima_bm [label="Acima\n(b, mesa)\nR1"];
  acima_am [label="Acima\n(a, mesa)\nR2", fillcolor="#8c2d3b", fontcolor="#ffffff"];
  sobre_ab -> acima_ab;
  sobre_bm -> acima_bm;
  acima_ab -> acima_am [label="R2"];
  acima_bm -> acima_am;
}
