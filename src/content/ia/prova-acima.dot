digraph Prova {
  graph [bgcolor="transparent", rankdir=BT, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=10];
  sobre_ab [label="Sobre(a, b)"];
  sobre_bm [label="Sobre(b, mesa)"];
  acima_ab [label="Acima(a, b)\n(R1)"];
  acima_bm [label="Acima(b, mesa)\n(R1)"];
  acima_am [label="Acima(a, mesa)\n(R2)", fillcolor="#8c2d3b", fontcolor="#ffffff"];
  sobre_ab -> acima_ab;
  sobre_bm -> acima_bm;
  acima_ab -> acima_am [label="R2"];
  acima_bm -> acima_am;
}
