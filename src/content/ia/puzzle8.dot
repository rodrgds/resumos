digraph Fragmento {
  graph [bgcolor="transparent", rankdir=TB, pad=0.12, nodesep=0.08, ranksep=0.32];
  node [shape=box, width=0.32, height=0.35, margin="0.05,0.03", style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b"];
  S [label="S"];
  A [label="A"];
  B [label="B"];
  C [label="C"];
  D [label="D"];
  A1 [label="A1"];
  A2 [label="A2"];
  B1 [label="B1"];
  B2 [label="B2\nobjetivo", fillcolor="#8c2d3b", fontcolor="#ffffff"];
  S -> A;
  S -> B [penwidth=2.5];
  S -> C;
  S -> D;
  A -> A1;
  A -> A2;
  B -> B1;
  B -> B2 [penwidth=2.5];
}
