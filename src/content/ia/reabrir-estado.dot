digraph Reabertura {
  graph [bgcolor="transparent", rankdir=TB, pad=0.12, nodesep=0.35, ranksep=0.40];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  S [label="S\nh = 4"];
  B [label="B\nh = 3"];
  A [label="A\nh = 0"];
  G [label="G, objetivo\nh = 0"];
  S -> A [label="3, direto"];
  S -> B [label="1", penwidth=2.5];
  B -> A [label="1, melhora A", penwidth=2.5];
  A -> G [label="2", penwidth=2.5];
}
