digraph Gradiente {
  graph [bgcolor="transparent", rankdir=TB, pad=0.12, ranksep=0.28];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  entrada [label="Entrada x = (1, 0)"];
  zh [label="Soma escondida\nz_h = 0,5"];
  ah [label="Sigmoide escondida\na_h ≈ 0,622"];
  zo [label="Soma da saída\nz_o ≈ 0,311"];
  y [label="Sigmoide da saída\ny ≈ 0,577"];
  erro [label="Erro com alvo t = 1\nE ≈ 0,089"];
  entrada -> zh;
  zh -> ah;
  ah -> zo [label="peso antigo 0,5"];
  zo -> y;
  y -> erro;
}
