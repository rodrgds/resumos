---
import InteractiveDemo from '../../components/InteractiveDemo.astro';
---

<InteractiveDemo label="Protótipo de uma reserva de sala">
  <div data-reservation-demo>
    <div data-choice>
      <div class="room-choice">
        <label for="ipc-demo-room">Sala</label>
        <select id="ipc-demo-room">
          <option>B101</option>
          <option>B102</option>
        </select>
      </div>
      <button type="button" data-review>
        Rever reserva
      </button>
    </div>
    <div data-review-state hidden>
      <p data-summary></p>
      <button type="button" data-confirm>
        Confirmar reserva
      </button>
      <button type="button" data-back>
        Voltar à escolha
      </button>
    </div>
    <p data-result role="status"></p>
    <noscript>
      Sem JavaScript, o percurso é escolher uma sala, rever sala e horário,
      voltar à escolha se for preciso corrigir, e confirmar. A confirmação
      apresenta o resultado da simulação.
    </noscript>
  </div>
</InteractiveDemo>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-reservation-demo]')
    .forEach((root) => {
      const choice = root.querySelector<HTMLElement>('[data-choice]')!;
      const review = root.querySelector<HTMLElement>('[data-review-state]')!;
      const room = root.querySelector('select')!;
      const result = root.querySelector<HTMLElement>('[data-result]')!;
      const confirm = root.querySelector<HTMLButtonElement>('[data-confirm]')!;
      const returnToChoice = () => {
        review.hidden = true;
        choice.hidden = false;
        room.focus();
      };
      root.querySelector('[data-review]')!.addEventListener('click', () => {
        result.textContent = '';
        root.querySelector('[data-summary]')!.textContent =
          `Sala ${room.value}, amanhã, 14h–15h.`;
        choice.hidden = true;
        review.hidden = false;
        confirm.focus();
      });
      root
        .querySelector('[data-back]')!
        .addEventListener('click', returnToChoice);
      confirm.addEventListener('click', () => {
        result.textContent = `Simulação: reserva confirmada para ${room.value}.`;
        returnToChoice();
      });
      room.addEventListener('change', () => {
        result.textContent = '';
      });
    });
</script>

<style>
  [hidden] {
    display: none;
  }
  .room-choice {
    display: grid;
    gap: 8px;
    max-width: 250px;
    margin-bottom: 16px;
  }
  select,
  button {
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--page);
    color: var(--text);
    font: inherit;
  }
  button {
    cursor: pointer;
    margin: 0 8px 8px 0;
  }
  p {
    margin: 0 0 16px;
  }
  [data-result]:empty {
    display: none;
  }
  select:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
