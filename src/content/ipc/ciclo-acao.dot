digraph acao {
  rankdir=TB; node [shape=box];
  objetivo [label="Objetivo"];
  intencao [label="Formar intenção"];
  especificar [label="Escolher ações"];
  executar [label="Executar"];
  perceber [label="Perceber resposta"];
  interpretar [label="Interpretar estado"];
  avaliar [label="Comparar com objetivo"];
  objetivo -> intencao -> especificar -> executar;
  executar -> perceber -> interpretar -> avaliar;
  avaliar -> objetivo [label="continua ou termina"];
  subgraph cluster_execucao {
    label="Golfo de execução";
    intencao; especificar; executar;
  }
  subgraph cluster_avaliacao {
    label="Golfo de avaliação";
    perceber; interpretar; avaliar;
  }
}
