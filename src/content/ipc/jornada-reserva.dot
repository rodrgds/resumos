digraph jornada {
  rankdir=LR; node [shape=box];
  chat [label="Chat do grupo:\nacordam horário"];
  catalogo [label="Catálogo:\nprocura sala"];
  confirmar [label="Confirmação:\nrecebe estado"];
  chat -> catalogo [label="volta para\nconfirmar grupo"];
  catalogo -> chat [label="pede opinião"];
  catalogo -> confirmar [label="escolhe"];
}
