digraph AcessoBilhete {
  graph [rankdir=TB, bgcolor="transparent", pad=0.05, ranksep=0.3];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12, margin="0.08,0.05"];
  edge [fontname="Arial", fontsize=11];
  pedido [label="Comprador U7\nGET /bilhetes/900"];
  consulta [label="Consulta parametrizada\n900 pertence a U8"];
  policy [label="Policy view\nU7 não é o titular"];
  recusa [label="Recusar leitura\nSem representação"];
  pedido -> consulta [label="Procurar por id"];
  consulta -> policy [label="Encontrar\nnão autoriza"];
  policy -> recusa [label="Sem permissão"];
}
