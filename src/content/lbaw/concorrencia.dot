digraph C {
 graph [bgcolor="transparent",rankdir=TB];
 node [shape=box,fontname="Arial",style="rounded,filled",fillcolor="#fff1e9",color="#9c4825"];
 edge [color="#9c4825",fontname="Arial"];
 a0 [label="A: COUNT = 0"]; b0 [label="B: COUNT = 0"];
 a1 [label="A: INSERT"]; b1 [label="B: INSERT"];
 fim [label="A e B: COMMIT\n2 bilhetes, lotação 1"];
 {rank=same;a0;b0} {rank=same;a1;b1}
 a0 -> a1; b0 -> b1; a1 -> fim; b1 -> fim;
}
