digraph D {
 graph [rankdir=LR,bgcolor="transparent"];
 node [shape=box,fontname="Arial",style="rounded,filled",fillcolor="#fff1e9",color="#9c4825"];
 edge [color="#9c4825",fontname="Arial"];
 aluno_uc [label="aluno, uc\n(chave de matrícula)"];
 uc [label="uc"]; docente [label="docente"]; sala [label="sala"];
 aluno_uc -> uc [label="inclui"];
 uc -> docente [label="determina"]; docente -> sala [label="determina"];
}
