digraph H {
 graph [bgcolor="transparent",rankdir=LR];
 node [shape=box,fontname="Arial",style="rounded,filled",fillcolor="#fff1e9",color="#9c4825"];
 edge [color="#9c4825",fontname="Arial"];
 browser [label="Navegador\ncookie: identificador"];
 server [label="Servidor\nsessão e autorização"];
 db [label="Base de dados"];
 browser -> server [label="pedido HTTP"];
 server -> db [label="consulta / alteração"];
 db -> server [label="resultado"];
 server -> browser [label="resposta HTTP"];
}
