graph Sitemap {
  graph [bgcolor="transparent", rankdir=TB, pad=0.3, ranksep=0.6];
  node [shape=record, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontname="Arial", fontsize=13];
  Inicio [label="Início|destaques, pesquisa"];
  Evento [label="Evento|descrição, sessões"];
  Sessao [label="Sessão|preço, lugares"];
  Compra [label="Compra|formulário, confirmação"];
  Conta [label="Conta|histórico"];
  Inicio -- Evento;
  Evento -- Sessao;
  Sessao -- Compra;
  Conta -- Compra [style=dashed];
}
