digraph {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.5, ranksep=0.65];
  node [shape=plain, fontname="sans-serif", fontcolor="#292a30"];
  edge [fontname="sans-serif", fontsize=10, color="#28716c", fontcolor="#292a30"];
  form [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" WIDTH="240" BGCOLOR="#ffffff" COLOR="#28716c">
      <TR><TD BGCOLOR="#f3e9e9"><B>Comprar bilhete</B></TD></TR>
      <TR><TD ALIGN="LEFT">Quantidade: [ 1 ]</TD></TR>
      <TR><TD PORT="comprar" BGCOLOR="#ffffff">[ Confirmar compra ]</TD></TR>
    </TABLE>
  >];
  error [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" WIDTH="240" BGCOLOR="#ffffff" COLOR="#8c2d3b">
      <TR><TD BGCOLOR="#f3e9e9"><B>Comprar bilhete</B></TD></TR>
      <TR><TD ALIGN="LEFT">Quantidade: [ 1 ]</TD></TR>
      <TR><TD ALIGN="LEFT">Sem lugares disponíveis.</TD></TR>
      <TR><TD PORT="voltar" BGCOLOR="#ffffff">[ Escolher outra sessão ]</TD></TR>
    </TABLE>
  >];
  done [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12" WIDTH="240" BGCOLOR="#ffffff" COLOR="#28716c">
      <TR><TD BGCOLOR="#f3e9e9"><B>Compra confirmada</B></TD></TR>
      <TR><TD ALIGN="LEFT">Bilhete: 42</TD></TR>
      <TR><TD BGCOLOR="#ffffff">[ Ver bilhete ]</TD></TR>
    </TABLE>
  >];
  form:comprar -> done [label="confirmação válida"];
  form:comprar -> error [label="sessão esgotou"];
  error -> done [style=invis];
}
