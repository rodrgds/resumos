digraph Interrupcao {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b"];
  Teclado -> PIC;
  Temporizador -> PIC;
  PIC -> CPU;
  CPU -> Handler;
}
