digraph Gesto {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  WAIT_PRESS [label="WAIT_PRESS\nEsperar nova pressão"];
  DRAWING [label="DRAWING\nAcumular x e y\nVálido e x < 100: continuar"];
  INVALID [label="INVALID\nIgnorar movimento"];
  COMPLETE [label="COMPLETE\nGesto já reconhecido"];
  WAIT_PRESS -> DRAWING [label="pressionar\nx = y = 0"];
  DRAWING -> DRAWING;
  DRAWING -> INVALID [label="Δx < 0 ou |y| > 5"];
  DRAWING -> COMPLETE [label="x ≥ 100 e |y| ≤ 5\nreconhecer uma vez"];
  DRAWING -> WAIT_PRESS [label="largar antes\ndo fim", tailport=e, headport=e];
  INVALID -> WAIT_PRESS [label="largar"];
  COMPLETE -> WAIT_PRESS [label="largar"];
}
