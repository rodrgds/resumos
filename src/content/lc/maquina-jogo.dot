digraph Jogo {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  MENU -> JOGO [label="Enter"];
  JOGO -> PAUSA [label="P"];
  PAUSA -> JOGO [label="P"];
  PAUSA -> MENU [label="Esc"];
  JOGO -> FIM [label="sem vidas"];
  FIM -> MENU [label="Enter"];
}
