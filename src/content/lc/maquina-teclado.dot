digraph Descodificador {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  Normal -> Normal [label="byte normal"];
  Normal -> EsperaBreak [label="0xF0"];
  Normal -> RamoE0 [label="0xE0"];
  EsperaBreak -> Normal [label="2o byte"];
  RamoE0 -> Normal [label="resto"];
}
