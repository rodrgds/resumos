digraph Descodificador {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=ellipse, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  Normal [label="Sem prefixo"];
  Extended [label="E0 guardado"];
  Normal -> Normal [label="código simples: emitir evento"];
  Normal -> Extended [label="0xE0: guardar prefixo"];
  Extended -> Normal [label="byte seguinte: emitir evento E0"];
}
