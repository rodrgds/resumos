---
interface Props {
  kind: 'classes' | 'sequence' | 'communication' | 'state';
}
const { kind } = Astro.props;
const labels = {
  classes:
    'Uma Arena contém um Heroi e zero ou mais Paredes. Heroi tem uma associação navegável para uma Posicao.',
  sequence:
    'Modelo começa na posição 2. Controlador pede mover(1), recebe true, lê a posição 3 e pede à Vista para mostrar 3. O tempo avança para baixo.',
  communication:
    'Controlador liga-se ao Modelo e à Vista. As mensagens são 1 mover(1), 2 getX() e 3 mostrar(3), pela ordem indicada.',
  state:
    'Jogo começa em Menu. Comecar passa a Jogar. Pausar passa a Pausa, retomar regressa a Jogar e perder termina o jogo.',
};
---

<div class="diagram">
  <svg
    viewBox={kind === 'sequence' ? '0 0 360 390' : '0 0 340 340'}
    role="img"
    aria-label={labels[kind]}
  >
    <title>{labels[kind]}</title>
    {kind === 'classes' && (
      <>
        <rect x="96" y="8" width="148" height="78" rx="3" />
        <text x="170" y="30" text-anchor="middle">
          Arena
        </text>
        <path d="M96 39H244M96 60H244" />
        <text x="104" y="54">
          - largura: int
        </text>
        <text x="104" y="77">
          + mover(dx): boolean
        </text>
        <path d="M170 86V128M163 93L170 86L177 93L170 100Z" class="filled" />
        <text x="184" y="115">
          1
        </text>
        <rect x="98" y="130" width="144" height="64" rx="3" />
        <text x="170" y="153" text-anchor="middle">
          Heroi
        </text>
        <path d="M98 161H242" />
        <text x="108" y="182">
          - vida: int
        </text>
        <path d="M170 194V248M164 242L170 248L176 242" />
        <text x="184" y="230">
          1
        </text>
        <rect x="98" y="250" width="144" height="66" rx="3" />
        <text x="170" y="273" text-anchor="middle">
          Posicao
        </text>
        <path d="M98 281H242" />
        <text x="108" y="300">
          - x, y: int
        </text>
        <path d="M89 40L96 47L89 54L82 47Z" class="filled" />
        <path d="M82 47H32V132" />
        <text x="7" y="112">
          0..*
        </text>
        <rect x="2" y="134" width="84" height="48" rx="3" />
        <text x="44" y="163" text-anchor="middle">
          Parede
        </text>
      </>
    )}
    {kind === 'sequence' && (
      <>
        <rect x="4" y="6" width="110" height="40" rx="3" />
        <text x="59" y="31" text-anchor="middle">
          Controlador
        </text>
        <rect x="129" y="6" width="100" height="40" rx="3" />
        <text x="179" y="31" text-anchor="middle">
          Modelo
        </text>
        <rect x="257" y="6" width="94" height="40" rx="3" />
        <text x="304" y="31" text-anchor="middle">
          Vista
        </text>
        <path d="M59 46V380M179 46V380M304 46V380" class="dashed" />
        <path d="M59 105H173" />
        <path d="M173 99L179 105L173 111Z" class="filled" />
        <text x="119" y="92" text-anchor="middle">
          mover(1)
        </text>
        <path d="M179 155H59M65 149L59 155L65 161" class="dashed" />
        <text x="119" y="142" text-anchor="middle">
          true
        </text>
        <path d="M59 205H173" />
        <path d="M173 199L179 205L173 211Z" class="filled" />
        <text x="119" y="192" text-anchor="middle">
          getX()
        </text>
        <path d="M179 255H59M65 249L59 255L65 261" class="dashed" />
        <text x="119" y="242" text-anchor="middle">
          3
        </text>
        <path d="M59 325H298" />
        <path d="M298 319L304 325L298 331Z" class="filled" />
        <text x="180" y="312" text-anchor="middle">
          mostrar(3)
        </text>
      </>
    )}
    {kind === 'communication' && (
      <>
        <rect x="78" y="20" width="184" height="44" rx="3" />
        <text x="170" y="48" text-anchor="middle">
          c:Controlador
        </text>
        <rect x="10" y="258" width="132" height="44" rx="3" />
        <text x="76" y="285" text-anchor="middle">
          m:Modelo
        </text>
        <rect x="216" y="258" width="112" height="44" rx="3" />
        <text x="272" y="285" text-anchor="middle">
          v:Vista
        </text>
        <path d="M130 64L76 258M72 248L76 258L84 251M210 64L272 258M264 251L272 258L276 248" />
        <text x="3" y="152">
          1: mover(1)
        </text>
        <text x="3" y="176">
          2: getX()
        </text>
        <text x="208" y="205">
          3: mostrar(3)
        </text>
      </>
    )}
    {kind === 'state' && (
      <>
        <circle cx="170" cy="12" r="6" class="filled" />
        <path d="M170 18V40M164 34L170 40L176 34" />
        <rect x="112" y="42" width="116" height="42" rx="10" />
        <text x="170" y="69" text-anchor="middle">
          Menu
        </text>
        <path d="M170 84V142M164 136L170 142L176 136" />
        <text x="183" y="119">
          começar
        </text>
        <rect x="112" y="144" width="116" height="42" rx="10" />
        <text x="170" y="171" text-anchor="middle">
          Jogar
        </text>
        <path d="M112 165H43V224M37 218L43 224L49 218" />
        <text x="3" y="198">
          pausar
        </text>
        <rect x="2" y="226" width="82" height="42" rx="10" />
        <text x="43" y="253" text-anchor="middle">
          Pausa
        </text>
        <path d="M84 247H97V178H112M106 172L112 178L106 184" />
        <text x="101" y="240">
          retomar
        </text>
        <path d="M228 165H294V310M288 304L294 310L300 304" />
        <text x="243" y="284">
          perder
        </text>
        <circle cx="294" cy="322" r="10" />
        <circle cx="294" cy="322" r="6" class="filled" />
      </>
    )}
  </svg>
</div>
<style>
  .diagram {
    margin-block: 1.5rem;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 23rem;
    height: auto;
    margin-inline: auto;
  }
  rect,
  path,
  circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  text {
    fill: currentColor;
    font: 14px var(--font-body, sans-serif);
  }
  .filled {
    fill: currentColor;
  }
  .dashed {
    stroke-dasharray: 5 4;
  }
</style>
