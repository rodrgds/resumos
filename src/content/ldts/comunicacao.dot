digraph Comunicacao {
  graph [bgcolor="transparent", rankdir=LR, pad=0.3];
  node [shape=box, style="filled,rounded", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  ControladorArena -> Heroi [label="1: passo(cima)"];
  Heroi -> Posicao [label="1.1: somar(0,-1)"];
  Posicao -> Heroi [label="nova posicao", style=dashed];
  Heroi -> ControladorArena [label="retorno", style=dashed];
  ControladorArena -> Ecra [label="2: desenhar(...)"];
}
