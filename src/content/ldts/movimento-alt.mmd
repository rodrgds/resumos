%%{init: {"sequence":{"actorMargin":12,"width":110,"messageMargin":20,"diagramMarginX":8}}}%%
sequenceDiagram
    participant C as Controlador
    participant M as Modelo
    participant V as Vista
    Note over M: x = 2
    C->>M: mover(1)
    alt livre
        M->>M: x = 3
        M-->>C: true
    else ocupada
        M-->>C: false
    end
    C->>M: getX()
    M-->>C: x
    C->>V: mostrar(x)
