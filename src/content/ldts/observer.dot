digraph Observer {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2, nodesep=0.3, ranksep=0.5];
  node [shape=box, style=rounded, color="#292a30", fontcolor="#292a30", fontname="Arial", fontsize=14, margin="0.12,0.1"];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  sujeito [label="Pontuacao\npontos = 120"];
  contrato [label="Observador\nmudou(int pontos)"];
  texto [label="Texto da\npontuação"];
  conquista [label="Verificador de\nconquista"];
  sujeito -> contrato [label="mudou(120)"];
  contrato -> texto [label="implementa", style=dashed, dir=back, arrowtail=empty];
  contrato -> conquista [label="implementa", style=dashed, dir=back, arrowtail=empty];
  { rank=same; texto; conquista; }
}
