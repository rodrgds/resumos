digraph Observer {
  graph [bgcolor="transparent", rankdir=TB, pad=0.08, nodesep=0.15, ranksep=0.5];
  node [shape=box, style=rounded, color="#292a30", fontcolor="#292a30", fontname="Arial", fontsize=12, margin="0.06,0.08"];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=11];
  sujeito [label="Pontuacao\npontos = 120"];
  contrato [label="Observador\nmudou(int pontos)"];
  texto [label="Texto da\npontuação"];
  conquista [label="Verificador\nde conquista"];
  sujeito -> contrato [label="mudou(120)"];
  contrato -> texto [style=dashed, dir=back, arrowtail=empty];
  contrato -> conquista [style=dashed, dir=back, arrowtail=empty];
  { rank=same; texto; conquista; }
}
