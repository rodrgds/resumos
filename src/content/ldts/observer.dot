digraph Observer {
  graph [bgcolor="transparent", rankdir=LR, pad=0.3];
  node [shape=box, style="filled,rounded", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  Monstro -> Pontuacao [label="notificar(100)"];
  Monstro -> Mortes [label="notificar(1)"];
  Monstro -> Som [label="notificar(som)"];
}
