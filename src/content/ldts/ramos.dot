digraph Ramos {
  graph [bgcolor="transparent", rankdir=LR, pad=0.3];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  A [label="A"];
  B [label="B"];
  C [label="C"];
  D [label="D"];
  E [label="E"];
  A -> B [label="main"];
  B -> C;
  B -> D [label="heroi-move", style=dashed];
  D -> E [label="merge"];
  C -> E [style=invis];
  { rank=same; C; E; }
}
