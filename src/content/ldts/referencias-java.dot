digraph ReferenciasJava {
  graph [bgcolor="transparent", rankdir=TB, pad=0.15, nodesep=0.18, ranksep=0.35, fontname="Arial", fontsize=15];
  node [shape=box, style=rounded, fontname="Arial", fontsize=15, color="#292a30", fontcolor="#292a30", margin="0.1,0.08"];
  edge [color="#8c2d3b", arrowsize=0.7];

  subgraph cluster_entrada {
    label="1. Entrada em alterar";
    color="#292a30";
    margin=12;
    { rank=same;
      equipa1 [label="equipa\nchamador"];
      outra1 [label="outra\nchamador"];
      nomes1 [label="nomes\nparâmetro"];
    }
    lista1 [label="Lista partilhada\n[Ana]", color="#8c2d3b"];
    equipa1 -> lista1;
    outra1 -> lista1;
    nomes1 -> lista1;
  }

  subgraph cluster_add {
    label="2. Depois de nomes.add(\"Rita\")";
    color="#292a30";
    margin=12;
    { rank=same;
      equipa2 [label="equipa\nchamador"];
      outra2 [label="outra\nchamador"];
      nomes2 [label="nomes\nparâmetro"];
    }
    lista2 [label="Mesma lista partilhada\n[Ana, Rita]", color="#8c2d3b"];
    equipa2 -> lista2;
    outra2 -> lista2;
    nomes2 -> lista2;
  }

  subgraph cluster_reatribuicao {
    label="3. Depois de reatribuir nomes\ne de nomes.add(\"Luis\")";
    color="#292a30";
    margin=12;
    { rank=same;
      equipa3 [label="equipa\nchamador"];
      outra3 [label="outra\nchamador"];
      nomes3 [label="nomes\nparâmetro"];
    }
    { rank=same;
      lista3 [label="Mesma lista\n[Ana, Rita]", color="#8c2d3b"];
      nova3 [label="Lista nova\n[Luis]", color="#8c2d3b"];
    }
    equipa3 -> lista3;
    outra3 -> lista3;
    nomes3 -> nova3;
  }

  lista1 -> outra2 [style=invis, minlen=2];
  lista2 -> outra3 [style=invis, minlen=2];
}
