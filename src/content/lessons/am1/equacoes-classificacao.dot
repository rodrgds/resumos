digraph Classificacao {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style=rounded, fontname="Arial", fontsize=15];
  inicio [label="EDO de 1.ª ordem?", shape=diamond];
  segunda [label="2.ª ordem, coeficientes constantes: característica"];
  sep [label="Separável?"];
  hom [label="Homogénea em y/x?"];
  lin [label="Linear? Fator integrante"];
  bern [label="Bernoulli? v = y^(1-n)"];
  separaveis [label="Separa e integra"];
  resolve [label="Resolve"];
  inicio -> segunda [label="não"];
  inicio -> sep [label="sim"];
  sep -> separaveis [label="sim"];
  sep -> hom [label="não"];
  hom -> resolve [label="sim, com v = y/x"];
  hom -> lin [label="não"];
  lin -> resolve [label="sim"];
  lin -> bern [label="não, se tem y^n"];
  bern -> resolve [label="sim"];
}
