digraph Estrategia {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style=rounded, fontname="Arial", fontsize=15];
  termo [label="limite do termo geral = 0?", shape=diamond];
  diverge [label="Diverge"];
  familia [label="Geométrica? Telescópica? Série-p?", shape=diamond];
  soma [label="Resolve direto"];
  forma [label="Fatorial? Potência n? Fração? Alternada?"];
  dalembert [label="d'Alembert"];
  cauchy [label="Cauchy"];
  compara [label="Comparação"];
  leibniz [label="Leibniz"];
  termo -> diverge [label="não"];
  termo -> familia [label="sim"];
  familia -> soma [label="sim"];
  familia -> forma [label="não"];
  forma -> dalembert [label="fatorial"];
  forma -> cauchy [label="potência n"];
  forma -> compara [label="fração"];
  forma -> leibniz [label="alternada"];
}
