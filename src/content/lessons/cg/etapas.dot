digraph Etapas {
  graph [bgcolor="transparent", rankdir=TB, pad=0.12, nodesep=0.15, size="2.2,8"];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  recorte [label="Recorte da primitiva"];
  dentro [label="Interior"];
  parcial [label="Cruza a\nfronteira"];
  fora [label="Exterior a\num plano"];
  corte [label="Criar\ninterseções"];
  descartar [label="Descartar", style="rounded,dashed", color="#28716c"];
  divisao [label="Dividir por w"];
  viewport [label="Viewport"];
  recorte -> dentro;
  recorte -> parcial;
  recorte -> fora;
  parcial -> corte -> divisao;
  dentro -> divisao;
  fora -> descartar;
  divisao -> viewport;
}
