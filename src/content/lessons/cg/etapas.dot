digraph Etapas {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  projecao -> recorte;
  recorte -> dentro [label="dentro"];
  recorte -> fora [label="fora"];
  fora [shape=box, style="rounded,dashed", color="#28716c"];
  dentro -> divisao -> viewport -> pixeis;
}
