digraph Malha {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=13];
  edge [color="#8c2d3b"];
  malha -> vertices;
  malha -> arestas;
  malha -> faces;
  vertices [label="Vértices\nposições 3D"];
  arestas [label="Arestas\npares de vértices"];
  faces [label="Faces\ntrios de vértices"];
}
