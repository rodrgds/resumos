digraph Impasse {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  node [shape=box] L1 L2;
  node [shape=circle] A B;
  A [label="A"];
  B [label="B"];
  L1 [label="lock 1"];
  L2 [label="lock 2"];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  L1 -> A [label="tem"];
  L2 -> B [label="tem"];
  A -> L2 [label="quer"];
  B -> L1 [label="quer"];
}
