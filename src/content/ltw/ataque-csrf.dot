digraph {
  rankdir=LR;
  vitima [label="vítima\n(sessão aberta)", shape=box];
  malicioso [label="sítio malicioso", shape=box];
  servidor [label="a tua loja", shape=box];
  malicioso -> vitima [label="isca: formulário auto-submetido"];
  vitima -> servidor [label="POST + cookie da sessão"];
  servidor -> vitima [label="obedece (sem token)"];
}
