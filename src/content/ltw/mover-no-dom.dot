digraph mover_no_dom {
  graph [rankdir=TB, nodesep=0.2, ranksep=0.3, fontsize=12];
  node [shape=box, fontsize=12];
  edge [fontsize=12];
  subgraph cluster_antes {
    label="Antes";
    a_origem [label="ul origem"];
    a_destino [label="ul destino\n(vazio)"];
    a_item [label="li Redes\nitem"];
    { rank=same; a_origem; a_destino; }
    a_origem -> a_item [label="filho"];
  }
  subgraph cluster_depois {
    label="Depois de\ndestino.append(item)";
    d_origem [label="ul origem\n(vazio)"];
    d_destino [label="ul destino"];
    d_item [label="li Redes\nmesmo item"];
    { rank=same; d_origem; d_destino; }
    d_destino -> d_item [label="filho"];
  }
  a_item -> d_origem [style=invis];
}
