graph Borboleta {
  graph [bgcolor="transparent", rankdir=LR, nodesep=0.6, ranksep=0.6, pad=0.2];
  node [shape=circle, fontname="Arial", fontsize=18, color="#8c2d3b", fontcolor="#292a30"];
  edge [color="#8c2d3b", penwidth=2];
  { rank=same; a; b; }
  { rank=same; d; e; }
  { a b } -- c;
  c -- { d e };
  a -- b [constraint=false];
  d -- e [constraint=false];
}
