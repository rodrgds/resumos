digraph composicao {
  rankdir=LR;
  node [shape=circle];
  a1 [label="1"]; a2 [label="2"];
  b1 [label="x"]; b2 [label="y"];
  c1 [label="p"];
  a1 -> b1 [label="R"];
  a2 -> b2 [label="R"];
  b1 -> c1 [label="S"];
  b2 -> c1 [label="S"];
  a1 -> c1 [style=dashed, label="S∘R"];
  a2 -> c1 [style=dashed, label="S∘R"];
}
