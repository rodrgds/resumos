graph GrausIguais {
  graph [rankdir=TB, bgcolor="transparent", fontsize=12, nodesep=0.2, ranksep=0.3, pad=0.05, compound=true];
  node [shape=circle, fontsize=12, width=0.3, height=0.3];
  subgraph cluster_ciclo {
    label="C6:\numa componente";
    { rank=same; a [label="1"]; b [label="2"]; }
    { rank=same; f [label="6"]; c [label="3"]; }
    { rank=same; e [label="5"]; d [label="4"]; }
    a -- b; a -- f; b -- c; f -- e; c -- d; e -- d;
  }
  subgraph cluster_triangulos {
    label="Dois triângulos:\nduas componentes";
    { rank=same; u [label="a"]; v [label="b"]; }
    w [label="c"];
    { rank=same; x [label="d"]; y [label="e"]; }
    z [label="f"];
    u -- v; u -- w; v -- w;
    x -- y; x -- z; y -- z;
    w -- x [style=invis];
  }
  d -- u [style=invis];
}
