digraph DFSBFS {
  graph [bgcolor="transparent", rankdir=TB, nodesep=0.25, ranksep=0.4, pad=0.04];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  a -> b [label="1.º"];
  a -> c [label="2.º"];
  b -> d;
  d -> e;
  c -> e;
  d -> a [constraint=false, style=dashed, label="volta\na a"];
  { rank=same; b; c; }
}
