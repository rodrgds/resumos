digraph ListasDiferenca {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.2, ranksep=0.25];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#292a30", fontcolor="#292a30", fontname="sans-serif", fontsize=16, margin="0.16,0.12"];
  edge [color="#292a30", arrowsize=0.7];

  abertas [label="[a,b|T]-T\nCauda aberta: T\n\n[c|U]-U\nCauda aberta: U"];
  ligar [label="Ligação por unificação\nT = [c|U]", color="#8c2d3b", fontcolor="#8c2d3b"];
  unidas [label="[a,b,c|U]-U\nCauda aberta: U"];
  fechar [label="Fechar a cauda\nU = []", color="#8c2d3b", fontcolor="#8c2d3b"];
  fechada [label="[a,b,c]-[]\nCauda fechada: []"];

  abertas -> ligar -> unidas -> fechar -> fechada;
}
