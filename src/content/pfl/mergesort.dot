digraph M {
  graph [bgcolor="transparent", ranksep=0.45];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial"];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial"];
  a [label="[4,1,3,1]"]; b [label="[4,1]"]; c [label="[3,1]"];
  d [label="[1,4]"]; e [label="[1,3]"]; f [label="[1,1,3,4]"];
  a -> b [label="dividir"]; a -> c; b -> d [label="ordenar"]; c -> e;
  d -> f [label="juntar"]; e -> f;
}
