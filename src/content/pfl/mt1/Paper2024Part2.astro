  },
  {
    n: 6,
    stem: 'Implement winningStreaks :: League -> [(String,Int,Int)], which returns a list of winning streaks, described by a triple (t,s,e), where:\n     t is the name of the team involved in the winning streak;\n     s and e are the indices of the streak\'s first and last matchday (with indices starting at 1).\nA winning streak is a sequence of wins in 2 or more consecutive matchdays.\nNote that the same team may have more than one winning streak and thus appear multiple times in the output. Any order of the\noutput list will be accepted.\nExamples:\nghci> winningStreaks myLeague\n[("Porto",2,3)]\nghci> winningStreaks [[(("RM","Barca"),(4,0))],[(("Barca","RM"),(1,2))],[(("RM","Barca"),(2,2))],[(("RM","Barca"),\n(0,4))],[(("Barca","RM"),(3,0))],[(("Barca","RM"),(3,1))]]\n[("RM",1,2),("Barca",4,6)]',
    starter:
      league +
      winner +
      'winningStreaks :: League -> [(String,Int,Int)]\nwinningStreaks = undefined',
    tests: [
      {
        name: 'Liga',
        code: 'main = print (winningStreaks myLeague)',
        output: '[("Porto",2,3)]',
      },
      { name: 'Vazia', code: 'main = print (winningStreaks [])', output: '[]' },
      {
        name: 'Duas equipas',
        code: 'main = print (let r = winningStreaks [[(("RM","Barca"),(4,0))],[(("Barca","RM"),(1,2))],[(("RM","Barca"),(2,2))],[(("RM","Barca"),(0,4))],[(("Barca","RM"),(3,0))],[(("Barca","RM"),(3,1))]] in (elem ("RM",1,2) r, elem ("Barca",4,6) r, length r))',
        output: '(True,True,2)',
      },
    ],
    solution:
      'unique [] = []\nunique (x:xs) = x : unique [y | y <- xs, y /= x]\nruns t [] = []\nruns t (i:is) = extend t i i is\nextend t s e (i:is) | i == e+1 = extend t s i is\nextend t s e rest = (if e > s then [(t,s,e)] else []) ++ runs t rest\nwinningStreaks l = concat [runs t [i | (i,d) <- zip [1..] l, m <- d, winner m == t] | t <- unique [t | d <- l, ((h,a),_) <- d, t <- [h,a]]]\n\nAgrupa, para cada equipa, índices consecutivos de vitórias e descarta grupos de uma só jornada.',
  },
  {
    n: 7,
    stem: 'Implement adjacent :: RoadMap -> City ->[(City,Distance)], which returns the cities adjacent to a particular city (i.e. cities with a\ndirect edge between them) and the respective distances to them. Any order of the output list will be accepted. Note that a city is\nNOT adjacent to itself.\nExamples:\nghci> adjacent gTest1 "0"\n[("1",10),("2",15),("3",20)]\nghci> adjacent gTest2 "0"\n[("1",4)]',
    starter:
