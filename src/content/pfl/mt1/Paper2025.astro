---
import Exercise from '../../../components/Exercise.astro';
import ExerciseText from '../../../components/ExerciseText.astro';
import CodeSnippet from '../../../components/CodeSnippet.astro';
import type { CodeAnswer } from '../../../lib/code-exercise';
type Question = {
  n: number;
  title: string;
  stem: string;
  answer:
    | CodeAnswer
    | {
        kind: 'choice';
        options: { text: string; correct: boolean; explanation: string }[];
      };
  solution: string;
  solutionCode?: string;
};
const questions: Question[] = [
  {
    n: 1,
    title: 'Procurar os atores de um filme',
    stem: 'Cada `Movie` é um par com o título e uma lista ordenada de atores. Podes usar `delAll`, que remove todas as ocorrências, e `uniqueVals`, que remove repetidos mantendo a primeira ocorrência. Implemente `findActors :: [Movie] -> String -> Maybe [String]`. Devolva os atores do filme com o título indicado, ou `Nothing` se não existir.',
    answer: {
      kind: 'code',
      language: 'haskell',
      starter:
        'type Movie = (String, [String])\nmyMovies :: [Movie]\nmyMovies = [("Titanic",["Kate Winslet","Leonardo DiCaprio"]),("Revolutionary Road",["Kate Winslet","Leonardo DiCaprio"]),("Elektra ",["Jennifer Garner"]),("The Great Gatsby",["Leonardo DiCaprio"])]\ndelAll :: Eq a => a -> [a] -> [a]\ndelAll x = filter (/= x)\nuniqueVals :: Eq a => [a] -> [a]\nuniqueVals [] = []\nuniqueVals (x:xs) = x : uniqueVals (delAll x xs)\nfindActors :: [Movie] -> String -> Maybe [String]\nfindActors = undefined',
      tests: [
        {
          name: 'Existe',
          code: 'main = print (findActors [("A",["X","Y"])] "A")',
          output: 'Just ["X","Y"]',
        },
        {
          name: 'Ausente',
          code: 'main = print (findActors [] "A")',
          output: 'Nothing',
        },
      ],
    },
    solution:
      'lookup title movies procura o primeiro par com esse título. A ausência é representada por Nothing.',
    solutionCode: 'findActors movies title = lookup title movies',
  },
  {
    n: 2,
    title: 'Selecionar filmes por ator',
    stem: 'Cada `Movie` é um par com o título e uma lista ordenada de atores. Podes usar `delAll`, que remove todas as ocorrências, e `uniqueVals`, que remove repetidos mantendo a primeira ocorrência. Implemente `moviesWithActor :: [Movie] -> String -> [Movie]`, preservando a ordem dos filmes em que o ator participou.',
    answer: {
      kind: 'code',
      language: 'haskell',
      starter:
        'type Movie = (String, [String])\nmyMovies :: [Movie]\nmyMovies = [("Titanic",["Kate Winslet","Leonardo DiCaprio"]),("Revolutionary Road",["Kate Winslet","Leonardo DiCaprio"]),("Elektra ",["Jennifer Garner"]),("The Great Gatsby",["Leonardo DiCaprio"])]\ndelAll :: Eq a => a -> [a] -> [a]\ndelAll x = filter (/= x)\nuniqueVals :: Eq a => [a] -> [a]\nuniqueVals [] = []\nuniqueVals (x:xs) = x : uniqueVals (delAll x xs)\nmoviesWithActor :: [Movie] -> String -> [Movie]\nmoviesWithActor = undefined',
      tests: [
        {
          name: 'Ordem',
          code: 'main = print (moviesWithActor [("A",["X"]),("B",[]),("C",["X"])] "X")',
          output: '[("A",["X"]),("C",["X"])]',
        },
        {
          name: 'Vazia',
          code: 'main = print (moviesWithActor [] "X")',
          output: '[]',
        },
      ],
    },
    solution:
      '`filter` preserva a ordem dos filmes e `elem` verifica a participação do ator.',
    solutionCode:
      'moviesWithActor movies actor = filter (elem actor . snd) movies',
  },
  {
    n: 3,
    title: 'Reunir atores sem repetidos',
    stem: 'Cada `Movie` é um par com o título e uma lista ordenada de atores. Podes usar `delAll`, que remove todas as ocorrências, e `uniqueVals`, que remove repetidos mantendo a primeira ocorrência. Implemente `uniqueActors :: [Movie] -> [String]`, sem repetidos e pela ordem da primeira ocorrência.',
    answer: {
      kind: 'code',
      language: 'haskell',
      starter:
        'type Movie = (String, [String])\nmyMovies :: [Movie]\nmyMovies = [("Titanic",["Kate Winslet","Leonardo DiCaprio"]),("Revolutionary Road",["Kate Winslet","Leonardo DiCaprio"]),("Elektra ",["Jennifer Garner"]),("The Great Gatsby",["Leonardo DiCaprio"])]\ndelAll :: Eq a => a -> [a] -> [a]\ndelAll x = filter (/= x)\nuniqueVals :: Eq a => [a] -> [a]\nuniqueVals [] = []\nuniqueVals (x:xs) = x : uniqueVals (delAll x xs)\nuniqueActors :: [Movie] -> [String]\nuniqueActors = undefined',
      tests: [
        {
          name: 'Repetidos',
          code: 'main = print (uniqueActors [("A",["X","Y"]),("B",["Y","Z"])])',
          output: '["X","Y","Z"]',
        },
        {
          name: 'Vazia',
          code: 'main = print (uniqueActors [])',
          output: '[]',
        },
      ],
    },
    solution:
      '`concatMap snd` concatena as listas de atores e `uniqueVals` remove as ocorrências posteriores.',
    solutionCode: 'uniqueActors = uniqueVals . concatMap snd',
  },
  {
    n: 4,
    title: 'Contar filmes por ator',
    stem: 'Cada `Movie` é um par com o título e uma lista ordenada de atores. Podes usar `delAll`, que remove todas as ocorrências, e `uniqueVals`, que remove repetidos mantendo a primeira ocorrência. Implemente `actorFrequencies :: [Movie] -> [(String, Int)]`, contando filmes por ator e mantendo a ordem da primeira ocorrência, sem ordenar por frequência.',
    answer: {
      kind: 'code',
      language: 'haskell',
      starter:
        'type Movie = (String, [String])\nmyMovies :: [Movie]\nmyMovies = [("Titanic",["Kate Winslet","Leonardo DiCaprio"]),("Revolutionary Road",["Kate Winslet","Leonardo DiCaprio"]),("Elektra ",["Jennifer Garner"]),("The Great Gatsby",["Leonardo DiCaprio"])]\ndelAll :: Eq a => a -> [a] -> [a]\ndelAll x = filter (/= x)\nuniqueVals :: Eq a => [a] -> [a]\nuniqueVals [] = []\nuniqueVals (x:xs) = x : uniqueVals (delAll x xs)\nactorFrequencies :: [Movie] -> [(String, Int)]\nactorFrequencies = undefined',
      tests: [
        {
          name: 'Um filme conta uma vez',
          code: 'main = print (actorFrequencies [("A",["X","X","Y"]),("B",["Y"])])',
          output: '[("X",1),("Y",2)]',
        },
        {
          name: 'Vazia',
          code: 'main = print (actorFrequencies [])',
          output: '[]',
        },
      ],
    },
    solution:
      'Para cada ator distinto, conta os filmes que o contêm; repetições no mesmo filme não acrescentam filmes. A contagem considera cada filme uma única vez.',
    solutionCode:
      'actorFrequencies ms = [(a, length [() | (_,as) <- ms, a `elem` as]) | a <- uniqueVals (concatMap snd ms)]',
  },
  {
    n: 5,
    title: 'Propriedades das classes de tipos',
    stem: 'Qual das seguintes afirmações sobre typeclasses está errada?',
    answer: {
      kind: 'choice',
      options: [
        {
          text: '`` Ord é uma typeclass para tipos que suportam o operador <=. ``',
          correct: false,
          explanation: '`Ord` disponibiliza comparação ordenada.',
        },
        {
          text: 'Eq é uma subclasse de Ord.',
          correct: true,
          explanation:
            'É `Ord` que exige `Eq` como superclasse, e não o inverso.',
        },
        {
          text: 'Float faz parte da typeclass Fractional.',
          correct: false,
          explanation: '`Float` é instância de Fractional.',
        },
        {
          text: 'Int faz parte da typeclass Integral.',
          correct: false,
          explanation: '`Int` é instância de `Integral`.',
        },
        {
          text: 'Um tipo pode pertencer a três typeclasses diferentes.',
          correct: false,
          explanation: 'Um tipo pode ser instância de várias classes.',
        },
      ],
    },
    solution: 'Ord exige Eq como superclasse; a afirmação inversa está errada.',
  },
  {
    n: 6,
    title: 'Tipo de uma compreensão com índices',
    stem: 'Indique um tipo possível para `` [ (n, x, x !! n) | n <- ls ] ``.',
    answer: {
      kind: 'choice',
      options: [
        {
          text: '`` [(Int, [Char], [Char])] ``',
          correct: false,
          explanation: 'Indexar [`Char`] devolve `Char`, não [`Char`].',
        },
        {
          text: '`` ([Int], [String], String) ``',
          correct: false,
          explanation: 'A compreensão devolve uma lista de triplos.',
        },
        {
          text: '`` [(Int, [Int], Int)] ``',
          correct: true,
          explanation: 'O índice é `Int` e indexar [`Int`] devolve `Int`.',
        },
        {
          text: '`` [(Int, String, String)] ``',
          correct: false,
          explanation: 'Indexar `String` devolve `Char`, não `String`.',
        },
      ],
    },
    solution:
      'O índice de (!!) é Int e o resultado tem o tipo de um elemento da lista.',
  },
  {
    n: 7,
    title: 'Contar elementos por decrementos',
    stem: 'Reimplemente `funcX = foldl (\\acc _ -> pred acc) 0` sem usar funções da família dos folds, incluindo `foldr`, `foldl`, `foldr1` e `scanr`.',
    answer: {
      kind: 'code',
      language: 'haskell',
      starter: 'funcX :: [a] -> Int\nfuncX = undefined',
      tests: [
        {
          name: 'Vazia',
          code: 'main = print (funcX ([] :: [Int]))',
          output: '0',
        },
        {
          name: 'Três',
          code: 'main = print (funcX [1,2,3])',
          output: '-3',
        },
      ],
    },
    solution: 'Cada elemento decrementa uma vez; a lista vazia começa em zero.',
    solutionCode: 'funcX [] = 0\nfuncX (_:xs) = pred (funcX xs)',
  },
  {
    n: 8,
    title: 'Comparar elementos em posições pares',
    stem: "Usando `zip`, defina `evenPos` para duas listas possivelmente de comprimentos diferentes. Devolva pares de elementos diferentes nas mesmas posições pares, contadas a partir de zero. Exemplos: `` evenPos [1,2,3,4,5] [5,4,3,2,1] = [(1,5),(5,1)]; evenPos \"banana\" \"batata\" = [('n','t'),('n','t')] ``.",
    answer: {
      kind: 'code',
      language: 'haskell',
      starter: 'evenPos :: Eq a => [a] -> [a] -> [(a,a)]\nevenPos = undefined',
      tests: [
        {
          name: 'Exemplo',
          code: 'main = print (evenPos [1,2,3,4,5] [5,4,3,2,1])',
          output: '[(1,5),(5,1)]',
        },
        {
          name: 'Comprimentos',
          code: 'main = print (evenPos [1,2,3] [9])',
          output: '[(1,9)]',
        },
      ],
    },
    solution:
      'zip termina na lista mais curta; o índice seleciona posições pares e x /= y exclui valores iguais.',
    solutionCode:
      'evenPos xs ys = [(x,y) | (i,(x,y)) <- zip [0..] (zip xs ys), even i, x /= y]',
  },
  {
    n: 9,
    title: 'Gerar uma sequência por recorrência',
    stem: 'Defina a lista infinita `list` para a₀ = 0, a₁ = 1, aₙ = 3 × aₙ₋₁ − 2 × aₙ₋₂ para n > 1. Segue a recorrência para calcular os termos.',
    answer: {
      kind: 'code',
      language: 'haskell',
      starter: 'list :: [Integer]\nlist = undefined',
      tests: [
        {
          name: 'Primeiros termos',
          code: 'main = print (take 6 list)',
          output: '[0,1,3,7,15,31]',
        },
        {
          name: 'Prefixo vazio',
          code: 'main = print (take 0 list)',
          output: '[]',
        },
      ],
    },
    solution:
      'A recorrência produz 0, 1, 3, 7, 15, 31. zipWith combina cada par de termos consecutivos.',
    solutionCode:
      'list = 0 : 1 : zipWith (\\a b -> 3*b - 2*a) list (tail list)',
  },
  {
    n: 10,
    title: 'Avaliar proposições lógicas',
    stem: 'Considere `` data Prop = Const Bool | Neg Prop | Conj Prop Prop | Disj Prop Prop | Impl Prop Prop ``. Defina recursivamente `valor :: Prop -> Bool` para calcular o valor lógico.',
    answer: {
      kind: 'code',
      language: 'haskell',
      starter:
        'data Prop = Const Bool | Neg Prop | Conj Prop Prop | Disj Prop Prop | Impl Prop Prop\nvalor :: Prop -> Bool\nvalor = undefined',
      tests: [
        {
          name: 'Implicação falsa',
          code: 'main = print (valor (Impl (Const True) (Const False)))',
          output: 'False',
        },
        {
          name: 'Expressão',
          code: 'main = print (valor (Conj (Neg (Const False)) (Disj (Const False) (Const True))))',
          output: 'True',
        },
      ],
    },
    solution:
      'A avaliação segue os construtores. A implicação p → q equivale a não p ou q.',
    solutionCode:
      'valor (Const b) = b\nvalor (Neg p) = not (valor p)\nvalor (Conj p q) = valor p && valor q\nvalor (Disj p q) = valor p || valor q\nvalor (Impl p q) = not (valor p) || valor q',
  },
];
---

{questions.map((q) => (
  <Exercise
    id={`mt1-2025-q${q.n}`}
    title={q.title}
    explanation="/cadeiras/pfl/listas-recursao/#construir-e-percorrer"
    answer={q.answer}
  >
    <p>
      <ExerciseText text={q.stem} />
    </p>
    <div slot="solution">
      {q.solutionCode && (
        <CodeSnippet language="haskell" code={q.solutionCode} />
      )}
      <p>
        <ExerciseText text={q.solution} />
      </p>
    </div>
  </Exercise>
))}
