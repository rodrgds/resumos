---
import Exercise from '../../../components/Exercise.astro';
import ExerciseText from '../../../components/ExerciseText.astro';
import CodeSnippet from '../../../components/CodeSnippet.astro';
import type { PrologQuestion } from './questions';
interface Props {
  questions: PrologQuestion[];
}
const { questions } = Astro.props;
---

{questions.map((q) => (
  <Exercise
    id={q.id}
    title={q.title}
    explanation={q.explanation}
    restriction={q.restriction}
    answer={q.answer}
  >
    {q.context && (
      <p>
        <ExerciseText text={q.context} />
      </p>
    )}
    {q.definitions && <CodeSnippet language="prolog" code={q.definitions} />}
    <p>
      <ExerciseText text={q.prompt} />
    </p>
    {q.figures?.map((figure) => (
      <figure class="question-figure">
        <figcaption>{figure.label}</figcaption>
        <div
          class="diagram-figure"
          role="img"
          aria-label={figure.alt}
          tabindex="0"
          set:html={figure.svg}
        />
      </figure>
    ))}
    <div slot="solution">
      {q.solution &&
        (q.answer.kind === 'code' ? (
          <CodeSnippet language="prolog" code={q.solution} />
        ) : (
          <p>
            <ExerciseText text={q.solution} />
          </p>
        ))}
      <p>
        <ExerciseText text={q.reasoning} />
      </p>
    </div>
  </Exercise>
))}

<style>
  .question-figure {
    margin-inline: 0;
  }
  .question-figure figcaption {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .question-figure .diagram-figure {
    overflow-x: auto;
    color: var(--text);
  }
  .question-figure :global(svg) {
    display: block;
    max-width: none;
    height: auto;
  }
  .question-figure .diagram-figure:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
