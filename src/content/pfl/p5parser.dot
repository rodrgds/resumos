digraph Parser {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [color="#8c2d3b", fontcolor="#8c2d3b", fontname="Arial", fontsize=13];
  expr -> term [label="soma"];
  expr -> expr [label=" + "];
  term -> factor [label="produto"];
  term -> term [label=" * "];
  factor -> expr [label="()"];
  factor -> nat;
  nat -> many1;
  many1 -> digit;
}
