digraph Procura {
  graph [bgcolor="transparent", rankdir=TB, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=15];
  edge [color="#8c2d3b", fontcolor="#8c2d3b", fontname="Arial", fontsize=13];
  query [label="?- avo(ana, X)."];
  regra [label="avo(X, Z) :- pai(X, Y), pai(Y, Z)"];
  g1 [label="pai(ana, Y)"];
  f1 [label="pai(ana, leo)"];
  g2 [label="pai(leo, X)"];
  f2 [label="pai(leo, rui)"];
  ok [label="X = rui", shape=circle];
  query -> regra [label="unifica"];
  regra -> g1;
  g1 -> f1 [label="Y = leo"];
  f1 -> g2;
  g2 -> f2 [label="X = rui"];
  f2 -> ok;
  resto [label="; sem alternativas", style="rounded,dashed"];
  g1 -> resto [style=dashed, label="retrocesso"];
}
