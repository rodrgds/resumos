digraph Labirinto {
  graph [bgcolor="transparent", rankdir=LR, pad=0.2];
  node [shape=circle, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
  edge [fontname="Arial", fontsize=13];
  a -> b [label="1", color="#8c2d3b", fontcolor="#8c2d3b"];
  b -> c [label="2", color="#8c2d3b", fontcolor="#8c2d3b"];
  c -> e [label="3", color="#8c2d3b", fontcolor="#8c2d3b"];
  b -> d [label="4", color="#28716c", fontcolor="#28716c"];
  d -> e [label="5", color="#28716c", fontcolor="#28716c"];
}
