digraph QuickCheck {
  graph [bgcolor="transparent", rankdir=TB, ranksep=0.35, nodesep=0.12];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=11];
  contrato [label="Escrever a\npropriedade"];
  gerar [label="Gerar uma\nentrada"];
  testar [label="Avaliar a\npropriedade"];
  passou [label="Passou\nContinuar ou\nterminar"];
  falhou [label="Reduzir\nSe há\nredutor"];
  comparar [label="Conferir o\ncontrato"];
  contrato -> gerar -> testar;
  testar -> passou [label="True"];
  testar -> falhou [label="False"];
  falhou -> comparar;
}
