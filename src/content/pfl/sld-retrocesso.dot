digraph SLD {
  graph [bgcolor="transparent", rankdir=TB, nodesep=0.1, ranksep=0.35];
  node [shape=box, style="rounded,filled", fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=11];
  inicio [label="avo(tomas,N)"];
  corpo [label="pai(tomas,Y1),\npai(Y1,N)"];
  falha [label="pai(ines,N)\nSem facto:\nfalha", style="rounded,dashed"];
  alternativa [label="pai(ana,N)"];
  sucesso [label="Resolvente\nvazio\nN = leo"];
  inicio -> corpo [label="X1=tomas\nZ1=N"];
  corpo -> falha [label="1. Y1=ines"];
  corpo -> alternativa [label="2. Y1=ana"];
  alternativa -> sucesso [label="N=leo"];
}
