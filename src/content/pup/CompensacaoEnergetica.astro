    </text>
    <text x="29" y="110" text-anchor="end">
      3
    </text>
    <text x="29" y="194" text-anchor="end">
      0
    </text>
    <text x="29" y="222" text-anchor="end">
      −1
    </text>
    <text x="40" y="242" text-anchor="middle">
      0
    </text>
    <text x="110" y="242" text-anchor="middle">
      1000
    </text>
    <text x="215" y="242" text-anchor="middle">
      2500
    </text>
    <text x="140" y="262" text-anchor="middle">
