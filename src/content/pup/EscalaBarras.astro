---
import InteractiveDemo from '../../components/InteractiveDemo.astro';
---

<InteractiveDemo label="Comparar barras com origens diferentes">
  <div data-bar-origin-demo>
    <label for="pup-bar-origin">
      Origem do eixo: <output>0,00 J</output>
      <input
        id="pup-bar-origin"
        type="range"
        min="0"
        max="0.79"
        step="0.01"
        value="0"
        aria-valuetext="0,00 J"
        disabled
      />
    </label>
    <svg
      viewBox="0 0 270 215"
      role="img"
      aria-label="Energias por leitura de 0,80 e 0,84 joules numa escala com origem ajustável"
    >
      <text x="0" y="20">
        A: 0,80 J
      </text>
      <text x="0" y="90">
        B: 0,84 J
      </text>
      <rect data-bar-a x="10" y="29" width="200" height="30" />
      <rect data-bar-b x="10" y="99" width="210" height="30" />
      <line x1="10" y1="155" x2="260" y2="155" />
      <line x1="10" y1="151" x2="10" y2="160" />
      <line x1="260" y1="151" x2="260" y2="160" />
      <text data-origin x="10" y="185">
        0,00 J
      </text>
      <text x="260" y="185" text-anchor="end">
        1,00 J
      </text>
    </svg>
    <p role="status" data-bar-result>
      Diferença real: 5%. Razão entre comprimentos visíveis: 1,05.
    </p>
  </div>
</InteractiveDemo>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-bar-origin-demo]')
    .forEach((root) => {
      const slider = root.querySelector('input')!;
      slider.disabled = false;
      const update = () => {
        const origin = Number(slider.value);
        const label = `${origin.toLocaleString('pt-PT', { minimumFractionDigits: 2 })} J`;
        slider.setAttribute('aria-valuetext', label);
        root.querySelector('output')!.textContent = label;
        root.querySelector('[data-origin]')!.textContent = label;
        root
          .querySelector('[data-bar-a]')!
          .setAttribute('width', String((250 * (0.8 - origin)) / (1 - origin)));
        root
          .querySelector('[data-bar-b]')!
          .setAttribute(
            'width',
            String((250 * (0.84 - origin)) / (1 - origin)),
          );
        const ratio = ((0.84 - origin) / (0.8 - origin)).toLocaleString(
          'pt-PT',
          {
            maximumFractionDigits: 2,
          },
        );
        root.querySelector('[data-bar-result]')!.textContent =
          `Diferença real: 5%. Razão entre comprimentos visíveis: ${ratio}.`;
      };
      slider.addEventListener('input', update);
      update();
    });
</script>

<style>
  label {
    display: block;
    font-weight: 600;
  }
  input {
    display: block;
    width: 100%;
    min-height: 44px;
    accent-color: var(--accent);
  }
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin-top: 12px;
  }
  text {
    fill: var(--text);
    font:
      18px 'Manrope Variable',
      sans-serif;
  }
  line {
    stroke: var(--muted);
  }
  [data-bar-a] {
    fill: var(--accent);
  }
  [data-bar-b] {
    fill: var(--muted);
  }
  p {
    margin: 4px 0 0;
  }
</style>
