---
import InteractiveDemo from '../../components/InteractiveDemo.astro';
---

<InteractiveDemo label="Comparar barras com origens diferentes">
  <div data-bar-origin-demo>
    <label for="pup-bar-origin">
      Origem do eixo: <output>0 W</output>
      <input
        id="pup-bar-origin"
        type="range"
        min="0"
        max="79"
        step="1"
        value="0"
      />
    </label>
    <svg
      viewBox="0 0 440 175"
      role="img"
      aria-label="Consumos de 80 e 84 watts numa escala com origem ajustável"
    >
      <text x="0" y="27">
        A: 80 W
      </text>
      <text x="0" y="90">
        B: 84 W
      </text>
      <rect data-bar-a x="90" y="6" width="264" height="32" />
      <rect data-bar-b x="90" y="69" width="277.2" height="32" />
      <line x1="90" y1="126" x2="420" y2="126" />
      <line x1="90" y1="122" x2="90" y2="131" />
      <line x1="420" y1="122" x2="420" y2="131" />
      <text data-origin x="90" y="153">
        0 W
      </text>
      <text x="420" y="153" text-anchor="end">
        100 W
      </text>
    </svg>
    <p role="status" data-bar-result>
      Diferença real: 5%. Razão entre comprimentos visíveis: 1,05.
    </p>
  </div>
</InteractiveDemo>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-bar-origin-demo]')
    .forEach((root) => {
      const slider = root.querySelector('input')!;
      const update = () => {
        const origin = Number(slider.value);
        root.querySelector('output')!.textContent = `${origin} W`;
        root.querySelector('[data-origin]')!.textContent = `${origin} W`;
        root
          .querySelector('[data-bar-a]')!
          .setAttribute(
            'width',
            String((330 * (80 - origin)) / (100 - origin)),
          );
        root
          .querySelector('[data-bar-b]')!
          .setAttribute(
            'width',
            String((330 * (84 - origin)) / (100 - origin)),
          );
        const ratio = ((84 - origin) / (80 - origin)).toLocaleString('pt-PT', {
          maximumFractionDigits: 2,
        });
        root.querySelector('[data-bar-result]')!.textContent =
          `Diferença real: 5%. Razão entre comprimentos visíveis: ${ratio}.`;
      };
      slider.addEventListener('input', update);
      update();
    });
</script>

<style>
  label {
    display: block;
    font-weight: 600;
  }
  input {
    display: block;
    width: 100%;
    min-height: 44px;
    accent-color: var(--accent);
  }
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 12px;
  }
  text {
    fill: var(--text);
    font:
      18px 'Manrope Variable',
      sans-serif;
  }
  line {
    stroke: var(--muted);
  }
  [data-bar-a] {
    fill: var(--accent);
  }
  [data-bar-b] {
    fill: var(--muted);
  }
  p {
    margin: 4px 0 0;
  }
</style>
