---
const a = [0.79, 0.81, 0.8, 0.78, 0.82];
const b = [0.83, 0.85, 0.84, 0.82, 0.86];
const x = (value: number) => 42 + ((value - 0.78) / 0.08) * 180;
---

<figure
  class="diagram-figure"
  role="img"
  aria-label="A varia de 0,78 a 0,82 J, com média 0,80 J. B varia de 0,82 a 0,86 J, com média 0,84 J. As duas amplitudes são 0,04 J."
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="var(--text)"
    style="font: 16px sans-serif"
    viewBox="0 0 264 200"
    role="img"
    aria-label="A varia de 0,78 a 0,82 J, com média 0,80 J. B varia de 0,82 a 0,86 J, com média 0,84 J. As duas amplitudes são 0,04 J."
  >
    <text x="8" y="24">
      Energia por leitura (J)
    </text>
    <text x="8" y="65">
      A
    </text>
    <text x="8" y="115">
      B
    </text>
    <line
      stroke="var(--muted, var(--text))"
      x1={x(0.78)}
      y1="59"
      x2={x(0.82)}
      y2="59"
    />
    <line
      stroke="var(--muted, var(--text))"
      x1={x(0.82)}
      y1="109"
      x2={x(0.86)}
      y2="109"
    />
    {a.map((value) => (
      <circle fill="var(--accent)" cx={x(value)} cy="59" r="5" />
    ))}
    {b.map((value) => (
      <circle fill="var(--accent)" cx={x(value)} cy="109" r="5" />
    ))}
    <path
      d={`M ${x(0.8)} 49 v 20 M ${x(0.84)} 99 v 20`}
      class="mean"
      fill="none"
      stroke="var(--text)"
      stroke-width="3"
    />
    <line
      stroke="var(--muted, var(--text))"
      x1="42"
      y1="143"
      x2="222"
      y2="143"
    />
    {[0.78, 0.82, 0.86].map((value) => (
      <>
        <line
          stroke="var(--muted, var(--text))"
          x1={x(value)}
          y1="139"
          x2={x(value)}
          y2="148"
        />
        <text x={x(value)} y="171" text-anchor="middle">
          {value.toFixed(2).replace('.', ',')}
        </text>
      </>
    ))}
  </svg>
  <figcaption>
    Os pontos são as leituras; o traço vertical marca a média. A linha liga o
    mínimo ao máximo, não é um intervalo de confiança.
  </figcaption>
</figure>

<style>
  .diagram-figure {
    padding: 0;
    background: none;
    overflow: visible;
    margin: 24px 0;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
  }
  text {
    fill: var(--text);
    font: 16px var(--reading-font);
  }
  line {
    stroke: var(--muted);
    stroke-width: 1;
  }
  circle {
    fill: var(--accent);
  }
  .mean {
    stroke: var(--text);
    stroke-width: 3;
  }
  figcaption {
    color: var(--muted);
    font-size: 0.9em;
  }
</style>
