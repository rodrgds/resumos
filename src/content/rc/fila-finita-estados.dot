digraph FilaFinita {
  graph [rankdir=TB, pad=0.05, fontsize=11, label="λ: chegada\nμ: serviço", labelloc=b];
  node [shape=box, fontsize=12, margin="0.08,0.05"];
  edge [fontsize=11];
  vazio [label="0 pacotes\nServidor livre"];
  um [label="1 pacote\nEm serviço"];
  dois [label="2 pacotes\n1 em serviço\n1 em espera"];
  vazio -> um [label="λ"];
  um -> dois [label="λ"];
  um -> vazio [label="μ"];
  dois -> um [label="μ"];
  dois -> dois [label="λ\nrejeitada"];
}
