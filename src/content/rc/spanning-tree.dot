graph {
  rankdir=TB;
  node [shape=box];
  A [label="A · ID 1\nraiz"];
  B [label="B · ID 2\ncusto à raiz: 1"];
  C [label="C · ID 3\ncusto à raiz: 1"];
  A -- B [label="custo 1", penwidth=2];
  A -- C [label="custo 1", penwidth=2];
  {rank=same; B; C;}
  B -- C [label="custo 1\nbloqueada em C", style=dashed];
}
