digraph StopAndWait {
  rankdir=LR;
  node [shape=box, style=rounded];
  inicio [shape=point, label=""];
  espera1 [label="Esperar RR(1)"];
  espera0 [label="Esperar RR(0)"];
  inicio -> espera1 [label="Enviar I(0)"];
  espera1 -> espera1 [label="Timeout: retransmitir I(0)"];
  espera1 -> espera0 [label="RR(1): enviar I(1)"];
  espera0 -> espera0 [label="Timeout: retransmitir I(1)"];
  espera0 -> espera1 [label="RR(0): enviar I(0)"];
}
