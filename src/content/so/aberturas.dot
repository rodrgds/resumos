digraph Aberturas {
  graph [bgcolor="transparent", rankdir=TB, pad=0.02, nodesep=0.12];
  node [shape=box, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=12];
  fd [label="fd = open(...)\nq = dup(fd)"];
  r [label="r = open(...)"];
  comum [label="Descrição\naberta A\nposição: 4"];
  outra [label="Descrição\naberta B\nposição: 0"];
  inode [label="Mesmo inode\ndados: abcdef"];
  {rank=same; fd; r;}
  fd -> comum;
  r -> outra;
  comum -> inode;
  outra -> inode;
}
