digraph Impasse {
  graph [bgcolor="transparent", rankdir=TB, pad=0.15, nodesep=0.5, ranksep=0.65];
  node [style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=18];
  X [shape=box, label="Lock X"];
  A [shape=circle, label="Tarefa A"];
  B [shape=circle, label="Tarefa B"];
  Y [shape=box, label="Lock Y"];
  { rank=same; X; A; }
  { rank=same; B; Y; }
  edge [fontcolor="#292a30", fontname="Arial", fontsize=16, penwidth=2];
  X -> A [label="atribuição", color="#8c2d3b", constraint=false];
  A -> Y [label="pedido", color="#28716c", style=dashed];
  Y -> B [label="atribuição", color="#8c2d3b", constraint=false];
  B -> X [label="pedido", color="#28716c", style=dashed];
}
