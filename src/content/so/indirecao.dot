digraph Indirecao {
 graph [bgcolor="transparent", rankdir=TB, pad=0.2];
 node [shape=box, style=filled, fillcolor="#f3e9e9", color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=16];
 edge [color="#8c2d3b", fontcolor="#292a30", fontname="Arial", fontsize=14];
 inode [label="Inode em RAM\nindireto duplo"];
 topo [label="Índice de topo\n1024 apontadores"];
 interior [label="Índice interior 0\n1024 apontadores"];
 dados [label="Bloco de dados\níndice lógico 1040"];
 inode -> topo [label="leitura 1"];
 topo -> interior [label="entrada 0 · leitura 2"];
 interior -> dados [label="entrada 4 · leitura 3"];
}