digraph {
  rankdir=TB;
  graph [ranksep=0.3, nodesep=0.12];
  node [shape=circle];
  start [shape=point];
  f [shape=doublecircle];
  start -> p;
  p -> p [label="a,Z/AZ\na,A/AA"];
  p -> q [label="b,A/ε"];
  p -> r [label="c,A/ε", minlen=2];
  q -> q [label="b,A/ε"];
  r -> r [label="c,A/ε"];
  q -> f [label="ε,Z/Z", minlen=2];
  r -> f [label="ε,Z/Z"];
}
