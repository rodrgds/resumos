---
import '@fontsource-variable/manrope';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import '../styles/tools.css';
import '../styles/notebook.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StudyTools from '../components/StudyTools.astro';
import preferences from '../scripts/preferences.ts?raw';
import { transform } from 'esbuild';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Resumos LEIC · FEUP',
  description = 'Um lugar para os apontamentos de LEIC da FEUP. Encontra as cadeiras por ano e semestre e ajuda a construir os primeiros resumos.',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const { code } = await transform(preferences, { loader: 'ts', minify: true });
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8c2d3b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <link rel="canonical" href={canonicalUrl.href} />
    <title>{title}</title>
    <script is:inline set:html={code}></script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Saltar para o conteúdo
    </a>
    <Header />
    <slot />
    <Footer />
    <StudyTools />
  </body>
</html>
