---
import '@fontsource-variable/manrope';
import '@fontsource-variable/source-serif-4';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import sourceSerifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '../styles/global.css';
import '../styles/tools.css';
import '../styles/fonts.css';
import '../styles/code.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StudyTools from '../components/StudyTools.astro';
import preferences from '../scripts/preferences.ts?raw';
import { build } from 'esbuild';
import { resolve } from 'node:path';
import { getReadingPages } from '../lib/reading-pages';
import { courses } from '../data/courses';
interface Props {
  title?: string;
  description?: string;
  preloadReadingFonts?: boolean;
}
const {
  title = 'Resumos LEIC · FEUP',
  description = 'Um lugar para os apontamentos de LEIC da FEUP. Encontra as cadeiras por ano e semestre e ajuda a construir os primeiros resumos.',
  preloadReadingFonts = false,
} = Astro.props;
const enableOffline =
  import.meta.env.PROD && process.env.RESUMOS_TEST_CONTENT !== '1';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const readingPages =
  Astro.url.pathname === '/' ? await getReadingPages() : undefined;
const bundled = await build({
  stdin: {
    contents: preferences,
    loader: 'ts',
    resolveDir: resolve('src/scripts'),
  },
  bundle: true,
  write: false,
  minify: true,
  platform: 'browser',
});
const code = bundled.outputFiles[0].text;
const snippets = await build({
  stdin: {
    contents:
      "import { applySnippets } from './css-snippets'; applySnippets();",
    resolveDir: resolve('src/lib'),
  },
  bundle: true,
  write: false,
  minify: true,
  platform: 'browser',
});
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8c2d3b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/webp" href="/logos/feup-color-favicon.webp" />
    {preloadReadingFonts && (
      <>
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={manropeFont}
          crossorigin
        />
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={sourceSerifFont}
          crossorigin
        />
      </>
    )}
    <link
      rel="alternate"
      type="text/markdown"
      title="Markdown"
      href={
        new URL(
          Astro.url.pathname === '/'
            ? '/index.md'
            : Astro.url.pathname.replace(/\/$/, '') + '.md',
          Astro.site,
        ).href
      }
    />
    <title>{title}</title>
    <slot name="head" />
    {readingPages && (
      <>
        <script
          is:inline
          type="application/json"
          id="pinnable-semesters"
          set:html={JSON.stringify([
            ...new Set(
              courses.map((course) => `${course.year}-${course.semester}`),
            ),
          ])}
        ></script>
        <script
          is:inline
          type="application/json"
          id="reading-pages"
          set:html={JSON.stringify(readingPages).replaceAll('<', '\\u003c')}
        ></script>
      </>
    )}
    <script is:inline set:html={code}></script>
  </head>
  <body>
    <!-- After Astro's head styles, before any visible content. -->
    <script is:inline set:html={snippets.outputFiles[0].text}></script>
    {enableOffline && <script is:inline>
      window.addEventListener(
        'load',
        () => {
          if ('serviceWorker' in navigator)
            navigator.serviceWorker
              .register('/sw.js', { scope: '/' })
              .catch(() => {});
        },
        { once: true },
      );
    </script>}
    <a class="skip-link" href="#conteudo">
      Saltar para o conteúdo
    </a>
    <Header />
    <slot />
    <Footer />
    <StudyTools />
  </body>
</html>
