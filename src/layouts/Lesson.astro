---
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import Prose from '../components/Prose.astro';
import PageActions from '../components/PageActions.astro';
import CourseSidebar from '../components/CourseSidebar.astro';
import Icon from '../components/Icon.astro';
import CourseProgress from '../components/CourseProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import EditorialNote from '../components/EditorialNote.astro';
import StudyLinks from '../components/StudyLinks.astro';
import katexAmsFont from 'katex/dist/fonts/KaTeX_AMS-Regular.woff2?url';
import katexMainFont from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMathFont from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexSizeFont from 'katex/dist/fonts/KaTeX_Size4-Regular.woff2?url';
import {
  lessonPath,
  type CourseGuide,
  type Lesson,
} from '../lib/course-content';
import '../styles/reading.css';
import '../styles/study.css';
interface Props {
  course: CourseGuide;
  entry?: Lesson;
  headings?: MarkdownHeading[];
}
const { course, entry, headings = [] } = Astro.props;
const title = entry?.data.title || course.name;
const description =
  entry?.data.description || `Apontamentos de ${course.name}.`;
const index = course.lessons.findIndex((page) => page.id === entry?.id);
const previous = index > 0 ? course.lessons[index - 1] : undefined;
const overview = !entry || entry.id === course.introduction?.id;
const next =
  index >= 0
    ? course.lessons[index + 1]
    : overview
      ? course.lessons[0]
      : undefined;
---

<Layout
  title={`${title} · ${course.name}`}
  description={description}
  preloadReadingFonts
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexAmsFont}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexMainFont}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexMathFont}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexSizeFont}
      crossorigin
    />
  </Fragment>
  <div class="course-shell">
    <div class="reader-navigation" data-pagefind-ignore>
      <a href={course.path} class="reader-course">
        {course.name}
      </a>
      <CourseSidebar course={course} headings={headings} />
      <CourseProgress course={course} />
    </div>
    <main
      id="conteudo"
      class:list={[
        'course-article',
        { 'revision-sheet': entry?.data.studyKind === 'revision' },
      ]}
      data-pagefind-body
      data-reading-page
    >
      <header class="lesson-heading">
        <h1>{title}</h1>
        <p>{description}</p>
        <EditorialNote
          editorial={entry?.data.editorial}
          example={course.example}
        />
      </header>
      <PageActions />
      {overview && <StudyLinks course={course} entry={entry} />}
      {entry?.data.studyKind === 'revision' && (
        <a
          class="sheet-print-link"
          href={`${course.path}imprimir/`}
          data-pagefind-ignore
        >
          Imprimir esta folha ou preparar um caderno
        </a>
      )}
      <div class="lesson-body" data-annotatable>
        <Prose>
          <slot />
        </Prose>
      </div>
      {!overview && <StudyLinks course={course} entry={entry} />}
      {entry && (
        <a
          class="text-link lesson-source"
          href={`https://github.com/rodrgds/resumos/blob/main/${entry.filePath}`}
          data-pagefind-ignore
        >
          Ver o ficheiro no GitHub <Icon name="arrow-up-right" size={17} />
        </a>
      )}
      <nav
        class="lesson-pagination"
        aria-label="Continuar a leitura"
        data-pagefind-ignore
      >
        {index >= 0 && (
          <a href={previous ? lessonPath(course, previous) : course.path}>
            <Icon name="arrow-left" size={17} />
            <span>
              <small>Anterior</small>
              {previous?.data.title || 'Apresentação'}
            </span>
          </a>
        )}
        {next && (
          <a class="next-lesson" href={lessonPath(course, next)}>
            <span>
              <small>Seguinte</small>
              {next.data.title}
            </span>
            <Icon name="arrow-right" size={17} />
          </a>
        )}
      </nav>
    </main>
    {headings.length > 0 && (
      <aside
        class="page-sections"
        aria-label="Secções desta página"
        data-pagefind-ignore
      >
        <p class="progress-label">Nesta página</p>
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
</Layout>

<script>
  import '../scripts/reading-progress';
  import '../scripts/section-navigation';
</script>
