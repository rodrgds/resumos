---
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import Prose from '../components/Prose.astro';
import PageActions from '../components/PageActions.astro';
import CourseSidebar from '../components/CourseSidebar.astro';
import Icon from '../components/Icon.astro';
import CourseProgress from '../components/CourseProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PrintPage from '../components/PrintPage.astro';
import katexAmsFont from 'katex/dist/fonts/KaTeX_AMS-Regular.woff2?url';
import katexMainFont from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMathFont from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexSizeFont from 'katex/dist/fonts/KaTeX_Size4-Regular.woff2?url';
import {
  lessonPath,
  type CourseGuide,
  type Lesson,
} from '../lib/course-content';
import '../styles/reading.css';
import '../styles/study.css';
interface Props {
  course: CourseGuide;
  entry?: Lesson;
  headings?: MarkdownHeading[];
}
const { course, entry, headings = [] } = Astro.props;
const title =
  entry?.data.studyKind === 'revision'
    ? 'Cheat sheet'
    : entry?.data.title || course.name;
const content = await Astro.slots.render('default');
const practices = await Astro.slots.render('practices');
const hasExercises = !!practices.trim();
const description =
  entry?.data.description || `Apontamentos de ${course.name}.`;
const index = course.lessons.findIndex((page) => page.id === entry?.id);
const previous = index > 0 ? course.lessons[index - 1] : undefined;
const overview = !entry || entry.id === course.introduction?.id;
const next =
  index >= 0
    ? course.lessons[index + 1]
    : overview
      ? course.lessons[0]
      : undefined;
---

<Layout
  title={`${title} · ${course.name}`}
  description={description}
  preloadReadingFonts
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexAmsFont}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexMainFont}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexMathFont}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={katexSizeFont}
      crossorigin
    />
  </Fragment>
  <div class="course-shell">
    <div class="reader-navigation" data-pagefind-ignore>
      <a href={course.path} class="reader-course">
        {course.name}
      </a>
      <CourseSidebar course={course} headings={headings} />
      <CourseProgress course={course} />
    </div>
    <main
      id="conteudo"
      class:list={[
        'course-article',
        { 'revision-sheet': entry?.data.studyKind === 'revision' },
      ]}
      data-pagefind-body
      data-reading-page
    >
      <header class="lesson-heading">
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <PageActions hasExercises={hasExercises} />
      <div class="lesson-body" data-annotatable>
        <Prose>
          <Fragment set:html={content} />
        </Prose>
      </div>
      {hasExercises && (
        <section
          class="lesson-practice"
          id="exercicios"
          aria-labelledby="practice-title"
        >
          <h2 id="practice-title">Exercícios</h2>
          <Prose>
            <Fragment set:html={practices} />
          </Prose>
        </section>
      )}
      <nav
        class="lesson-pagination"
        aria-label="Continuar a leitura"
        data-pagefind-ignore
      >
        {index >= 0 && (
          <a href={previous ? lessonPath(course, previous) : course.path}>
            <Icon name="arrow-left" size={17} />
            <span>
              <small>Anterior</small>
              {previous?.data.title || 'Apresentação'}
            </span>
          </a>
        )}
        {next && (
          <a class="next-lesson" href={lessonPath(course, next)}>
            <span>
              <small>Seguinte</small>
              {next.data.title}
            </span>
            <Icon name="arrow-right" size={17} />
          </a>
        )}
      </nav>
    </main>
    {headings.length > 0 && (
      <aside
        class="page-sections"
        aria-label="Secções desta página"
        data-pagefind-ignore
      >
        <p class="progress-label">Nesta página</p>
        <TableOfContents headings={headings} />
      </aside>
    )}
  </div>
  <PrintPage title={title} course={course.name}>
    <section data-print-entry={entry?.id || `${course.id}/index`}>
      <Fragment set:html={content} />
    </section>
    {hasExercises && (
      <section data-print-entry={`${entry?.id}-exercises`} data-print-practice>
        <h2>Exercícios</h2>
        <Fragment set:html={practices} />
      </section>
    )}
  </PrintPage>
</Layout>

<script>
  import '../scripts/reading-progress';
  import '../scripts/section-navigation';
</script>
