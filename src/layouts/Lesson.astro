---
import Layout from './Layout.astro';
import Prose from '../components/Prose.astro';
import PageActions from '../components/PageActions.astro';
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
interface Props {
  title?: string;
  description?: string;
  source?: string;
  frontmatter?: { title: string; description: string; source: string };
}
const metadata = Astro.props.frontmatter || Astro.props;
const { title, description, source } = metadata;
---

<Layout title={`${title} · Cadeira de exemplo`} description={description}>
  <main id="conteudo" class="container lesson-page" data-pagefind-body>
    <a class="text-link" href="/exemplo/">
      <ArrowLeft size={17} /> Cadeira de exemplo
    </a>
    <header class="page-heading">
      <h1>{title}</h1>
      <p>{description} Esta página pertence à cadeira fictícia de exemplo.</p>
    </header>
    <PageActions />
    <p class="annotation-hint" data-pagefind-ignore>
      Seleciona texto para destacar ou comentar. Encontras as tuas notas no{' '}
      <button data-action="notes">caderno</button>.
    </p>
    <div class="lesson-body" data-annotatable>
      <Prose>
        <slot />
      </Prose>
    </div>
    <a
      class="text-link"
      href={`https://github.com/rodrgds/resumos/blob/main/${source}`}
    >
      Ver o ficheiro no GitHub <ArrowUpRight size={17} />
    </a>
    <nav class="lesson-nav" aria-label="Páginas de exemplo">
      <a href="/exemplo/apontamentos/">Texto e fórmulas</a>
      <a href="/exemplo/diagramas/">Gráficos e diagramas</a>
    </nav>
  </main>
</Layout>
