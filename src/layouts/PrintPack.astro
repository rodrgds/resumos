---
import { render } from 'astro:content';
import Layout from './Layout.astro';
import Prose from '../components/Prose.astro';
import EditorialNote from '../components/EditorialNote.astro';
import StudyPack from '../components/StudyPack.astro';
import { lessonPath, type CourseGuide } from '../lib/course-content';
import '../styles/study.css';
interface Props {
  course: CourseGuide;
}
const { course } = Astro.props;
const rendered = await Promise.all(
  [...course.revisions, ...course.exercises].map(async (entry) => ({
    entry,
    ...(await render(entry)),
  })),
);
---

<Layout
  title={`Caderno de revisão · ${course.name}`}
  description={`Folhas de consulta e exercícios de ${course.name} para imprimir.`}
  preloadReadingFonts
>
  <main id="conteudo" class="study-pack" data-pagefind-ignore>
    <header>
      <h1>Caderno de revisão</h1>
      <p>{course.name}</p>
    </header>
    <StudyPack course={course}>
      {rendered.map(({ entry, Content }) => (
        <section data-print-entry={entry.id}>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.description}</p>
          <EditorialNote
            editorial={entry.data.editorial}
            example={course.example}
          />
          <Prose>
            <Content />
          </Prose>
          <p class="print-origin">
            <a href={lessonPath(course, entry)}>Página original</a>
          </p>
        </section>
      ))}
    </StudyPack>
  </main>
</Layout>
