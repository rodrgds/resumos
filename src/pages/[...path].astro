---
import { render } from 'astro:content';
import {
  getCourseGuides,
  lessonPath,
  type CourseGuide,
  type Lesson,
} from '../lib/course-content';
import LessonLayout from '../layouts/Lesson.astro';
import PrintPack from '../layouts/PrintPack.astro';

export async function getStaticPaths() {
  const courses = await getCourseGuides();
  return courses.flatMap((course) => [
    {
      params: { path: course.path.slice(1, -1) },
      props: { course, entry: course.introduction },
    },
    ...course.pages.map((entry) => ({
      params: { path: lessonPath(course, entry).slice(1, -1) },
      props: { course, entry },
    })),
    ...(course.revisions.length || course.exercises.length
      ? [
          {
            params: { path: `${course.path.slice(1)}imprimir` },
            props: { course, pack: true },
          },
        ]
      : []),
  ]);
}
interface Props {
  course: CourseGuide;
  entry?: Lesson;
  pack?: boolean;
}
const { course, entry, pack } = Astro.props;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

{pack ? (
  <PrintPack course={course} />
) : (
  <LessonLayout
    course={course}
    entry={entry}
    headings={rendered?.headings || []}
  >
    {Content ? <Content /> : <p>Escolhe um resumo no menu da cadeira.</p>}
  </LessonLayout>
)}
