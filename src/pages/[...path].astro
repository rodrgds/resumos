---
import { render } from 'astro:content';
import {
  getCourseGuides,
  lessonPath,
  type CourseGuide,
  type Lesson,
} from '../lib/course-content';
import { getPublicTldr } from '../lib/tldr-content';
import LessonLayout from '../layouts/Lesson.astro';

export async function getStaticPaths() {
  const courses = await getCourseGuides();
  const summaries = await getPublicTldr();
  return courses.flatMap((course) => [
    {
      params: { path: course.path.slice(1, -1) },
      props: { course, entry: course.introduction },
    },
    ...course.pages.map((entry) => ({
      params: { path: lessonPath(course, entry).slice(1, -1) },
      props: {
        course,
        entry,
        summary: summaries.find((summary) => summary.id === entry.id),
      },
    })),
  ]);
}
interface Props {
  course: CourseGuide;
  entry?: Lesson;
  summary?: import('../lib/tldr-content').Tldr;
}
const { course, entry, summary } = Astro.props;
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const practices = await Promise.all(
  course.exercises
    .filter((exercise) => entry?.data.practices.includes(exercise.id))
    .map(render),
);
const headings = [
  ...(rendered?.headings || []),
  ...(practices.length
    ? [{ depth: 2, slug: 'exercicios', text: 'Exercícios' }]
    : []),
];
---

<LessonLayout
  course={course}
  entry={entry}
  headings={headings}
  hasTldr={!!summary}
>
  {Content ? <Content /> : <p>Escolhe um resumo no menu da cadeira.</p>}
  <Fragment slot="practices">
    {practices.map(({ Content }) => (
      <Content />
    ))}
  </Fragment>
</LessonLayout>
