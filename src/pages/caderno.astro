---
import Layout from '../layouts/Layout.astro';
import PersonalNoteLinks from '../components/PersonalNoteLinks.astro';
---

<Layout title="Apontamentos · Resumos FEUP">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <main id="conteudo" class="notebook-index" data-pagefind-ignore>
    <h1>Apontamentos</h1>
    <PersonalNoteLinks />
    <p>Cria um apontamento nos conteúdos da tua cadeira.</p>
    <a href="/">Ver cadeiras</a>
  </main>
</Layout>
<script>
  // Preserve links created before notebooks shared the course navigation.
  const course = new URLSearchParams(location.search).get('cadeira');
  if (course && /^[\w-]+$/.test(course))
    location.replace(`/caderno/${encodeURIComponent(course)}/${location.hash}`);
</script>
<style>
  .notebook-index {
    max-width: 720px;
    margin: 48px auto;
    padding: 0 24px;
    min-height: 55vh;
  }
  .notebook-index p {
    color: var(--muted);
  }
</style>
