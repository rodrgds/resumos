---
import Layout from '../../layouts/Layout.astro';
import {
  ArrowLeft,
  ArrowUpRight,
  FileText,
  ChartNoAxesCombined,
} from '@lucide/astro';
---

<Layout title="Cadeira de exemplo · Resumos LEIC FEUP">
  <main id="conteudo" class="container inner-page" data-pagefind-body>
    <a class="text-link" href="/#contribuir">
      <ArrowLeft size={17} /> Contribuir
    </a>
    <div class="page-heading">
      <h1>Laboratório de apontamentos</h1>
      <p>
        Duas páginas para experimentar os formatos do site. Esta cadeira não faz
        parte do plano da FEUP.
      </p>
    </div>
    <div class="example-grid">
      <a class="lesson-link" href="/exemplo/apontamentos/">
        <FileText size={42} />
        <h2>Texto e fórmulas</h2>
        <p>Markdown, LaTeX, imagens, tabelas e links.</p>
        <span>
          Abrir exemplo <ArrowUpRight size={18} />
        </span>
      </a>
      <a class="lesson-link" href="/exemplo/diagramas/">
        <ChartNoAxesCombined size={42} />
        <h2>Gráficos e diagramas</h2>
        <p>MDX com Typst, CeTZ-Plot, Fletcher, DOT e vídeo.</p>
        <span>
          Abrir exemplo <ArrowUpRight size={18} />
        </span>
      </a>
    </div>
    <p class="group-note">
      Queres escrever uma página? Segue o{' '}
      <a href="https://github.com/rodrgds/resumos/blob/main/CONTRIBUTING.md">
        guia de contribuição
      </a>
      .
    </p>
  </main>
</Layout>
