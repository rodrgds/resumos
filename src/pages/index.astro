---
import Layout from '../layouts/Layout.astro';
import ReadingHistory from '../components/ReadingHistory.astro';
import CourseYears from '../components/CourseYears.astro';
import CourseDialog from '../components/CourseDialog.astro';
import ProgramNav from '../components/ProgramNav.astro';
import { courses, curriculum } from '../data/courses';
import Icon from '../components/Icon.astro';
const links = [
  {
    title: 'TTS · Horários',
    description: 'Monta o teu horário com o NIAEFEUP.',
    href: 'https://tts.niaefeup.pt/planner',
  },
  {
    title: 'Uni · U.Porto no bolso',
    description: 'A app do NIAEFEUP para Android.',
    href: 'https://play.google.com/store/apps/details?id=pt.up.fe.ni.uni',
  },
  {
    title: 'Resumos SofiaViP',
    description: 'Apontamentos partilhados no Google Drive.',
    href: 'https://drive.google.com/drive/folders/1PZYhtsUc6mDA96jnVR4wiLWWxNWeovdK',
  },
  {
    title: 'SIGARRA',
    description: 'O curso, as cadeiras e os horários.',
    href: curriculum.url,
  },
  {
    title: 'Moodle U.Porto',
    description: 'Materiais e entregas das aulas.',
    href: 'https://moodle.up.pt/',
  },
  {
    title: 'Núcleos da FEUP',
    description: 'Conhece os grupos de estudantes.',
    href: '/nucleos/',
  },
];
---

<Layout>
  <main id="conteudo" data-pagefind-body>
    <ReadingHistory />
    <section
      class="pinned-semesters container"
      data-pinned-semesters
      hidden
      data-pagefind-ignore
      aria-label="Semestres fixados"
    ></section>
    <section class="hero container" id="page-hero" aria-labelledby="hero-title">
      <a
        class="feup-logo"
        href="https://www.up.pt/feup/"
        aria-label="Faculdade de Engenharia da Universidade do Porto"
      >
        <picture class="feup-logo-color">
          <source
            type="image/webp"
            srcset="/logos/feup-color-480.webp 480w, /logos/feup-color-720.webp 720w"
            sizes="(max-width: 700px) 240px, 300px"
          />
          <img
            src="/logos/feup-color.png"
            alt=""
            width="480"
            height="167"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
        <picture class="feup-logo-white">
          <source
            type="image/webp"
            srcset="/logos/feup-white-480.webp 480w, /logos/feup-white-720.webp 720w"
            sizes="(max-width: 700px) 240px, 300px"
          />
          <img
            src="/logos/feup-white.png"
            alt=""
            width="480"
            height="188"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </a>
      <h1 id="hero-title" tabindex="-1">
        Resumos LEIC<span class="title-dot">.</span>
      </h1>
      <p>
        De quem estuda, para quem estuda.
        <br />
        Um lugar para os apontamentos de Informática da FEUP.
      </p>
    </section>
    <section
      id="cadeiras"
      class="catalog container"
      aria-label="Cadeiras por ano e semestre"
    >
      <ProgramNav active="leic" />
      <CourseYears courses={courses} years={[1, 2, 3]} />
      <p class="catalog-note">
        Plano {curriculum.year}. Os cartões com resumos publicados abrem a
        cadeira. As opções de Competências Transversais estão no{' '}
        <a href={curriculum.url}>plano de estudos</a>.
      </p>
    </section>
    <section class="useful container" aria-labelledby="links-title">
      <h2 id="links-title">Também dá jeito</h2>
      <div class="useful-links">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('/') ? undefined : '_blank'}
            rel="noreferrer"
          >
            <span>
              <strong>{link.title}</strong>
              <small>{link.description}</small>
            </span>
            <Icon name="arrow-up-right" size={22} />
          </a>
        ))}
      </div>
    </section>
  </main>
  <CourseDialog curriculum={curriculum} />
</Layout>
