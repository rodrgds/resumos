---
import Layout from '../layouts/Layout.astro';
import PageActions from '../components/PageActions.astro';
import CourseCard from '../components/CourseCard.astro';
import { courses, curriculum } from '../data/courses';
import {
  BookOpen,
  ArrowUpRight,
  ArrowRight,
  X,
  Heart,
  ExternalLink,
  GraduationCap,
} from '@lucide/astro';
const links = [
  {
    title: 'SIGARRA',
    description: 'O curso, as cadeiras e os horários.',
    href: curriculum.url,
  },
  {
    title: 'Moodle U.Porto',
    description: 'Materiais e entregas das aulas.',
    href: 'https://moodle.up.pt/',
  },
  {
    title: 'Núcleos da FEUP',
    description: 'Conhece os grupos de estudantes.',
    href: '/nucleos/',
  },
];
---

<Layout>
  <main id="conteudo" data-pagefind-body>
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          Resumos LEIC<span class="title-dot">.</span>
        </h1>
        <p>
          De quem estuda, para quem estuda.
          <br />
          Um lugar para os apontamentos de Informática da FEUP.
        </p>
        <PageActions />
      </div>
      <a
        class="feup-logo"
        href="https://www.up.pt/feup/"
        aria-label="Faculdade de Engenharia da Universidade do Porto"
      >
        <img
          src="/logos/feup.svg"
          alt="FEUP, Faculdade de Engenharia da Universidade do Porto"
          width="230"
          height="100"
        />
      </a>
    </section>
    <div class="community-note container">
      <span>
        <Heart size={17} />
        <span>
          Estamos a começar. Os teus apontamentos podem ser os primeiros.
        </span>
      </span>
      <a href="#contribuir">
        Quero ajudar <ArrowUpRight size={16} />
      </a>
    </div>
    <section
      id="cadeiras"
      class="catalog container"
      aria-label="Cadeiras por ano e semestre"
    >
      {[1, 2, 3].map((year) => (
        <section
          class="year-section"
          data-course-year={year}
          aria-labelledby={`year-${year}`}
        >
          <div class="year-heading">
            <h2 id={`year-${year}`}>{year}.º ano</h2>
            <span>60 ECTS</span>
          </div>
          <div class="semesters">
            {[1, 2].map((semester) => (
              <section
                class="semester"
                aria-labelledby={`semester-${year}-${semester}`}
              >
                <h3 id={`semester-${year}-${semester}`}>
                  {semester}.º semestre
                </h3>
                <div class="course-grid">
                  {courses
                    .filter(
                      (course) =>
                        course.year === year && course.semester === semester,
                    )
                    .map((course) => (
                      <CourseCard course={course} />
                    ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))}
      <p class="catalog-note">
        Plano {curriculum.year}. Ainda não há resumos destas cadeiras
        publicados. As opções de Competências Transversais estão no{' '}
        <a href={curriculum.url}>plano de estudos</a>.
      </p>
    </section>
    <section class="useful container" aria-labelledby="links-title">
      <h2 id="links-title">Também dá jeito</h2>
      <div class="useful-links">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('/') ? undefined : '_blank'}
            rel="noreferrer"
          >
            <span>
              <strong>{link.title}</strong>
              <small>{link.description}</small>
            </span>
            <ArrowUpRight size={22} />
          </a>
        ))}
      </div>
    </section>
    <section
      id="contribuir"
      class="contribute container"
      aria-labelledby="contribute-title"
    >
      <div class="contribute-icon">
        <BookOpen size={32} stroke-width={1.5} />
      </div>
      <div>
        <h2 id="contribute-title">Bons apontamentos merecem companhia.</h2>
        <p>
          Tens um resumo que te salvou antes de um exame?
          <br />É esse tipo de ajuda que queremos juntar aqui.
        </p>
        <p>
          Vê a <a href="/exemplo/">cadeira de exemplo</a> para conheceres os
          formatos que podes usar.
        </p>
        <a
          class="text-link contribute-link"
          href="https://github.com/rodrgds/resumos/blob/main/CONTRIBUTING.md"
        >
          Como contribuir no GitHub <ArrowUpRight size={17} />
        </a>
      </div>
    </section>
  </main>
  <dialog
    id="course-detail"
    class="course-dialog"
    aria-labelledby="course-title"
  >
    <div class="dialog-header">
      <span id="detail-acronym"></span>
      <button class="icon-button" data-close aria-label="Fechar cadeira">
        <X size={22} />
      </button>
    </div>
    <GraduationCap class="detail-icon" size={36} stroke-width={1.5} />
    <h2 id="course-title"></h2>
    <p id="course-meta"></p>
    <div class="unpublished">
      <h3>Os primeiros resumos ainda estão por escrever.</h3>
      <p id="course-description">
        Tens apontamentos desta cadeira? Podes ajudar a começar.
      </p>
    </div>
    <a class="primary-link" href="#contribuir" id="course-contribute">
      Como contribuir <ArrowRight size={17} />
    </a>
    <a
      class="official-link"
      href={curriculum.url}
      target="_blank"
      rel="noreferrer"
    >
      Ver o plano no SIGARRA <ExternalLink size={15} />
    </a>
  </dialog>
  <script src="../scripts/home.ts"></script>
</Layout>
