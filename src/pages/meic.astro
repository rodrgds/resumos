---
import Layout from '../layouts/Layout.astro';
import CourseYears from '../components/CourseYears.astro';
import CourseDialog from '../components/CourseDialog.astro';
import ProgramNav from '../components/ProgramNav.astro';
import { courses, curriculum } from '../data/meic';
---

<Layout title="MEIC · Resumos LEIC FEUP">
  <main id="conteudo" class="container inner-page" data-pagefind-body>
    <ProgramNav active="meic" />
    <div class="page-heading">
      <h1>MEIC</h1>
      <p>Mestrado em Engenharia Informática e Computação.</p>
      <p>
        Plano {curriculum.year}. As cadeiras ainda não têm resumos publicados.
      </p>
    </div>
    <p class="catalog-note">
      As cadeiras marcadas como opção são alternativas. Escolhes 24 ECTS de
      optativas em cada ano e 1,5 ECTS de Competências Transversais no 2.º ano.
    </p>
    <CourseYears courses={courses} years={[1, 2]} />
    <p class="catalog-note">
      O conjunto de opções precisa de aprovação e deve incluir uma a três
      cadeiras de Métodos Quantitativos e Gestão. Também podem ser aceites
      outras cadeiras do 2.º ciclo da U.Porto. Consulta as condições no{' '}
      <a href={curriculum.url}>plano do SIGARRA</a>.
    </p>
  </main>
  <CourseDialog curriculum={curriculum} />
</Layout>
