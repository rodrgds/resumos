---
import Layout from '../layouts/Layout.astro';
import CourseYears from '../components/CourseYears.astro';
import CourseDialog from '../components/CourseDialog.astro';
import ProgramNav from '../components/ProgramNav.astro';
import { courses, curriculum } from '../data/mieic';
---

<Layout title="MIEIC · Resumos LEIC FEUP">
  <main id="conteudo" class="container inner-page" data-pagefind-body>
    <ProgramNav active="mieic" />
    <div class="page-heading">
      <h1>MIEIC</h1>
      <p>Mestrado Integrado em Engenharia Informática e Computação.</p>
      <p>
        Arquivo do{' '}
        <a class="text-link" href={curriculum.url}>
          plano de 2020/21
        </a>
        , o último ano do curso. As cadeiras ainda não têm resumos publicados.
      </p>
    </div>
    <p class="catalog-note">
      As cadeiras marcadas como opção são alternativas, não são todas
      obrigatórias.
    </p>
    <CourseYears courses={courses} years={[1, 2, 3, 4, 5]} />
    <p class="catalog-note">
      No 4.º ano escolhem-se 18 a 20,5 ECTS de optativas; no 5.º, 24 a 26,5
      ECTS. As opções listadas não são todas obrigatórias. A Dissertação e a
      Preparação da Dissertação podem trocar de semestre. Outras cadeiras da
      U.Porto também podem ser aceites. Consulta as condições no{' '}
      <a href={curriculum.url}>SIGARRA</a>.
    </p>
  </main>
  <CourseDialog curriculum={curriculum} />
</Layout>
