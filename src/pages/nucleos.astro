---
import Layout from '../layouts/Layout.astro';
import { ArrowUpRight, ArrowLeft } from '@lucide/astro';
const groups = [
  {
    name: 'JuniFEUP',
    description:
      'Júnior empresa da FEUP. Projetos de engenharia, tecnologia e gestão.',
    href: 'https://www.junifeup.pt/',
    logo: 'junifeup.webp',
    color: '#163d71',
    logoBackground: '#fff',
  },
  {
    name: 'ACM FEUP',
    description:
      'Programação competitiva, algoritmos e desafios para resolver em conjunto.',
    href: 'https://www.acmfeup.eu/',
    logo: 'acm.png',
    color: '#164d7b',
    logoBackground: '#164d7b',
  },
  {
    name: 'IEEE FEUP',
    description:
      'Tecnologia, projetos e atividades do ramo estudantil do IEEE.',
    href: 'https://ieee.fe.up.pt/',
    logo: 'ieee.svg',
    color: '#00629b',
    logoBackground: '#00629b',
  },
  {
    name: 'NCGM',
    description: 'Computação gráfica, multimédia e desenvolvimento de jogos.',
    href: 'https://ncgm.fe.up.pt/',
    logo: 'ncgm.png',
    color: '#b91c46',
    logoBackground: '#fff',
  },
];
---

<Layout title="Núcleos · Resumos LEIC FEUP">
  <main id="conteudo" class="container inner-page" data-pagefind-body>
    <a class="text-link" href="/">
      <ArrowLeft size={17} /> Início
    </a>
    <div class="page-heading">
      <h1>Núcleos da FEUP</h1>
      <p>
        Há mais para fazer fora das aulas. Conhece alguns grupos de estudantes.
      </p>
    </div>
    <div class="groups-grid">
      {groups.map((group) => (
        <a
          class="group-card"
          href={group.href}
          target="_blank"
          rel="noreferrer"
          style={`--group-color:${group.color};--logo-background:${group.logoBackground}`}
        >
          <div class="group-logo">
            <img
              src={`/logos/${group.logo}`}
              alt={`Logótipo ${group.name}`}
              width="260"
              height="110"
              loading="lazy"
            />
          </div>
          <div class="group-info">
            <h2>
              {group.name}
              <ArrowUpRight size={24} />
            </h2>
            <p>{group.description}</p>
            <span>Visitar o site</span>
          </div>
        </a>
      ))}
    </div>
    <p class="group-note">
      Para a comunidade de Informática, visita também o{' '}
      <a href="https://ni.fe.up.pt/">NIAEFEUP</a>.
    </p>
  </main>
</Layout>
