---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const groups = [
  {
    name: 'NIAEFEUP',
    description:
      'O Núcleo de Informática da AEFEUP. Atividades, projetos e apoio aos estudantes de Informática.',
    href: 'https://niaefeup.pt/',
    logo: 'niaefeup.svg',
    color: '#b33636',
    logoBackground: '#fff',
  },
  {
    name: 'JuniFEUP',
    description:
      'Júnior empresa da FEUP. Projetos de engenharia, tecnologia e gestão.',
    href: 'https://www.junifeup.pt/',
    logo: 'junifeup.webp',
    color: '#163d71',
    logoBackground: '#fff',
  },
  {
    name: 'ACM FEUP',
    description:
      'Programação competitiva, algoritmos e desafios para resolver em conjunto.',
    href: 'https://www.acmfeup.eu/',
    logo: 'acm.png',
    color: '#164d7b',
    logoBackground: '#fff',
  },
  {
    name: 'IEEE FEUP',
    description:
      'Tecnologia, projetos e atividades do ramo estudantil do IEEE.',
    href: 'https://ieee.fe.up.pt/',
    logo: 'ieee.svg',
    color: '#00629b',
    logoBackground: '#fff',
  },
  {
    name: 'NCGM',
    description: 'Computação gráfica, multimédia e desenvolvimento de jogos.',
    href: 'https://ncgm.fe.up.pt/',
    logo: 'ncgm.png',
    color: '#b91c46',
    logoBackground: '#fff',
  },
  {
    name: 'ARMIS Lab',
    description:
      'Laboratório de investigação da ARMIS e da FEUP, com projetos e dissertações em Engenharia Informática.',
    href: 'https://dei.fe.up.pt/armis/',
    logo: 'armis-lab.svg',
    color: '#303c76',
    logoBackground: '#fff',
  },
  {
    name: 'FS FEUP',
    description:
      'Equipa de Formula Student. Conceção e construção de carros elétricos de competição, com condução autónoma.',
    href: 'https://formulastudent.fe.up.pt/',
    logo: 'fs-feup.svg',
    color: '#9c202d',
    logoBackground: '#242424',
  },
  {
    name: 'MS FEUP',
    description:
      'Equipa de MotoStudent. Desenvolvimento de uma mota elétrica para competir com equipas universitárias.',
    href: 'https://motostudent.fe.up.pt/',
    logo: 'ms-feup.png',
    color: '#242424',
    logoBackground: '#fff',
  },
  {
    name: 'xSTF',
    description:
      'Equipa de cibersegurança da U.Porto. Investigação em segurança e competições Capture the Flag.',
    href: 'https://xstf.pt/',
    logo: 'xstf.svg',
    color: '#252525',
    logoBackground: '#fff',
  },
  {
    name: 'BEST Porto',
    description:
      'Cursos internacionais, competições de engenharia e atividades para estudantes da FEUP e da FCUP.',
    href: 'https://www.bestporto.org/',
    logo: 'best-porto.svg',
    color: '#174d7b',
    logoBackground: '#fff',
  },
];
---

<Layout title="Núcleos · Resumos LEIC FEUP">
  <main id="conteudo" class="container inner-page" data-pagefind-body>
    <a class="text-link" href="/">
      <Icon name="arrow-left" size={17} /> Início
    </a>
    <div class="page-heading">
      <h1>Núcleos da FEUP</h1>
      <p>
        Há mais para fazer fora das aulas. Conhece núcleos, equipas e projetos
        ligados à FEUP.
      </p>
    </div>
    <div class="groups-grid">
      {groups.map((group) => (
        <a
          class="group-card"
          href={group.href}
          target="_blank"
          rel="noreferrer"
          style={`--group-background:${group.color};--group-foreground:#fff;--logo-background:${group.logoBackground}`}
        >
          <div class="group-logo">
            <img
              src={`/logos/${group.logo}`}
              alt={`Logótipo ${group.name}`}
              width="260"
              height="110"
              loading="lazy"
            />
          </div>
          <div class="group-info">
            <h2>
              {group.name}
              <Icon name="arrow-up-right" size={24} />
            </h2>
            <p>{group.description}</p>
            <span>Visitar o site</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
